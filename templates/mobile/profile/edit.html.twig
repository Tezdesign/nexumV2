{% extends 'mobile/layouts/main.html.twig' %}

{% set title = 'Edit Profile'|trans %}
{% set active_nav = 'profile' %}

{% block css %}
<link href="{{ asset('css/nexum-pages-polish.css') }}" rel="stylesheet">
{% endblock %}

{% block content %}
{% set account_avatar_src = path('user_account_avatar', {v: auth_service.getCurrentUser().avatar_v|default(0)}) %}

<div class="account-page nexum-page-ambient p-3">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3 mb-4">
        <div>
            <h4 class="page-title fw-semibold mb-1">Edit Profile</h4>
            <p class="text-muted mb-0 fs-14">Update your personal information.</p>
        </div>
        <a href="{{ path('app_mobile_profile') }}" class="btn btn-sm align-self-start nexum-btn-ghost-purple" data-turbo-action="replace">
            <i class="ri-arrow-left-line me-1"></i> Back to Settings
        </a>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show shadow-sm" role="alert">
                        <i class="ri-{{ label == 'success' ? 'checkbox-circle-line' : (label == 'error' ? 'alert-line' : 'information-line') }} me-2"></i>
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>

    <form method="post" action="{{ path('app_mobile_profile_edit') }}" enctype="multipart/form-data" novalidate id="accountForm">
        <div class="card account-form-card border-0 mb-4 nexum-card">
            <div class="card-header bg-transparent border-bottom border-dashed py-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="account-section-icon bg-primary-subtle text-primary">
                        <i class="ri-user-settings-line"></i>
                    </span>
                    <div>
                        <h5 class="header-title mb-0">Personal information</h5>
                    </div>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="mb-3">
                    <label for="prenom" class="form-label fw-medium">First name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-user-line"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="prenom" name="prenom" value="{{ utilisateur.prenom }}" required maxlength="255" placeholder="Jane">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="nom" class="form-label fw-medium">Last name <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-user-line"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="nom" name="nom" value="{{ utilisateur.nom }}" required maxlength="255" placeholder="Doe">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label fw-medium">Work email <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-mail-line"></i></span>
                        <input type="email" class="form-control border-start-0 ps-0" id="email" name="email" value="{{ utilisateur.email }}" required maxlength="255" placeholder="you@company.com">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="telephone" class="form-label fw-medium">Phone</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-smartphone-line"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="telephone" name="telephone" value="{{ utilisateur.telephone ?? '' }}" maxlength="64" placeholder="+216 …">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="departement" class="form-label fw-medium">Department</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-team-line"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" id="departement" name="departement" value="{{ utilisateur.departement ?? '' }}" maxlength="255" placeholder="Engineering, HR, …">
                    </div>
                </div>

                <hr class="border-dashed my-4">

                <label class="form-label fw-medium d-block mb-2">Profile photo</label>
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <img src="{{ account_avatar_src }}" id="accountPhotoPreview" class="account-preview" alt="Current profile photo">
                    </div>
                    <div class="col">
                        <input type="file" class="visually-hidden" id="imagelink" name="imagelink" accept="image/*" tabindex="-1">
                        <label class="account-upload-zone w-100 mb-0" for="imagelink">
                            <i class="ri-image-add-line fs-24 text-primary d-block mb-2"></i>
                            <span class="fw-medium d-block">Tap to upload</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="card account-form-card border-0 mb-4 nexum-card">
            <div class="card-header bg-transparent border-bottom border-dashed py-3">
                <div class="d-flex align-items-center gap-3">
                    <span class="account-section-icon bg-warning-subtle text-warning">
                        <i class="ri-shield-keyhole-line"></i>
                    </span>
                    <div>
                        <h5 class="header-title mb-0">Security</h5>
                        <p class="text-muted fs-13 mb-0">Leave blank to keep current password.</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-3">
                <div class="mb-3">
                    <label for="new_password" class="form-label fw-medium">New password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-lock-password-line"></i></span>
                        <input type="password" class="form-control border-start-0 ps-0" id="new_password" name="new_password" autocomplete="new-password" minlength="6" placeholder="Min. 6 characters">
                    </div>
                </div>
                <div class="mb-3">
                    <label for="confirm_password" class="form-label fw-medium">Confirm new password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="ri-lock-unlock-line"></i></span>
                        <input type="password" class="form-control border-start-0 ps-0" id="confirm_password" name="confirm_password" autocomplete="new-password" minlength="6" placeholder="Repeat password">
                    </div>
                </div>
            </div>
        </div>

        <div class="d-grid mb-4 pb-5">
            <button type="submit" class="btn btn-lg nexum-btn-gradient">
                <i class="ri-save-3-line me-1"></i> Save changes
            </button>
        </div>
    </form>
</div>
{% endblock %}

{% block script %}
<script>
(function () {
    var fileInput = document.getElementById('imagelink');
    var preview = document.getElementById('accountPhotoPreview');
    if (!fileInput) return;

    fileInput.addEventListener('change', function () {
        var f = fileInput.files && fileInput.files[0];
        if (!f || !f.type.match(/^image\//)) return;
        var url = URL.createObjectURL(f);
        if (preview) preview.src = url;
    });
})();
</script>
{% endblock %}