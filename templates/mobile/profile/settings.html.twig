{% extends 'mobile/layouts/main.html.twig' %}

{% set title = 'Settings'|trans %}
{% set active_nav = 'profile' %}

{% block content %}
    <div class="p-3 pb-5 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0 d-native-none">{{ title }}</h3>
        </div>

        <div class="settings-card shadow-sm">
            <img src="{{ path('user_account_avatar') }}" alt="User Avatar" class="settings-avatar">
            <div>
                <h5 class="mb-1">{{ utilisateur.prenom }} {{ utilisateur.nom }}</h5>
                <p class="text-muted small mb-0">{{ utilisateur.email }}</p>
                <span class="badge badge-nexum-soft mt-1">{{ utilisateur.role|capitalize }}</span>
            </div>
        </div>

        <h6 class="text-muted fw-bold mb-2 ps-1">Account</h6>
        <div class="settings-menu-group shadow-sm">
            <a href="{{ path('app_mobile_profile_edit') }}" class="settings-menu-item" data-turbo="false">
                <div class="d-flex align-items-center">
                    <div class="settings-icon"><i class="ri-user-settings-line fs-5"></i></div>
                    <span class="fw-medium">Edit Profile</span>
                </div>
                <i class="ri-arrow-right-s-line text-muted"></i>
            </a>
        </div>

        <h6 class="text-muted fw-bold mb-2 ps-1">System</h6>
        <div class="settings-menu-group shadow-sm">
            <a href="{{ path('app_mobile_logout') }}" class="settings-menu-item text-danger" data-turbo="false">
                <div class="d-flex align-items-center">
                    <div class="settings-icon"><i class="ri-logout-box-r-line fs-5"></i></div>
                    <span class="fw-medium">Logout</span>
                </div>
                <i class="ri-arrow-right-s-line text-muted"></i>
            </a>
        </div>
    </div>
{% endblock %}