{% extends 'mobile/layouts/main.html.twig' %}

{% set title = 'Alerts'|trans %}
{% set active_nav = 'notifications' %}

{% block content %}
<div class="p-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="mb-0">{{ title }}</h3>
        <button type="button" class="btn btn-primary btn-sm rounded-pill" onclick="if(typeof window.showMobileNotification === 'function') window.showMobileNotification('New Alert', 'New notification received! Please check your alerts.', 'info');">
            <i class="ri-notification-badge-line me-1"></i> Test Popup
        </button>
    </div>

    {% if notifications is defined and notifications|length > 0 %}
        <div class="d-flex flex-column gap-2 pb-5">
            {% for notif in notifications %}
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-3 d-flex align-items-start">
                        {% if notif.type == 'success' %}
                            <div class="bg-success-subtle text-success p-2 rounded-circle me-3 flex-shrink-0 d-flex">
                                <i class="ri-checkbox-circle-fill fs-5"></i>
                            </div>
                        {% elseif notif.type == 'error' or notif.type == 'danger' %}
                            <div class="bg-danger-subtle text-danger p-2 rounded-circle me-3 flex-shrink-0 d-flex">
                                <i class="ri-error-warning-fill fs-5"></i>
                            </div>
                        {% else %}
                            <div class="bg-primary-subtle text-primary p-2 rounded-circle me-3 flex-shrink-0 d-flex" style="color: var(--nexum-accent) !important; background-color: rgba(124, 58, 237, 0.1) !important;">
                                <i class="ri-information-fill fs-5"></i>
                            </div>
                        {% endif %}
                        
                        <div class="flex-grow-1 min-w-0">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="mb-0 fw-semibold text-truncate">{{ notif.title }}</h6>
                                <span class="text-muted small ms-2 flex-shrink-0">{{ notif.timestamp|date('M d, H:i') }}</span>
                            </div>
                            <p class="text-muted small mb-0">{{ notif.message }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <!-- Empty state -->
        <div class="text-center py-5 text-muted mt-5">
            <i class="ri-notification-off-line fs-1 mb-2 d-block opacity-50"></i>
            <p>No new alerts.</p>
        </div>
    {% endif %}
</div>
{% endblock %}