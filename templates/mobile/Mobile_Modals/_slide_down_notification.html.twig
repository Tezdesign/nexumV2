<div id="mobileSlideDownNotification">
    <div class="slide-notification-icon" id="slideNotificationIcon">
        <i class="ri-notification-3-fill"></i>
    </div>
    <div class="slide-notification-content">
        <p class="slide-notification-title" id="slideNotificationTitle">New Alert</p>
        <p class="slide-notification-text" id="slideNotificationText">You have a new notification.</p>
    </div>
    <button class="slide-notification-close" id="slideNotificationCloseBtn">
        <i class="ri-close-line fs-5"></i>
    </button>
</div>

<script>
    // Global utility to trigger slide-down notifications
    window.showMobileNotification = function(title, text, type = 'info', duration = 3000) {
        const notifEl = document.getElementById('mobileSlideDownNotification');
        const titleEl = document.getElementById('slideNotificationTitle');
        const textEl = document.getElementById('slideNotificationText');
        const iconContainer = document.getElementById('slideNotificationIcon');
        
        if (!notifEl) return;

        // Set content
        titleEl.textContent = title;
        textEl.textContent = text;

        // Set icon/colors based on type
        if (type === 'success') {
            iconContainer.style.color = '#10b981';
            iconContainer.style.backgroundColor = 'rgba(16, 185, 129, 0.1)';
            iconContainer.innerHTML = '<i class="ri-checkbox-circle-fill"></i>';
        } else if (type === 'error' || type === 'danger') {
            iconContainer.style.color = '#ef4444';
            iconContainer.style.backgroundColor = 'rgba(239, 68, 68, 0.1)';
            iconContainer.innerHTML = '<i class="ri-error-warning-fill"></i>';
        } else {
            // Default/Info
            iconContainer.style.color = 'var(--nexum-accent, #7c3aed)';
            iconContainer.style.backgroundColor = 'rgba(124, 58, 237, 0.1)';
            iconContainer.innerHTML = '<i class="ri-information-fill"></i>';
        }

        // Show
        notifEl.classList.add('show-notification');

        // Auto-hide
        if (window.mobileNotifTimeout) {
            clearTimeout(window.mobileNotifTimeout);
        }
        
        window.mobileNotifTimeout = setTimeout(() => {
            notifEl.classList.remove('show-notification');
        }, duration);
    };

    // Manual close button
    document.addEventListener('DOMContentLoaded', () => {
        const closeBtn = document.getElementById('slideNotificationCloseBtn');
        if (closeBtn) {
            closeBtn.addEventListener('click', () => {
                const notifEl = document.getElementById('mobileSlideDownNotification');
                notifEl.classList.remove('show-notification');
                if (window.mobileNotifTimeout) clearTimeout(window.mobileNotifTimeout);
            });
        }
    });
</script>