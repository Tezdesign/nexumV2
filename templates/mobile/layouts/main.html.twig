<!DOCTYPE html>
<html lang="en">
<head>
    {{ include('partials/title-meta.html.twig') }}
    {{ include('partials/head-css.html.twig') }}
    <link href="/css/FA.css?v={{ random() }}" rel="stylesheet" type="text/css" />
    <link href="/css/FA_mobile.css?v={{ random() }}" rel="stylesheet" type="text/css" />
    {% include 'partials/_task_project_design_system.html.twig' %}
    
    <style>
        :root {
            --nexum-accent: #7c3aed;
        }
        body {
            background-color: #f8fafc !important;
            /* Adjust padding to prevent content from hiding behind fixed header/footer */
            padding-top: max(env(safe-area-inset-top), 1rem);
            padding-bottom: calc(70px + env(safe-area-inset-bottom, 0px));
            font-family: "Inter", "Segoe UI", sans-serif;
        }
        
        {% if hide_top_nav|default(false) %}
        body { padding-top: 0 !important; }
        {% endif %}
        
        {% if hide_bottom_nav|default(false) %}
        body { padding-bottom: env(safe-area-inset-bottom) !important; }
        {% endif %}
    </style>
    {% block css %}{% endblock %}
</head>
<body class="mobile-layout h-100" {{ stimulus_controller('native-bridge', { title: title|default('Nexum') }) }}>
    
    <div class="mobile-wrapper">
        {% block content %}{% endblock %}
    </div>

    {% if not hide_bottom_nav|default(false) %}
    <nav class="mobile-bottom-nav d-native-none">
        <a href="{{ path('app_mobile_dashboard') }}" class="bottom-nav-item {% if active_nav|default('projects') == 'projects' %}active{% endif %}" data-turbo-action="replace">
            <i class="ri-folder-open-line"></i>
            <span>Projects</span>
        </a>
        <a href="{{ path('app_mobile_notifications') }}" class="bottom-nav-item {% if active_nav|default('') == 'notifications' %}active{% endif %}" data-turbo-action="replace">
            <i class="ri-notification-3-line"></i>
            <span>Alerts</span>
            <span class="badge" id="mobile-notif-badge" style="display: none;">0</span>
        </a>
        <a href="{{ path('app_mobile_profile') }}" class="bottom-nav-item {% if active_nav|default('') == 'profile' %}active{% endif %}" data-turbo-action="replace">
            <i class="ri-settings-4-line"></i>
            <span>Settings</span>
        </a>
    </nav>
    {% endif %}

    {{ include('mobile/Mobile_Modals/_slide_down_notification.html.twig') }}

    {{ include('partials/footer-scripts.html.twig') }}
    {% block script %}{% endblock %}

    {% if not hide_bottom_nav|default(false) %}
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        const badge = document.getElementById('mobile-notif-badge');
        
        function pollNotifications() {
            fetch('{{ path('app_mobile_notifications_poll') }}', {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(response => {
                if(!response.ok) throw new Error('Polling failed');
                return response.json();
            })
            .then(data => {
                // Update badge
                if (badge) {
                    if (data.unreadCount > 0) {
                        badge.textContent = data.unreadCount;
                        badge.style.display = 'block';
                    } else {
                        badge.style.display = 'none';
                    }
                }

                // Trigger popups for new undelivered notifications
                if (data.undelivered && data.undelivered.length > 0) {
                    data.undelivered.forEach((notif, index) => {
                        // Stagger popups if multiple arrived at once
                        setTimeout(() => {
                            if (typeof window.showMobileNotification === 'function') {
                                window.showMobileNotification(notif.title, notif.message, notif.type);
                            }
                        }, index * 3500); 
                    });
                }
            })
            .catch(err => {
                // Silently ignore polling errors
            });
        }

        // Poll immediately, then every 10 seconds
        pollNotifications();
        setInterval(pollNotifications, 10000);
    });
    </script>
    {% endif %}

    <script type="module">
        import { PushNotifications } from '@capacitor/push-notifications';

        const registerPush = async () => {
            try {
                let permStatus = await PushNotifications.checkPermissions();
                if (permStatus.receive === 'prompt') {
                    permStatus = await PushNotifications.requestPermissions();
                }
                if (permStatus.receive !== 'granted') {
                    return;
                }
                await PushNotifications.register();
            } catch (e) {
                console.error('Push error:', e);
            }
        };

        // only run if inside native capacitor app
        if (window.Capacitor && window.Capacitor.isNativePlatform()) {
            registerPush();

            PushNotifications.addListener('registration', (token) => {
                fetch('{{ path('app_mobile_save_fcm_token') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token.value })
                }).then(res => res.json())
                  .then(data => console.log('FCM token sent to server:', data));
            });
        }
    </script>
</body>
</html>