{% extends 'mobile/layouts/main.html.twig' %}

{% set title = 'Sign In'|trans %}
{% set hide_bottom_nav = true %}
{% set hide_top_nav = true %}

{% block content %}
    <div class="mobile-login-wrapper" data-native-app>
        <div class="text-center">
            <img src="{{ asset('images/logo-sm.png') }}" alt="Logo" class="login-logo">
            <h2 class="fw-bold mb-1">Welcome Back</h2>
            <p class="text-muted mb-4">Sign in to continue to Nexum</p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger rounded-pill text-center py-2 shadow-sm mb-3">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('app_mobile_login') }}" data-turbo="false">
            <div class="form-floating mb-3 shadow-sm rounded-3">
                <input type="email" class="form-control rounded-3" id="email" name="_username" placeholder="name@example.com">
                <label for="email"><i class="ri-mail-line me-1"></i>Email address</label>
            </div>
            
            <div class="form-floating mb-4 shadow-sm rounded-3">
                <input type="password" class="form-control rounded-3" id="password" name="_password" placeholder="Password">
                <label for="password"><i class="ri-lock-line me-1"></i>Password</label>
            </div>

            <button type="submit" class="btn btn-native-primary shadow-sm">
                Sign In
            </button>
        </form>
    </div>
{% endblock %}