{% extends 'mobile/layouts/main.html.twig' %}

{% set title = 'My Projects'|trans %}

{% block css %}
    {{ parent() }}
    <style>
        .mobile-card {
            background: #fff;
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 1rem;
            border: 1px solid #eee;
            text-decoration: none;
            display: block;
            color: inherit;
        }
        .mobile-card:active {
            background: #f8f9fa;
        }
        .progress-sm {
            height: 4px;
            border-radius: 999px;
            margin-top: 0.5rem;
        }
        .nexum-text-accent {
            color: var(--nexum-violet-600) !important;
        }
        .nexum-bg-accent {
            background: linear-gradient(90deg, var(--nexum-violet-600), var(--nexum-violet-500)) !important;
        }
        .badge-nexum-soft {
            background-color: var(--nexum-violet-100) !important;
            color: var(--nexum-violet-700) !important;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="p-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="mb-0 d-native-none">{{ title }}</h3>
            <span class="badge badge-nexum-soft text-uppercase">{{ role }}</span>
        </div>

        <div class="project-list">
            {% for project in projects %}
                <a href="{{ path('app_mobile_project_show', {id: project.id}) }}" 
                   class="mobile-card shadow-sm"
                   data-turbo-action="advance">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <h5 class="mb-0 text-truncate" style="max-width: 80%;">{{ project.name }}</h5>
                        <span class="small fw-bold nexum-text-accent">{{ project.progress }}%</span>
                    </div>
                    <div class="progress progress-sm">
                        <div class="progress-bar nexum-bg-accent" style="width: {{ project.progress }}%"></div>
                    </div>
                </a>
            {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="ri-folder-open-line fs-1"></i>
                    <p class="mt-2">{{ 'No projects assigned to you.'|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
