{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Update Task' %}

{% block css %}
    <style>
        :root {
            --nexum-violet-600: #7c3aed;
            --nexum-violet-700: #6d28d9;
            --nexum-stone-200: #e7e5e4;
        }

        .page-content {
            background: #f8fafc;
        }

        .page-container {
            padding-top: 20px;
            padding-bottom: 28px;
        }

        .nexum-edit-wrap {
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding: 12px 0;
        }

        .nexum-edit-card {
            width: min(920px, 100%);
            background: #fff;
            border: 1px solid var(--nexum-stone-200);
            border-radius: 18px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.10);
            padding: 20px 22px;
        }

        .nexum-edit-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 12px;
            border-bottom: 1px solid #eef2f7;
            margin-bottom: 14px;
        }

        .nexum-edit-title {
            font-size: 22px;
            font-weight: 900;
            margin: 0;
            color: #0f172a;
        }

        .nexum-edit-sub {
            font-size: 13px;
            font-weight: 600;
            color: #64748b;
            margin-top: 4px;
        }

        .nexum-x {
            width: 36px;
            height: 36px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            text-decoration: none;
        }

        .nexum-x:hover {
            border-color: #cbd5e1;
            color: #0f172a;
        }

        .nexum-edit-card label {
            font-size: 12px;
            font-weight: 800;
            color: #475569;
        }

        .nexum-edit-card .form-control,
        .nexum-edit-card .form-select {
            border-radius: 12px;
            border-color: #e2e8f0;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        .nexum-edit-card textarea.form-control {
            min-height: 92px;
            resize: none;
        }

        .nexum-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 12px;
            padding-top: 14px;
            margin-top: 10px;
            border-top: 1px solid #eef2f7;
        }

        .nexum-actions .btn {
            border-radius: 12px;
            padding: 10px 18px;
            font-weight: 900;
            min-width: 120px;
        }

        .nexum-actions .btn.btn-outline-secondary {
            border-color: #e2e8f0;
            color: #334155;
            background: #fff;
        }

        .nexum-actions .btn.btn-primary {
            background: var(--nexum-violet-600);
            border-color: var(--nexum-violet-600);
        }

        .nexum-actions .btn.btn-primary:hover {
            background: var(--nexum-violet-700);
            border-color: var(--nexum-violet-700);
        }
    </style>
{% endblock %}

{% block content %}
    {% set backUrl = back|default('') %}
    {% set backUrl = (backUrl and backUrl starts with '/') ? backUrl : path('app_task_index') %}

    <div class="nexum-edit-wrap">
        <div class="nexum-edit-card">
            <div class="nexum-edit-head">
                <div>
                    <h2 class="nexum-edit-title">Update Task</h2>
                    <div class="nexum-edit-sub">Edit task details and assignment</div>
                </div>
                <a class="nexum-x" href="{{ backUrl }}" aria-label="Close">
                    <i class="ri-close-line"></i>
                </a>
            </div>

            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

            <div class="mb-3">
                {{ form_label(form.title) }} <span class="text-danger">*</span>
                {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.title) }}
            </div>

            <div class="mb-3">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, { attr: { class: 'form-control' } }) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-3">
                    {{ form_label(form.due_date) }}
                    {{ form_widget(form.due_date, { attr: { class: 'form-control' } }) }}
                    {{ form_errors(form.due_date) }}
                </div>
                <div class="col-12 col-md-3">
                    {{ form_label(form.status) }}
                    {{ form_widget(form.status, { attr: { class: 'form-select' } }) }}
                    {{ form_errors(form.status) }}
                </div>
                <div class="col-12 col-md-3">
                    {{ form_label(form.assignedUser) }}
                    {{ form_widget(form.assignedUser, { attr: { class: 'form-select' } }) }}
                    {{ form_errors(form.assignedUser) }}
                </div>
                <div class="col-12 col-md-3">
                    {{ form_label(form.priority) }}
                    {{ form_widget(form.priority, { attr: { class: 'form-select' } }) }}
                    {{ form_errors(form.priority) }}
                </div>
            </div>

            <div class="nexum-actions">
                <a class="btn btn-outline-secondary" href="{{ backUrl }}">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
