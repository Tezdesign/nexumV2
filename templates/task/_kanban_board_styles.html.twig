.kanban-shell {
    padding: 22px 0 28px;
}

.kanban-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
}

.kanban-toolbar {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
}

.kanban-filter-btn,
.kanban-add-btn {
    border-radius: 14px;
    padding: 11px 18px;
    font-weight: 800;
}

.kanban-filter-btn {
    border: 1px solid #d9e2ef;
    background: #fff;
    color: #314155;
}

.kanban-filter-btn:hover {
    border-color: #c3cfdf;
    color: #0f172a;
}

.kanban-filter-summary {
    margin-top: 8px;
    color: #7b8da6;
    font-size: 14px;
    font-weight: 600;
}

.kanban-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
}

.kanban-column {
    border-radius: 22px;
    border: 1px solid #dfe6f1;
    background: linear-gradient(180deg, #f7f9fc 0%, #f2f5f9 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    overflow: hidden;
}

.kanban-column-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 14px 10px;
    font-weight: 800;
    color: #52657d;
}

.kanban-column-title {
    font-size: 15px;
    color: #243245;
}

.kanban-count {
    min-width: 26px;
    height: 26px;
    border-radius: 999px;
    background: #e8eef6;
    color: #8193aa;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 900;
}

.kanban-stack {
    padding: 0 12px 12px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 620px;
}

.kanban-stack .nexum-row {
    border-top: 0;
}

.kanban-task-card {
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(223, 230, 241, 0.9);
    box-shadow: 0 10px 22px rgba(31, 41, 55, 0.08);
    padding: 12px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}

.kanban-task-card.is-draggable {
    cursor: grab;
}

.kanban-task-card.is-locked {
    cursor: default;
}

.kanban-task-card.is-dragging {
    opacity: 0.55;
    transform: rotate(1deg) scale(0.99);
    box-shadow: 0 20px 34px rgba(31, 41, 55, 0.16);
}

.kanban-task-main {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1 1 auto;
}

.kanban-task-toggle {
    flex: 0 0 auto;
}

.kanban-task-check {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    border: 2px solid #d6dee9;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: transparent;
    padding: 0;
}

.kanban-task-check.is-done {
    border-color: #22c58b;
    background: rgba(34, 197, 139, 0.12);
    color: #22c58b;
}

.kanban-task-check.is-disabled {
    cursor: default;
}

.kanban-column.is-drop-target .kanban-stack {
    background: rgba(124, 58, 237, 0.05);
}

.kanban-column.is-updating {
    opacity: 0.75;
}

.kanban-task-body {
    min-width: 0;
}

.kanban-task-title {
    display: block;
    max-width: 100%;
    font-size: 13px;
    font-weight: 700;
    color: #1f2d3d;
    text-decoration: none;
    white-space: normal;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-height: 1.45;
}

.kanban-task-title:hover {
    text-decoration: underline;
}

.kanban-task-title.is-done {
    color: #8a97aa;
    text-decoration: line-through;
}

.kanban-task-assignee {
    margin-top: 4px;
    font-size: 11px;
    font-weight: 600;
    color: #6c7b90;
    white-space: normal;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
}

.kanban-task-badges {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: 0 0 auto;
}

.kanban-empty {
    min-height: 132px;
    border-radius: 18px;
    border: 1px dashed #d7e0ed;
    background: rgba(255, 255, 255, 0.52);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #7b8da6;
    font-size: 13px;
    font-weight: 700;
    padding: 24px 18px;
}

.kanban-modal .modal-dialog {
    max-width: 540px;
}

.kanban-modal .modal-content {
    border-radius: 18px;
    border: 1px solid #e2e8f0;
}

.kanban-modal .modal-header,
.kanban-modal .modal-footer {
    border-color: #eef2f7;
}

.kanban-modal .modal-title {
    font-weight: 900;
}

.kanban-modal .form-select {
    border-radius: 12px;
    border-color: #d8e1ee;
    padding-top: 10px;
    padding-bottom: 10px;
}

@media (max-width: 1199.98px) {
    .kanban-board {
        grid-template-columns: 1fr;
    }

    .kanban-stack {
        min-height: auto;
    }
}
