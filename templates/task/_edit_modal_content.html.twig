<div class="modal-header">
    <div>
        <h5 class="modal-title mb-1">Update Task</h5>
        <div class="text-muted small">Edit task details and assignment</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

{{ form_start(form, { action: path('app_task_edit_modal', {id: task.id}), method: 'POST', attr: { novalidate: 'novalidate' } }) }}
<div class="modal-body">
    {{ form_errors(form) }}
    <div class="mb-3">
        {{ form_label(form.title) }} <span class="text-danger">*</span>
        {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
        {{ form_errors(form.title) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.description) }}
        {{ form_widget(form.description, { attr: { class: 'form-control' } }) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-3">
            {{ form_label(form.due_date) }}
            {{ form_widget(form.due_date, { attr: { class: 'form-control' } }) }}
            {{ form_errors(form.due_date) }}
        </div>
        <div class="col-12 col-md-3">
            {{ form_label(form.status) }}
            {{ form_widget(form.status, { attr: { class: 'form-select' } }) }}
            {{ form_errors(form.status) }}
        </div>
        <div class="col-12 col-md-3">
            {{ form_label(form.assignedUser) }}
            {{ form_widget(form.assignedUser, { attr: { class: 'form-select' } }) }}
            {{ form_errors(form.assignedUser) }}
        </div>
        <div class="col-12 col-md-3">
            {{ form_label(form.priority) }}
            {{ form_widget(form.priority, { attr: { class: 'form-select' } }) }}
            {{ form_errors(form.priority) }}
        </div>
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" class="btn btn-primary">Save</button>
</div>
{{ form_end(form) }}

