{% extends 'layouts/auth.html.twig' %}

{% set title = 'Sign Up - Nexum' %}

{# Field names that can carry an error, in page order. #}
{% set errors = errors|default({}) %}
{% set old = old|default({}) %}

{% macro open(name, label, errors, required = true) %}
    <div class="field{{ errors[name] is defined ? ' has-error' : '' }}" data-field="{{ name }}">
        <label for="f-{{ name }}">{{ label }}{% if required %} <span class="req" aria-hidden="true">*</span>{% else %} <span class="opt">optional</span>{% endif %}</label>
{% endmacro %}

{% macro close(name, errors, hint = null) %}
        <p class="field-error" id="err-{{ name }}" role="alert">{{ errors[name]|default('') }}</p>
        {% if hint %}<p class="field-hint">{{ hint }}</p>{% endif %}
    </div>
{% endmacro %}

{% block css %}
<style>
    :root {
        --primary-purple: #7c3aed;
        --primary-dark: #6d28d9;
        --text-main: #111827;
        --text-muted: #6b7280;
        --input-bg: #f9fafb;
        --border-color: #e5e7eb;
        --danger: #dc2626;
        --danger-bg: #fef2f2;
    }

    /* The page scrolls as one piece: the card simply grows with its content. */
    .signup-wrap { display: flex; justify-content: center; padding: 24px 0 40px; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    .signup-wrap * { font-family: inherit; }

    .signup-card {
        display: flex;
        width: 1000px;
        max-width: 100%;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.12);
    }

    .signup-form { flex: 1 1 0; padding: 40px 48px 36px; min-width: 0; }

    .signup-art {
        flex: 0 0 38%;
        background: #1e1b4b url('{{ asset('images/users/purple.jpg') }}') center / cover;
        position: relative;
    }
    .signup-art::after {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(circle at center, rgba(124, 58, 237, .2) 0%, transparent 70%);
    }

    .signup-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; }
    .brand { font-size: 24px; font-weight: 800; letter-spacing: -.02em; color: var(--primary-purple); }
    .back-link { color: var(--text-muted); font-size: 14px; text-decoration: none; font-weight: 500; }
    .back-link:hover { color: var(--primary-purple); }

    h1.title { margin: 0 0 6px; font-size: 26px; font-weight: 700; color: var(--text-main); }
    .subtitle { margin: 0 0 24px; color: var(--text-muted); font-size: 14px; line-height: 1.5; }

    /* One fixed place for form level messages; it never moves the fields below by more than its own height. */
    .banner { border-radius: 10px; padding: 11px 14px; font-size: 14px; margin-bottom: 20px; }
    .banner-error { background: var(--danger-bg); color: #991b1b; border: 1px solid #fecaca; }
    .banner-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    .banner-info { background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; }

    .section-title {
        margin: 26px 0 14px; padding-top: 18px; border-top: 1px solid var(--border-color);
        font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted);
    }
    .section-title:first-of-type { margin-top: 0; padding-top: 0; border-top: 0; }

    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0 16px; }
    .full { grid-column: 1 / -1; }

    .field { margin-bottom: 8px; }
    .field label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--text-main); }
    .req { color: var(--danger); }
    .opt { margin-left: 4px; font-weight: 400; color: var(--text-muted); font-size: 12px; }

    .field input[type="text"], .field input[type="email"], .field input[type="tel"], .field input[type="password"], .field select {
        width: 100%; height: 44px; padding: 0 12px; box-sizing: border-box;
        background: var(--input-bg); border: 1px solid var(--border-color); border-radius: 10px;
        font-size: 14px; color: var(--text-main); outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .field input:focus, .field select:focus { border-color: var(--primary-purple); box-shadow: 0 0 0 3px rgba(124, 58, 237, .15); background: #fff; }
    .field.has-error input, .field.has-error select { border-color: var(--danger); background: var(--danger-bg); }
    .field.has-error input:focus, .field.has-error select:focus { box-shadow: 0 0 0 3px rgba(220, 38, 38, .15); }

    /* The error line is always in the layout (same height with or without a message), so showing one never shifts the form. */
    .field-error { min-height: 18px; margin: 4px 0 0; font-size: 12.5px; line-height: 18px; color: var(--danger); }
    .field-hint { margin: -2px 0 6px; font-size: 12px; color: var(--text-muted); }
    .field.has-error .field-hint { display: none; }

    .pw-wrap { position: relative; }
    .pw-wrap input { padding-right: 64px !important; }
    .pw-toggle {
        position: absolute; right: 6px; top: 6px; height: 32px; padding: 0 10px; border: 0; border-radius: 8px;
        background: transparent; color: var(--primary-purple); font-size: 12px; font-weight: 600; cursor: pointer;
    }
    .pw-toggle:hover { background: rgba(124, 58, 237, .08); }

    .photo-row { display: flex; align-items: center; gap: 14px; }
    .photo-preview {
        width: 64px; height: 64px; flex: 0 0 64px; border-radius: 50%; overflow: hidden;
        background: var(--input-bg); border: 2px solid var(--border-color);
        display: flex; align-items: center; justify-content: center; color: #9ca3af;
    }
    .photo-preview img { width: 100%; height: 100%; object-fit: cover; }
    .photo-pick { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; }
    .photo-btn {
        height: 36px; padding: 0 14px; border: 1px solid var(--border-color); border-radius: 8px;
        background: #fff; color: var(--text-main); font-size: 13px; font-weight: 600; cursor: pointer;
    }
    .photo-btn:hover { border-color: var(--primary-purple); color: var(--primary-purple); }
    .photo-name { font-size: 12.5px; color: var(--text-muted); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #f-imagelink { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

    .btn-submit {
        width: 100%; height: 48px; margin-top: 8px; border: 0; border-radius: 12px;
        background: var(--primary-purple); color: #fff; font-size: 15px; font-weight: 600; cursor: pointer; transition: background .15s;
    }
    .btn-submit:hover { background: var(--primary-dark); }
    .btn-submit:disabled { opacity: .7; cursor: wait; }

    .footer-text { margin: 22px 0 0; text-align: center; font-size: 13px; color: var(--text-muted); }
    .footer-text a { color: var(--primary-purple); font-weight: 700; text-decoration: none; }

    @media (max-width: 860px) {
        .signup-art { display: none; }
        .signup-form { padding: 28px 22px 28px; }
    }
    @media (max-width: 560px) {
        .grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{# No template tagline or broken logo above the card: the card carries the brand. #}
{% block auth_header %}{% endblock %}

{% block content %}
{% import _self as ui %}
<div class="signup-wrap">
    <div class="signup-card">
        <div class="signup-form">
            <div class="signup-top">
                <span class="brand">Nexum</span>
                <a href="{{ path('welcome') }}" class="back-link">&larr; Back</a>
            </div>

            <h1 class="title">Create your account</h1>
            <p class="subtitle">It takes a minute. An administrator activates your account before your first sign in.</p>

            {% for type, messages in app.session.flashbag.all() %}
                {% for message in messages %}
                    <div class="banner banner-{{ type == 'error' or type == 'danger' ? 'error' : (type == 'success' ? 'success' : 'info') }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% if form_error|default(null) %}
                <div class="banner banner-error" role="alert">{{ form_error }}</div>
            {% endif %}
            <div class="banner banner-error" id="form-summary" role="alert" {% if errors|length == 0 %}hidden{% endif %}>
                {% if errors|length > 0 %}Please fix the {{ errors|length == 1 ? 'highlighted field' : errors|length ~ ' highlighted fields' }} below.{% endif %}
            </div>

            <form action="{{ path('signin') }}" method="post" enctype="multipart/form-data" id="signup-form" novalidate>
                <h2 class="section-title">About you</h2>

                {{ ui.open('imagelink', 'Profile photo', errors, false) }}
                    <div class="photo-row">
                        <div class="photo-preview" id="photo-preview">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="30" height="30"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                        </div>
                        <div class="photo-pick">
                            <button type="button" class="photo-btn" id="photo-btn">Choose a photo</button>
                            <span class="photo-name" id="photo-name">JPG, PNG or GIF, 2 MB maximum</span>
                        </div>
                        <input type="file" name="imagelink" id="f-imagelink" accept="image/*">
                    </div>
                {{ ui.close('imagelink', errors, null) }}

                <div class="grid">
                    {{ ui.open('prenom', 'First name', errors, true) }}
                        <input type="text" name="prenom" id="f-prenom" value="{{ old.prenom|default('') }}" autocomplete="given-name" maxlength="50" placeholder="Jane">
                    {{ ui.close('prenom', errors, null) }}
                    {{ ui.open('nom', 'Last name', errors, true) }}
                        <input type="text" name="nom" id="f-nom" value="{{ old.nom|default('') }}" autocomplete="family-name" maxlength="50" placeholder="Doe">
                    {{ ui.close('nom', errors, null) }}
                    <div class="full">
                        {{ ui.open('email', 'Email address', errors, true) }}
                            <input type="email" name="email" id="f-email" value="{{ old.email|default('') }}" autocomplete="email" maxlength="150" placeholder="name@company.com">
                        {{ ui.close('email', errors, null) }}
                    </div>
                    <div class="full">
                        {{ ui.open('telephone', 'Phone number', errors, false) }}
                            <input type="tel" name="telephone" id="f-telephone" value="{{ old.telephone|default('') }}" autocomplete="tel" maxlength="30" placeholder="+216 12 345 678">
                        {{ ui.close('telephone', errors, null) }}
                    </div>
                </div>

                <h2 class="section-title">Your work</h2>
                <div class="grid">
                    {{ ui.open('role', 'Role', errors, true) }}
                        <select name="role" id="f-role">
                            <option value="">Select your role</option>
                            {% for r in roles|default([]) %}
                                <option value="{{ r }}"{{ old.role|default('') == r ? ' selected' : '' }}>{{ r|capitalize }}</option>
                            {% endfor %}
                        </select>
                    {{ ui.close('role', errors, null) }}
                    {{ ui.open('departement', 'Department', errors, false) }}
                        <input type="text" name="departement" id="f-departement" value="{{ old.departement|default('') }}" maxlength="100" placeholder="Engineering, HR, ...">
                    {{ ui.close('departement', errors, null) }}
                </div>

                <h2 class="section-title">Password</h2>
                <div class="grid">
                    {{ ui.open('_password', 'Password', errors, true) }}
                        <div class="pw-wrap">
                            <input type="password" name="_password" id="f-_password" autocomplete="new-password" placeholder="Create a password">
                            <button type="button" class="pw-toggle" data-toggle-password>Show</button>
                        </div>
                    {{ ui.close('_password', errors, 'At least 6 characters.') }}
                    {{ ui.open('confirm_password', 'Confirm password', errors, true) }}
                        <div class="pw-wrap">
                            <input type="password" name="confirm_password" id="f-confirm_password" autocomplete="new-password" placeholder="Repeat the password">
                            <button type="button" class="pw-toggle" data-toggle-password>Show</button>
                        </div>
                    {{ ui.close('confirm_password', errors, null) }}
                </div>

                <button type="submit" class="btn-submit" id="submit-btn">Create account</button>
            </form>

            <p class="footer-text">Already have an account? <a href="{{ path('login') }}">Sign in</a></p>
        </div>

        <div class="signup-art" aria-hidden="true"></div>
    </div>
</div>
{% endblock %}

{% block script %}
<script>
(function () {
    var form = document.getElementById('signup-form');
    var summary = document.getElementById('form-summary');
    var submitBtn = document.getElementById('submit-btn');
    var MAX_PHOTO_BYTES = 2 * 1024 * 1024;
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function el(name) { return form.elements[name]; }
    function val(name) { return el(name) ? el(name).value.trim() : ''; }

    // Same rules as the server (RegistrationInput), so the browser answers instantly and the server stays the judge.
    var rules = {
        prenom: function () { return !val('prenom') ? 'First name is required.' : (val('prenom').length > 50 ? 'First name cannot exceed 50 characters.' : ''); },
        nom: function () { return !val('nom') ? 'Last name is required.' : (val('nom').length > 50 ? 'Last name cannot exceed 50 characters.' : ''); },
        email: function () { return !val('email') ? 'Email is required.' : (!EMAIL_RE.test(val('email')) ? 'Please enter a valid email address.' : ''); },
        telephone: function () { return val('telephone').length > 30 ? 'Phone cannot exceed 30 characters.' : ''; },
        role: function () { return !val('role') ? 'Please select a role.' : ''; },
        departement: function () { return val('departement').length > 100 ? 'Department cannot exceed 100 characters.' : ''; },
        _password: function () { var p = el('_password').value; return !p ? 'Password is required.' : (p.length < 6 ? 'Password must be at least 6 characters.' : ''); },
        confirm_password: function () {
            var c = el('confirm_password').value;
            return !c ? 'Please confirm your password.' : (c !== el('_password').value ? 'Password and confirmation do not match.' : '');
        },
        imagelink: function () {
            var f = el('imagelink').files[0];
            return f && f.size > MAX_PHOTO_BYTES ? 'This photo is too large. Choose one of 2 MB or less.' : '';
        }
    };

    function setError(name, message) {
        var box = form.querySelector('[data-field="' + name + '"]');
        if (!box) return;
        box.classList.toggle('has-error', !!message);
        box.querySelector('.field-error').textContent = message || '';
        var input = el(name);
        if (input) { input.setAttribute('aria-invalid', message ? 'true' : 'false'); input.setAttribute('aria-describedby', 'err-' + name); }
    }

    function refreshSummary() {
        var n = form.querySelectorAll('.field.has-error').length;
        summary.hidden = n === 0;
        summary.textContent = n === 0 ? '' : 'Please fix the ' + (n === 1 ? 'highlighted field' : n + ' highlighted fields') + ' below.';
    }

    function check(name) { setError(name, rules[name]()); refreshSummary(); }

    Object.keys(rules).forEach(function (name) {
        var input = el(name);
        if (!input) return;
        // Check when leaving a field; once a field shows an error, re-check while typing so it clears right away.
        input.addEventListener('blur', function () { if (input.value !== '' || name === 'role') check(name); });
        input.addEventListener('input', function () { if (form.querySelector('[data-field="' + name + '"]').classList.contains('has-error')) check(name); });
        input.addEventListener('change', function () { if (name === 'role' || name === 'imagelink') check(name); });
    });
    el('_password').addEventListener('input', function () { if (el('confirm_password').value) check('confirm_password'); });

    form.addEventListener('submit', function (e) {
        var firstBad = null;
        Object.keys(rules).forEach(function (name) {
            var message = rules[name]();
            setError(name, message);
            if (message && !firstBad) firstBad = el(name);
        });
        refreshSummary();
        if (firstBad) {
            e.preventDefault();
            firstBad.scrollIntoView({ block: 'center', behavior: 'smooth' });
            firstBad.focus({ preventScroll: true });
            return;
        }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating your account...';
    });

    // Photo: refuse a too big file before anything is sent (an oversized body would reach the server empty).
    var photo = el('imagelink');
    document.getElementById('photo-btn').addEventListener('click', function () { photo.click(); });
    photo.addEventListener('change', function () {
        var file = photo.files[0];
        var preview = document.getElementById('photo-preview');
        var name = document.getElementById('photo-name');
        if (file && file.size > MAX_PHOTO_BYTES) { photo.value = ''; name.textContent = 'JPG, PNG or GIF, 2 MB maximum'; setError('imagelink', 'This photo is too large. Choose one of 2 MB or less.'); refreshSummary(); return; }
        setError('imagelink', ''); refreshSummary();
        if (!file) return;
        name.textContent = file.name;
        var reader = new FileReader();
        reader.onload = function (ev) { preview.innerHTML = '<img src="' + ev.target.result + '" alt="Photo preview">'; };
        reader.readAsDataURL(file);
    });

    document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = btn.parentElement.querySelector('input');
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'Hide' : 'Show';
        });
    });

    // After a server side refusal, bring the first problem into view.
    var firstServerError = form.querySelector('.field.has-error');
    if (firstServerError) { firstServerError.scrollIntoView({ block: 'center' }); }
})();
</script>
{% endblock %}
