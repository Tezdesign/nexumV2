{% extends 'layouts/auth.html.twig' %}

{% set title = 'Sign Up - Nexum' %}

{% block css %}
<style>
    :root {
        --primary-purple: #7c3aed;
        --text-main: #111827;
        --text-muted: #6b7280;
        --bg-gray: #f3f4f6;
        --input-bg: #f9fafb;
        --border-color: #e5e7eb;
    }

    body {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background-color: var(--bg-gray);
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-card {
        background: white;
        width: 900px;
        max-width: 95%;
        height: 550px;
        border-radius: 24px;
        display: flex;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
    }

    /* Left Section: Form */
    .form-section {
        flex: 1;
        padding: 50px 60px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        overflow-y: auto;
        max-height: 100%;
    }

    .form-scroll-container {
        overflow-y: auto;
        max-height: 450px;
        padding-right: 10px;
        padding-left: 5px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 252, 0.95) 100%);
        border-radius: 16px;
        margin: -10px;
        padding-top: 20px;
        padding-bottom: 20px;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.06);
    }

    /* Enhanced scrollbar styling */
    .form-scroll-container::-webkit-scrollbar {
        width: 8px;
    }

    .form-scroll-container::-webkit-scrollbar-track {
        background: rgba(124, 58, 237, 0.1);
        border-radius: 10px;
        margin: 10px 0;
    }

    .form-scroll-container::-webkit-scrollbar-thumb {
        background: linear-gradient(180deg, var(--primary-purple) 0%, #6d28d9 100%);
        border-radius: 10px;
        border: 2px solid rgba(124, 58, 237, 0.2);
        transition: all 0.3s ease;
    }

    .form-scroll-container::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(180deg, #8b5cf6 0%, var(--primary-purple) 100%);
        border-color: rgba(124, 58, 237, 0.4);
        transform: scaleY(1.1);
    }

    /* Smooth scroll behavior */
    .form-scroll-container {
        scroll-behavior: smooth;
        scrollbar-width: thin;
        scrollbar-color: var(--primary-purple) rgba(124, 58, 237, 0.1);
    }

    /* Firefox scrollbar */
    .form-scroll-container::-moz-scrollbar-thumb {
        background: var(--primary-purple);
        border-radius: 10px;
        border: 2px solid rgba(124, 58, 237, 0.2);
    }

    .form-scroll-container::-moz-scrollbar-track {
        background: rgba(124, 58, 237, 0.1);
        border-radius: 10px;
    }

    .profile-image-container {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .profile-image-preview {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: var(--input-bg);
        border: 2px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        flex-shrink: 0;
    }

    .profile-image-preview img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 50%;
    }

    .profile-image-container .input-wrapper {
        flex: 1;
        position: relative;
    }

    .file-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .file-input-button {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: var(--primary-purple);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        z-index: 10;
    }

    .file-input-button:hover {
        background: #6d28d9;
        transform: translateY(-50%) scale(1.05);
    }

    .file-input-display {
        width: 100%;
        padding: 12px 100px 12px 40px;
        background-color: var(--input-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-size: 14px;
        color: var(--text-muted);
        outline: none;
        transition: border-color 0.2s;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .file-input-display:focus {
        border-color: var(--primary-purple);
    }

    input[type="file"] {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    .back-link {
        text-decoration: none;
        color: var(--text-muted);
        font-size: 14px;
        margin-bottom: 30px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 8px;
        background: rgba(255, 255, 255, 0.8);
        border: 1px solid var(--border-color);
        transition: all 0.3s ease;
        font-weight: 500;
        backdrop-filter: blur(10px);
    }

    .back-link:hover {
        color: var(--primary-purple);
        background: rgba(124, 58, 237, 0.1);
        border-color: var(--primary-purple);
        transform: translateY(-2px);
    }

    .back-link svg {
        transition: transform 0.3s ease;
    }

    .back-link:hover svg {
        transform: translateX(-3px);
    }

    .title {
        color: var(--text-main);
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .subtitle {
        color: var(--text-muted);
        font-size: 14px;
        margin-bottom: 35px;
    }

    .form-group {
        margin-bottom: 20px;
        position: relative;
    }

    .label-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 8px;
    }

    label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-main);
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        color: #9ca3af;
    }

    input {
        width: 100%;
        padding: 12px 12px 12px 40px;
        background-color: var(--input-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
    }

    input:focus {
        border-color: var(--primary-purple);
    }

    .btn-signup {
        width: 100%;
        padding: 14px;
        background-color: var(--primary-purple);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 10px;
        transition: opacity 0.2s;
    }

    .btn-signup:hover {
        opacity: 0.9;
    }

    .footer-text {
        text-align: center;
        margin-top: 25px;
        font-size: 13px;
        color: var(--text-muted);
    }

    .sign-in-link {
        color: var(--primary-purple);
        text-decoration: none;
        font-weight: 700;
    }

    /* Right Section: Image */
    .image-section {
        flex: 1;
        background-color: #1e1b4b; /* Dark Navy Fallback */
        background-image: url('{{ asset('images/users/purple.jpg') }}');
        background-size: cover;
        background-position: center;
        position: relative;
    }

    /* Overlay to mimic purple glow in screenshot */
    .image-section::after {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        background: radial-gradient(circle at center, rgba(124, 58, 237, 0.2) 0%, transparent 70%);
    }

    @media (max-width: 768px) {
        .auth-card {
            flex-direction: column;
            height: auto;
            width: 400px;
        }
        .image-section {
            display: none;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="auth-card">
    <div class="form-section">
        <a href="{{ path('welcome') }}" class="back-link">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
            Back
        </a>

        <h1 class="title">Create Account</h1>
        <p class="subtitle">Sign up to get started with Nexum</p>

        {% for type, messages in app.session.flashbag.all() %}
            {% for message in messages %}
                <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" style="margin-bottom: 20px; padding: 12px 16px; border-radius: 8px; font-size: 14px;">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="float: right; font-size: 16px; background: none; border: none; cursor: pointer;">×</button>
                </div>
            {% endfor %}
        {% endfor %}

        <form action="{{ path('signin') }}" method="post" enctype="multipart/form-data" id="nexum-signin-form" novalidate>
            <div class="form-scroll-container">
            <div class="js-validation-summary alert alert-danger py-2 px-3 small d-none mb-3" role="alert" style="margin-left: 5px; margin-right: 10px;"></div>
            <div class="form-group">
                <label>Profile Image</label>
                <div class="profile-image-container">
                    <div class="profile-image-preview" id="imagePreview">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="40" height="40" style="color: #9ca3af;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                    <div class="input-wrapper file-input-wrapper">
                        <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        <input type="file" name="imagelink" accept="image/*" id="imageInput">
                        <div class="file-input-display" id="fileDisplay">Choose file</div>
                        <button type="button" class="file-input-button" onclick="document.getElementById('imageInput').click()">Browse</button>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label>Face Registration (Optional)</label>
                <div class="face-capture-container">
                    <video id="faceVideo" width="320" height="240" style="display: none; border-radius: 10px; margin-bottom: 10px;"></video>
                    <canvas id="faceCanvas" width="320" height="240" style="display: none;"></canvas>
                    <div class="face-capture-buttons">
                        <button type="button" id="startCameraBtn" class="btn-secondary" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer; margin-right: 10px;">
                            📷 Start Camera
                        </button>
                        <button type="button" id="captureFaceBtn" class="btn-secondary" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer; margin-right: 10px; display: none;">
                            📸 Capture Face
                        </button>
                        <button type="button" id="stopCameraBtn" class="btn-secondary" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer; display: none;">
                            🛑 Stop Camera
                        </button>
                    </div>
                    <div id="facePreview" style="margin-top: 10px;"></div>
                    <input type="hidden" name="face_data" id="faceDataInput">
                </div>
            </div>

            <div class="form-group">
                <label>First Name</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    <input type="text" name="prenom" placeholder="Enter your first name" autocomplete="given-name">
                </div>
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    <input type="text" name="nom" placeholder="Enter your last name" autocomplete="family-name">
                </div>
            </div>

            <div class="form-group">
                <label>Email Address</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <input type="text" name="email" placeholder="name@company.com" autocomplete="email">
                </div>
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                    <input type="tel" name="telephone" placeholder="+1 (555) 123-4567">
                </div>
            </div>

            <div class="form-group">
                <label>Role</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                    <select name="role" style="width: 100%; padding: 12px 12px 12px 40px; background-color: var(--input-bg); border: 1px solid var(--border-color); border-radius: 10px; font-size: 14px; outline: none;">
                        <option value="">Select your role</option>
                        <option value="employee">Employee</option>
                        <option value="manager">Manager</option>
                        <option value="admin">Administrator</option>
                        <option value="hr">HR</option>
                        <option value="finance">Finance</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Department</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                    <input type="text" name="departement" placeholder="e.g., Engineering, Marketing, HR">
                </div>
            </div>

            
            <div class="form-group">
                <label>Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <input type="password" name="_password" placeholder="Create a password" autocomplete="new-password">
                </div>
            </div>

            <div class="form-group">
                <label>Confirm Password</label>
                <div class="input-wrapper">
                    <svg class="input-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                    <input type="password" name="confirm_password" placeholder="Confirm your password" autocomplete="new-password">
                </div>
            </div>

            <button type="submit" class="btn-signup">Sign Up</button>
            </div>
        </form>

        <p class="footer-text">
            Already have an account? <a href="{{ path('login') }}" class="sign-in-link">Sign In</a>
        </p>
    </div>

    <div class="image-section"></div>
</div>
{% endblock %}

{% block script %}
<script src="{{ asset('js/nexum-validation.js') }}"></script>
<script>
(function () {
    var form = document.getElementById('nexum-signin-form');
    if (form && window.NexumValidate) {
        form.addEventListener('submit', function (e) {
            if (NexumValidate.signinForm(form).length) e.preventDefault();
        });
    }
})();
document.getElementById('imageInput').addEventListener('change', function(e) {
    const file = e.target.files[0];
    const preview = document.getElementById('imagePreview');
    const fileDisplay = document.getElementById('fileDisplay');
    
    if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
            preview.innerHTML = '<img src="' + e.target.result + '" alt="Profile preview">';
            fileDisplay.textContent = file.name;
            fileDisplay.style.color = 'var(--text-main)';
        }
        reader.readAsDataURL(file);
    }
});

// Face capture functionality
let stream = null;
const video = document.getElementById('faceVideo');
const canvas = document.getElementById('faceCanvas');
const startCameraBtn = document.getElementById('startCameraBtn');
const captureFaceBtn = document.getElementById('captureFaceBtn');
const stopCameraBtn = document.getElementById('stopCameraBtn');
const facePreview = document.getElementById('facePreview');
const faceDataInput = document.getElementById('faceDataInput');

startCameraBtn.addEventListener('click', async function() {
    try {
        stream = await navigator.mediaDevices.getUserMedia({ 
            video: { 
                width: { ideal: 640 },
                height: { ideal: 480 },
                facingMode: 'user'
            } 
        });
        video.srcObject = stream;
        video.style.display = 'block';
        video.play();
        
        startCameraBtn.style.display = 'none';
        captureFaceBtn.style.display = 'inline-block';
        stopCameraBtn.style.display = 'inline-block';
    } catch (err) {
        console.error('Error accessing camera:', err);
        alert('Unable to access camera. Please ensure you have granted camera permissions.');
    }
});

captureFaceBtn.addEventListener('click', function() {
    const context = canvas.getContext('2d');
    canvas.width = video.videoWidth;
    canvas.height = video.videoHeight;
    context.drawImage(video, 0, 0, canvas.width, canvas.height);
    
    canvas.toBlob(function(blob) {
        const reader = new FileReader();
        reader.onloadend = function() {
            const base64data = reader.result;
            faceDataInput.value = base64data;
            
            // Show preview
            const img = document.createElement('img');
            img.src = base64data;
            img.style.width = '160px';
            img.style.height = '120px';
            img.style.borderRadius = '10px';
            img.style.border = '2px solid var(--primary-purple)';
            
            facePreview.innerHTML = '<p style="margin-bottom: 5px; font-size: 13px; color: var(--text-muted);">Face captured successfully!</p>';
            facePreview.appendChild(img);
            
            // Stop camera after capture
            stopCamera();
        };
        reader.readAsDataURL(blob);
    }, 'image/jpeg', 0.9);
});

stopCameraBtn.addEventListener('click', stopCamera);

function stopCamera() {
    if (stream) {
        stream.getTracks().forEach(track => track.stop());
        video.style.display = 'none';
        canvas.style.display = 'none';
        
        startCameraBtn.style.display = 'inline-block';
        captureFaceBtn.style.display = 'none';
        stopCameraBtn.style.display = 'none';
    }
}
</script>

<!-- Face Registration Popup Modal -->
<div id="faceRegistrationModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
    <div style="background: white; padding: 30px; border-radius: 15px; max-width: 500px; width: 90%; text-align: center; position: relative;">
        <h3 style="margin-bottom: 20px; color: var(--text-main);">Register Your Face</h3>
        <p style="margin-bottom: 20px; color: var(--text-muted); font-size: 14px;">Click "Start Camera" and position your face in the frame, then click "Capture Face".</p>
        
        <video id="modalFaceVideo" width="320" height="240" style="display: none; border-radius: 10px; margin: 0 auto 15px; border: 2px solid var(--border-color);"></video>
        <canvas id="modalFaceCanvas" width="320" height="240" style="display: none;"></canvas>
        
        <div id="modalFacePreview" style="margin: 15px 0; min-height: 120px;"></div>
        
        <div style="display: flex; justify-content: center; gap: 10px; flex-wrap: wrap;">
            <button type="button" id="modalStartCameraBtn" style="padding: 10px 20px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer;">
                Start Camera
            </button>
            <button type="button" id="modalCaptureFaceBtn" style="padding: 10px 20px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer; display: none;">
                Capture Face
            </button>
            <button type="button" id="modalStopCameraBtn" style="padding: 10px 20px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer; display: none;">
                Stop Camera
            </button>
        </div>
        
        <div style="margin-top: 20px; display: flex; justify-content: center; gap: 10px;">
            <button type="button" id="modalSaveFaceBtn" style="padding: 12px 24px; border-radius: 10px; border: none; background: var(--primary-purple); color: white; cursor: pointer; display: none;">
                Save Face
            </button>
            <button type="button" id="modalCancelBtn" style="padding: 12px 24px; border-radius: 10px; border: 1px solid var(--border-color); background: var(--input-bg); color: var(--text-main); cursor: pointer;">
                Cancel
            </button>
        </div>
        
        <button type="button" id="modalCloseBtn" style="position: absolute; top: 15px; right: 15px; background: none; border: none; font-size: 24px; cursor: pointer; color: var(--text-muted);">×</button>
    </div>
</div>

<script>
// Face Registration Modal JavaScript
let modalStream = null;
const modalFaceVideo = document.getElementById('modalFaceVideo');
const modalFaceCanvas = document.getElementById('modalFaceCanvas');
const modalStartCameraBtn = document.getElementById('modalStartCameraBtn');
const modalCaptureFaceBtn = document.getElementById('modalCaptureFaceBtn');
const modalStopCameraBtn = document.getElementById('modalStopCameraBtn');
const modalSaveFaceBtn = document.getElementById('modalSaveFaceBtn');
const modalCancelBtn = document.getElementById('modalCancelBtn');
const modalCloseBtn = document.getElementById('modalCloseBtn');
const modalFacePreview = document.getElementById('modalFacePreview');
const faceRegistrationModal = document.getElementById('faceRegistrationModal');
const openFaceRegistrationBtn = document.getElementById('openFaceRegistrationBtn');
const faceRegistrationStatus = document.getElementById('faceRegistrationStatus');
const faceDataInput = document.getElementById('faceDataInput');

// Open modal
openFaceRegistrationBtn.addEventListener('click', function() {
    faceRegistrationModal.style.display = 'flex';
});

// Close modal
modalCloseBtn.addEventListener('click', closeModal);
modalCancelBtn.addEventListener('click', closeModal);

function closeModal() {
    stopModalCamera();
    faceRegistrationModal.style.display = 'none';
    modalFacePreview.innerHTML = '';
    modalSaveFaceBtn.style.display = 'none';
}

// Start camera in modal
modalStartCameraBtn.addEventListener('click', async function() {
    try {
        modalStream = await navigator.mediaDevices.getUserMedia({ 
            video: { 
                width: { ideal: 640 },
                height: { ideal: 480 },
                facingMode: 'user'
            } 
        });
        modalFaceVideo.srcObject = modalStream;
        modalFaceVideo.style.display = 'block';
        modalFaceVideo.play();
        
        modalStartCameraBtn.style.display = 'none';
        modalCaptureFaceBtn.style.display = 'inline-block';
        modalStopCameraBtn.style.display = 'inline-block';
    } catch (err) {
        console.error('Error accessing camera:', err);
        alert('Unable to access camera. Please ensure you have granted camera permissions.');
    }
});

// Capture face in modal
modalCaptureFaceBtn.addEventListener('click', function() {
    const context = modalFaceCanvas.getContext('2d');
    modalFaceCanvas.width = modalFaceVideo.videoWidth;
    modalFaceCanvas.height = modalFaceVideo.videoHeight;
    context.drawImage(modalFaceVideo, 0, 0, modalFaceCanvas.width, modalFaceCanvas.height);
    
    modalFaceCanvas.toBlob(function(blob) {
        const reader = new FileReader();
        reader.onloadend = function() {
            const base64data = reader.result;
            
            // Show preview
            const img = document.createElement('img');
            img.src = base64data;
            img.style.width = '160px';
            img.style.height = '120px';
            img.style.borderRadius = '10px';
            img.style.border = '2px solid var(--primary-purple)';
            
            modalFacePreview.innerHTML = '<p style="margin-bottom: 10px; font-size: 14px; color: var(--text-muted);">Face captured! Review and save.</p>';
            modalFacePreview.appendChild(img);
            
            // Show save button
            modalSaveFaceBtn.style.display = 'inline-block';
            
            // Store face data
            faceDataInput.value = base64data;
        };
        reader.readAsDataURL(blob);
    }, 'image/jpeg', 0.9);
});

// Stop camera in modal
modalStopCameraBtn.addEventListener('click', stopModalCamera);

function stopModalCamera() {
    if (modalStream) {
        modalStream.getTracks().forEach(track => track.stop());
        modalFaceVideo.style.display = 'none';
        modalFaceCanvas.style.display = 'none';
        
        modalStartCameraBtn.style.display = 'inline-block';
        modalCaptureFaceBtn.style.display = 'none';
        modalStopCameraBtn.style.display = 'none';
    }
}

// Save face and close modal
modalSaveFaceBtn.addEventListener('click', function() {
    faceRegistrationStatus.innerHTML = '<span style="color: var(--primary-purple);">Face registered successfully!</span>';
    closeModal();
});
</script>
{% endblock %}
