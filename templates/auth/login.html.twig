{% extends 'layouts/auth.html.twig' %}

{% set title = 'Sign In - Nexum' %}

{% set errors = errors|default({}) %}
{% set old = old|default({}) %}

{% import 'auth/_form_ui.html.twig' as ui %}

{% block css %}
{{ include('auth/_form_styles.html.twig') }}
<style>
    .captcha-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
    .captcha-img { display: block; height: 56px; width: auto; max-width: calc(100% - 52px); border: 1px solid var(--border-color); border-radius: 10px; background: var(--input-bg); }
    .btn-reload {
        flex: 0 0 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--border-color); border-radius: 10px; background: #fff; color: var(--text-main); cursor: pointer;
    }
    .btn-reload:hover { border-color: var(--primary-purple); color: var(--primary-purple); }
    .subtle { margin: 14px 0 0; text-align: center; font-size: 12.5px; color: var(--text-muted); }
</style>
{% endblock %}

{# No template tagline or broken logo above the card: the card carries the brand. #}
{% block auth_header %}{% endblock %}

{% block content %}
<div class="nx-wrap">
    <div class="nx-card">
        <div class="nx-form">
            <div class="nx-top">
                <span class="brand">Nexum</span>
                <a href="{{ path('welcome') }}" class="back-link">&larr; Back</a>
            </div>

            <h1 class="title">Welcome back</h1>
            <p class="subtitle">Sign in to open your workspace.</p>

            {% for type, messages in app.session.flashbag.all() %}
                {% for message in messages %}
                    <div class="banner banner-{{ type == 'error' or type == 'danger' ? 'error' : (type == 'success' ? 'success' : 'info') }}" role="alert">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% if form_error|default(null) %}
                <div class="banner banner-error" role="alert">{{ form_error }}</div>
            {% endif %}

            <form action="{{ path('login') }}" method="post" id="login-form" novalidate>
                {{ ui.open('_username', 'Email address', errors) }}
                    <input type="email" name="_username" id="f-_username" value="{{ old._username|default('') }}" autocomplete="username" maxlength="150" placeholder="name@company.com" autofocus>
                {{ ui.close('_username', errors) }}

                {{ ui.open('_password', 'Password', errors) }}
                    <div class="pw-wrap">
                        <input type="password" name="_password" id="f-_password" autocomplete="current-password" placeholder="Your password">
                        <button type="button" class="pw-toggle" data-toggle-password>Show</button>
                    </div>
                {{ ui.close('_password', errors) }}

                {{ ui.open('_captcha', 'Security code', errors) }}
                    <div class="captcha-row">
                        <img id="captcha-img" class="captcha-img" src="{{ path('login_captcha') }}" alt="Security code">
                        <button type="button" class="btn-reload" id="captcha-reload" title="New image" aria-label="Get a new security image">
                            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                        </button>
                    </div>
                    <input type="text" name="_captcha" id="f-_captcha" maxlength="12" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Type the characters above">
                {{ ui.close('_captcha', errors) }}

                <button type="submit" class="btn-submit" id="submit-btn">Sign in</button>
            </form>

            <p class="footer-text">New here? <a href="{{ path('signin') }}">Create an account</a></p>
            <p class="subtle">New accounts are activated by an administrator. Forgot your password? Ask an administrator to reset it.</p>
        </div>

        <div class="nx-art" aria-hidden="true"></div>
    </div>
</div>
{% endblock %}

{% block script %}
<script>
(function () {
    var form = document.getElementById('login-form');
    var submitBtn = document.getElementById('submit-btn');
    var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    function el(name) { return form.elements[name]; }

    // Same rules as the server (LoginInput and the captcha), so the browser answers instantly.
    var rules = {
        _username: function () { var v = el('_username').value.trim(); return !v ? 'Email is required.' : (!EMAIL_RE.test(v) ? 'Please enter a valid email address.' : ''); },
        _password: function () { return !el('_password').value ? 'Password is required.' : ''; },
        _captcha: function () {
            var v = el('_captcha').value.trim();
            return !v ? 'Type the characters from the image.' : (!/^[A-Za-z0-9 ]+$/.test(v) ? 'Use only letters and numbers.' : '');
        }
    };

    function setError(name, message) {
        var box = form.querySelector('[data-field="' + name + '"]');
        box.classList.toggle('has-error', !!message);
        box.querySelector('.field-error').textContent = message || '';
        el(name).setAttribute('aria-invalid', message ? 'true' : 'false');
        el(name).setAttribute('aria-describedby', 'err-' + name);
    }

    Object.keys(rules).forEach(function (name) {
        var input = el(name);
        input.addEventListener('blur', function () { if (input.value !== '') setError(name, rules[name]()); });
        input.addEventListener('input', function () {
            if (form.querySelector('[data-field="' + name + '"]').classList.contains('has-error')) setError(name, rules[name]());
        });
    });

    form.addEventListener('submit', function (e) {
        var firstBad = null;
        Object.keys(rules).forEach(function (name) {
            var message = rules[name]();
            setError(name, message);
            if (message && !firstBad) firstBad = el(name);
        });
        if (firstBad) { e.preventDefault(); firstBad.focus(); return; }
        submitBtn.disabled = true;
        submitBtn.textContent = 'Signing in...';
    });

    var img = document.getElementById('captcha-img');
    document.getElementById('captcha-reload').addEventListener('click', function () {
        img.src = "{{ path('login_captcha')|e('js') }}?renew=1&t=" + Date.now();
        el('_captcha').value = '';
        setError('_captcha', '');
        el('_captcha').focus();
    });

    document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var input = btn.parentElement.querySelector('input');
            var show = input.type === 'password';
            input.type = show ? 'text' : 'password';
            btn.textContent = show ? 'Hide' : 'Show';
        });
    });

    // After a server refusal, put the cursor where the problem is (a wrong captcha, or the password after a wrong login).
    var bad = form.querySelector('.field.has-error input');
    if (bad) { bad.focus(); }
    else if (document.querySelector('.banner-error')) { el('_password').focus(); }
})();
</script>
{% endblock %}
