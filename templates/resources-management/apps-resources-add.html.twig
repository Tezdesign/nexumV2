{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Add New Resource' %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">Add New Resource</h4>
                <a href="{{ path('apps-resources-management') }}" class="btn btn-secondary btn-sm">
                    <i class="mdi mdi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="header-title mb-4 text-primary">Resource Information</h5>
                    
                    <form action="#" method="POST">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Resource Name</label>
                                <input type="text" class="form-control" name="resource_name" placeholder="e.g. Dell Latitude 5400" required>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Resource Code</label>
                                <input type="text" class="form-control" name="resource_code" placeholder="e.g. 1004" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Resource Type</label>
                                <select class="form-select" name="resource_type">
                                    <option value="PHYSICAL">PHYSICAL (Hardware, Kits)</option>
                                    <option value="SOFTWARE">SOFTWARE (Licenses, Hosting)</option>
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Unit Cost ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" name="unit_cost" placeholder="0.00">
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Initial Quantity</label>
                                <input type="number" class="form-control" name="total_quantity" value="0">
                            </div>

                            <div class="col-md-8 mb-3">
                                <label class="form-label fw-bold">Availability Status</label>
                                <div class="d-flex gap-3 mt-1">
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="status" id="status1" value="AVAILABLE" checked>
                                        <label class="form-check-label" for="status1">Available</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="status" id="status2" value="OUT_OF_STOCK">
                                        <label class="form-check-label" for="status2">Out of Stock</label>
                                    </div>
                                </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-end gap-2">
                            <button type="reset" class="btn btn-light px-4">Clear Form</button>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">Save Resource</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}