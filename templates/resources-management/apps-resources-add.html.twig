{% extends 'layouts/vertical.html.twig' %}

{% set title = is_edit is defined and is_edit ? 'Edit Resource' : 'Add New Resource' %}

{% block content %}
<div class="container-fluid">

    <!-- Page Title -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex align-items-center justify-content-between">
                <h4 class="mb-0">{{ title }}</h4>
                <a href="{{ path('app_resource_management_index') }}" class="btn btn-secondary btn-sm">
                    <i class="mdi mdi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>
    </div>

    <!-- Flash Messages -->
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                {{ message|raw }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- Form Card -->
    <div class="row justify-content-center">
        <div class="col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="text-primary mb-4">Resource Information</h5>

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}, 'enctype': 'multipart/form-data'}) }}

                    <div class="row">

                        <div class="col-md-8 mb-3">
                            {{ form_label(form.resource_name, 'Resource Name', {'label_attr': {'class':'form-label fw-bold'}}) }}
                            {{ form_widget(form.resource_name, {'attr': {'class':'form-control', 'placeholder':'e.g. Dell Latitude 5400'}}) }}
                            {{ form_errors(form.resource_name) }}
                        </div>

                        <div class="col-md-4 mb-3">
                            {{ form_label(form.resource_code, 'Resource Code', {'label_attr': {'class':'form-label fw-bold'}}) }}
                            {{ form_widget(form.resource_code, {'attr': {'class':'form-control', 'placeholder':'e.g. RES-1001'}}) }}
                            {{ form_errors(form.resource_code) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.resource_type, 'Resource Type', {'label_attr': {'class':'form-label fw-bold'}}) }}
                            {{ form_widget(form.resource_type, {'attr': {'class':'form-select'}}) }}
                            {{ form_errors(form.resource_type) }}
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.unit_cost, 'Unit Cost', {'label_attr': {'class':'form-label fw-bold'}}) }}
                            <div class="input-group">
                                <span class="input-group-text">TND</span>
                                {{ form_widget(form.unit_cost, {'attr': {'class':'form-control', 'placeholder':'0.00'}}) }}
                            </div>
                            {{ form_errors(form.unit_cost) }}
                        </div>

                        <div class="col-md-4 mb-3">
                            {{ form_label(form.total_quantity, 'Initial Quantity', {'label_attr': {'class':'form-label fw-bold'}}) }}
                            {{ form_widget(form.total_quantity, {'attr': {'class':'form-control'}}) }}
                            {{ form_errors(form.total_quantity) }}
                        </div>

                        <div class="col-md-8 mb-3">
                            {{ form_label(form.image_path, 'Image', {'label_attr': {'class':'form-label fw-bold'}}) }}
                            {{ form_widget(form.image_path, {'attr': {'class':'form-control'}}) }}
                            {{ form_errors(form.image_path) }}

                            {% if form.vars.value.imagePath %}
                                <div class="mt-2">
                                    <img src="{{ asset(form.vars.value.imagePath) }}" alt="Resource Image" style="height:150px; object-fit:cover;">
                                </div>
                            {% endif %}
                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-end gap-2">
                        <button type="reset" class="btn btn-light px-4">Clear Form</button>
                        <button type="submit" class="btn btn-primary px-5 shadow-sm">
                            {{ is_edit is defined and is_edit ? 'Update Resource' : 'Save Resource' }}
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}