{% extends 'layouts/admin_vertical.html.twig' %}

{% block content %}
<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>AI Resource Forecast Dashboard</h2>
            <p class="text-muted mb-0">Live demand forecast based on recorded assignments.</p>
        </div>
    </div>

    <div class="row mb-3 g-3">
        <div class="col-md-4">
            <select id="resourceSelect" class="form-control">
                <option value="all">All Resources</option>
                {% for r in resources %}
                    <option value="{{ r.id }}">{{ r.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="col-md-8 d-flex gap-2 flex-wrap">
            <button class="btn btn-outline-secondary active" type="button" data-type="all">All Types</button>
            <button class="btn btn-outline-success" type="button" data-type="PHYSICAL">Physical</button>
            <button class="btn btn-outline-primary" type="button" data-type="SOFTWARE">Software</button>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card p-3 shadow-sm h-100">
                <h6 class="text-muted">Predicted Demand</h6>
                <h2 class="text-primary mb-0" id="predictedDemandValue">{{ prediction|number_format(2, '.', '') }}</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 shadow-sm h-100 border-success">
                <h6 class="text-muted">Available Stock</h6>
                <h3 class="text-success mb-0" id="availableStockValue">0</h3>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3 shadow-sm h-100 border-warning">
                <h6 class="text-muted">Status</h6>
                <h3 class="mb-0" id="forecastStatusValue">Monitoring</h3>
            </div>
        </div>
    </div>

    <div class="card p-4 shadow-sm mb-4">
        <canvas id="demandChart" height="100"></canvas>
    </div>

    <div class="card p-3 shadow-sm">
        <h5 class="mb-3">Filtered Resource Stock</h5>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Type</th>
                        <th>Total</th>
                        <th>Available</th>
                    </tr>
                </thead>
                <tbody id="resourceTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const rawData = JSON.parse('{{ data|json_encode|e('js') }}');
    const resources = JSON.parse('{{ resources|json_encode|e('js') }}');
    const serverPrediction = Number('{{ prediction|number_format(2, ".", "") }}');

    const resourceSelect = document.getElementById('resourceSelect');
    const typeButtons = Array.from(document.querySelectorAll('[data-type]'));
    const predictedDemandValue = document.getElementById('predictedDemandValue');
    const availableStockValue = document.getElementById('availableStockValue');
    const forecastStatusValue = document.getElementById('forecastStatusValue');
    const resourceTableBody = document.getElementById('resourceTableBody');
    const ctx = document.getElementById('demandChart');

    let currentType = 'all';
    let currentResource = 'all';

    function normalizeType(value) {
        return String(value || '').trim().toUpperCase();
    }

    function formatNumber(value) {
        return Number.isFinite(value) ? value.toFixed(2) : '0.00';
    }

    function groupDemandByDate(data) {
        const grouped = {};

        data.forEach(item => {
            const quantity = Number(item.quantity);

            if (!Number.isFinite(quantity)) {
                return;
            }

            grouped[item.date] = (grouped[item.date] || 0) + quantity;
        });

        const labels = Object.keys(grouped).sort();
        const values = labels.map(label => grouped[label]);

        return { labels, values };
    }

    function calculateForecast(values) {
        if (!values.length) {
            return 0;
        }

        if (values.length === 1) {
            return values[0];
        }

        if (values.length < 3) {
            const average = values.reduce((total, value) => total + value, 0) / values.length;
            return Math.max(0, average);
        }

        const points = values.map((value, index) => ({ x: index, y: value }));
        const count = points.length;
        const sumX = points.reduce((total, point) => total + point.x, 0);
        const sumY = points.reduce((total, point) => total + point.y, 0);
        const sumXY = points.reduce((total, point) => total + (point.x * point.y), 0);
        const sumXX = points.reduce((total, point) => total + (point.x * point.x), 0);
        const denominator = (count * sumXX) - (sumX * sumX);

        if (denominator === 0) {
            return values[count - 1];
        }

        const slope = ((count * sumXY) - (sumX * sumY)) / denominator;
        const intercept = (sumY - (slope * sumX)) / count;
        const regressionPrediction = intercept + (slope * count);
        const recentWindow = values.slice(-Math.min(3, values.length));
        const recentAverage = recentWindow.reduce((total, value) => total + value, 0) / recentWindow.length;
        const prediction = Number.isFinite(regressionPrediction) ? regressionPrediction : recentAverage;

        if (prediction > 0) {
            return prediction;
        }

        return Math.max(0, recentAverage || values[count - 1] || 0);
    }

    function getFilteredResources() {
        return resources.filter(resource => {
            const matchesResource = currentResource === 'all' || String(resource.id) === currentResource;
            const matchesType = currentType === 'all' || normalizeType(resource.type) === currentType;

            return matchesResource && matchesType;
        });
    }

    function getFilteredAssignments() {
        return rawData.filter(item => {
            const matchesResource = currentResource === 'all' || String(item.resource_id) === currentResource;
            const matchesType = currentType === 'all' || normalizeType(item.type) === currentType;

            return matchesResource && matchesType;
        });
    }

    function renderResourceTable(filteredResources) {
        if (!filteredResources.length) {
            resourceTableBody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No resources match the current filters.</td></tr>';
            return;
        }

        resourceTableBody.innerHTML = filteredResources.map(resource => `
            <tr>
                <td>${resource.name}</td>
                <td>${resource.type}</td>
                <td>${resource.total}</td>
                <td>${resource.available}</td>
            </tr>
        `).join('');
    }

    function updateSummary(filteredResources, prediction) {
        const availableStock = filteredResources.reduce((total, resource) => total + Number(resource.available || 0), 0);
        let statusLabel = 'Monitoring';
        let statusClass = 'text-warning';

        if (!filteredResources.length) {
            statusLabel = 'No Data';
            statusClass = 'text-muted';
        } else if (prediction <= availableStock) {
            statusLabel = 'Healthy';
            statusClass = 'text-success';
        } else {
            statusLabel = 'Shortage Risk';
            statusClass = 'text-danger';
        }

        predictedDemandValue.textContent = formatNumber(prediction);
        availableStockValue.textContent = String(availableStock);
        forecastStatusValue.textContent = statusLabel;
        forecastStatusValue.className = statusClass + ' mb-0';
    }

    function renderChart(labels, values, prediction) {
        const chartLabels = labels.length ? [...labels, 'Next'] : ['Next'];
        const demandSeries = labels.length ? [...values, null] : [null];
        const predictionSeries = labels.length
            ? [...values.slice(0, -1), values[values.length - 1], prediction]
            : [prediction];

        if (window.myChart) {
            window.myChart.destroy();
        }

        window.myChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: chartLabels,
                datasets: [
                    {
                        label: 'Historical Demand',
                        data: demandSeries,
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.12)',
                        fill: true,
                        tension: 0.35,
                        spanGaps: true
                    },
                    {
                        label: 'Forecast',
                        data: predictionSeries,
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.08)',
                        borderDash: [6, 6],
                        tension: 0.35,
                        spanGaps: true
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    }

    function refreshDashboard() {
        const filteredResources = getFilteredResources();
        const filteredAssignments = getFilteredAssignments();
        const grouped = groupDemandByDate(filteredAssignments);
        const prediction = currentResource === 'all' && currentType === 'all' && Number.isFinite(serverPrediction) && serverPrediction > 0
            ? serverPrediction
            : calculateForecast(grouped.values);

        renderResourceTable(filteredResources);
        updateSummary(filteredResources, prediction);
        renderChart(grouped.labels, grouped.values, prediction);
    }

    resourceSelect.addEventListener('change', function () {
        currentResource = this.value;
        refreshDashboard();
    });

    typeButtons.forEach(button => {
        button.addEventListener('click', function () {
            currentType = this.dataset.type;

            typeButtons.forEach(item => item.classList.remove('active'));
            this.classList.add('active');

            refreshDashboard();
        });
    });

    refreshDashboard();
});
</script>
{% endblock %}
