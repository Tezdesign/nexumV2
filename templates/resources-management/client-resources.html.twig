{% extends 'layouts/vertical.html.twig' %}

{% set title = 'My Resource Assignments' %}

{% block content %}
<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="text-primary fw-bold">My Resource Assignments</h4>
        <a href="{{ path('request_resource') }}" class="btn btn-primary">Request +</a>
    </div>

    <!-- Cards -->
    <div class="row g-4">
        {% if emptyMessage %}
            <p class="text-muted">{{ emptyMessage }}</p>
        {% else %}
            {% for item in resourceData %}
                {% set assignment = item.assignment %}
                {% set resource = item.resource %}

                <div class="col-md-4">
                    <div class="card shadow-sm h-100 d-flex flex-column">

                        <!-- Image -->
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:150px;">
                            {% if resource.imagePath %}
                                <img src="{{ asset(resource.imagePath) }}" 
                                     alt="{{ resource.resourceName }}" 
                                     class="img-fluid h-100 w-100"
                                     style="object-fit: cover;">
                            {% else %}
                                <span class="text-muted">No Image</span>
                            {% endif %}
                        </div>

                        <!-- Card Body -->
                        <div class="card-body flex-grow-1">
                            <div class="view-mode">
                                <h5 class="card-title">{{ resource.resourceName }} ({{ resource.resourceCode }})</h5>
                                <p class="mb-1"><strong>Type:</strong> {{ resource.resourceType }}</p>
                                <p class="mb-1"><strong>Quantity:</strong> {{ assignment.quantity }}</p>
                                <p class="mb-1">
                                    <strong>Status:</strong>
                                    {% if assignment.status == 'ACCEPTED' %}
                                        <span class="badge bg-success">Accepted</span>
                                    {% elseif assignment.status == 'DECLINED' %}
                                        <span class="badge bg-danger">Declined</span>
                                    {% else %}
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    {% endif %}
                                </p>
                                <p class="mb-1"><strong>Return Date:</strong> {{ assignment.returnDate ? assignment.returnDate|date('Y-m-d') : 'N/A' }}</p>
                                <p class="mb-1"><strong>Total Cost:</strong> ${{ assignment.totalCost ?: '0.00' }}</p>
                            </div>

                            {% if assignment.status in ['PENDING', 'DECLINED'] %}
                            <form class="edit-mode d-none mt-2" method="post" action="{{ path('edit_assignment', {'id': assignment.assignmentId}) }}">
                                <div class="mb-2">
                                    <label>Quantity</label>
                                    <input type="number" name="quantity" class="form-control quantity-input" min="1"
                                           value="{{ assignment.quantity }}" data-unit-price="{{ resource.unitCost }}">
                                </div>
                                <div class="mb-2">
                                    <label>Return Date</label>
                                    <input type="date" name="returnDate" class="form-control" value="{{ assignment.returnDate ? assignment.returnDate|date('Y-m-d') }}">
                                </div>
                                <div class="mb-2">
                                    <label>Total Cost:</label>
                                    <span class="total-cost-label">$ {{ assignment.totalCost ?: '0.00' }}</span>
                                </div>
                                <input type="hidden" name="_token" value="{{ csrf_token('edit' ~ assignment.assignmentId) }}">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-sm btn-success">Save</button>
                                    <button type="button" class="btn btn-sm btn-secondary cancel-edit">Cancel</button>
                                </div>
                            </form>
                            {% endif %}
                        </div>

                        <!-- Footer -->
                        {% if assignment.status in ['PENDING', 'DECLINED'] %}
                        <div class="card-footer d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary edit-toggle">
                                <i class="mdi mdi-pencil"></i>
                            </button>
                            <form method="post" action="{{ path('delete_assignment', {'id': assignment.assignmentId}) }}" onsubmit="return confirm('Are you sure you want to delete this request?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ assignment.assignmentId) }}">
                                <button class="btn btn-sm btn-outline-danger">
                                    <i class="mdi mdi-delete"></i>
                                </button>
                            </form>
                        </div>
                        {% endif %}

                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>

<script>
setTimeout(() => {
    // Toggle edit mode
    document.querySelectorAll('.edit-toggle').forEach(btn => {
        btn.addEventListener('click', function() {
            const card = btn.closest('.card');
            const view = card.querySelector('.view-mode');
            const edit = card.querySelector('.edit-mode');
            if(view && edit){
                view.classList.toggle('d-none');
                edit.classList.toggle('d-none');
                card.classList.toggle('border-primary'); // optional highlight
            }
        });
    });

    // Cancel edit
    document.querySelectorAll('.cancel-edit').forEach(btn => {
        btn.addEventListener('click', function() {
            const card = btn.closest('.card');
            const view = card.querySelector('.view-mode');
            const edit = card.querySelector('.edit-mode');
            if(view && edit){
                edit.classList.add('d-none');
                view.classList.remove('d-none');
                card.classList.remove('border-primary');
            }
        });
    });

    // Live update total cost
    document.querySelectorAll('.quantity-input').forEach(input => {
        input.addEventListener('input', function() {
            const unitPrice = parseFloat(input.dataset.unitPrice);
            const quantity = parseInt(input.value) || 0;
            const totalCostLabel = input.closest('form').querySelector('.total-cost-label');
            totalCostLabel.textContent = '$ ' + (unitPrice * quantity).toFixed(2);
        });
    });
}, 100);
</script>
{% endblock %}