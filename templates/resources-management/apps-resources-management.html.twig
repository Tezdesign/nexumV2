{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Resources Management' %}

{% block css %}
    {% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-4">
                           <a href="{{ path('apps-resources-add') }}" class="btn btn-primary mb-2">
    <i class="mdi mdi-plus-circle me-2"></i> Add New Resource
</a>
                        </div>
                        <div class="col-sm-8">
                            <div class="text-sm-end">
                                <a href="#" class="btn btn-success mb-2 me-1">Manage Requests</a>
                            </div>
                        </div></div>

                    <div class="table-responsive">
                        <table class="table table-centered table-nowrap table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Unit Cost</th>
                                    <th>Total Quantity</th>
                                    <th>Available</th>
                                    <th>Status</th>
                                    <th style="width: 82px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {# This part will be looped once we have the Controller logic #}
                                {% for resource in resources|default([]) %}
                                <tr>
                                    <td>{{ resource.resource_code }}</td>
                                    <td>{{ resource.resource_name }}</td>
                                    <td>
                                        <span class="badge {{ resource.resource_type == 'SOFTWARE' ? 'bg-info-subtle text-info' : 'bg-primary-subtle text-primary' }}">
                                            {{ resource.resource_type }}
                                        </span>
                                    </td>
                                    <td>${{ resource.unit_cost }}</td>
                                    <td>{{ resource.total_quantity }}</td>
                                    <td>{{ resource.available_quantity }}</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success">{{ resource.status }}</span>
                                    </td>
                                    <td>
                                        <a href="javascript:void(0);" class="action-icon text-danger"> <i class="mdi mdi-delete"></i></a>
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="8" class="text-center">No resources found. Please add your first resource!</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div> </div> </div> </div>
</div>
{% endblock %}

{% block script %}
    {# You can add search bar logic (DataTables) here later #}
{% endblock %}

{% block footer %}{% endblock %}