{% extends 'layouts/admin_vertical.html.twig' %}

{% set title = 'Resources Management' %}

{% block css %}
    {# Custom styles can go here #}
{% endblock %}

{% block content %}
<div class="container-fluid">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">My Resource Assignments</h4>
</div>
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">

                    {# Top Buttons #}
                    <div class="row mb-3">
                        <div class="col-sm-4">
                            <a href="{{ path('app_resource_management_new') }}" class="btn btn-primary mb-2">
                                <i class="mdi mdi-plus-circle me-2"></i> Add New Resource
                            </a>
                            <a href="{{ path('admin_active_returns') }}" class="btn btn-warning mb-2 me-1">
    Manage Returns
</a>
                        </div>
                        <div class="col-sm-8">
                            <div class="text-sm-end">
                                <a href="{{ path('manage_requests') }}" class="btn btn-success mb-2 me-1">
    Manage Requests
</a>
                            </div>
                        </div>
                    </div>

                    {# Smart Search Input #}
                    <div class="mb-3">
                        <input type="text" id="resourceSearch" class="form-control" placeholder="Type to search resources...">
                    </div>

                    <div class="table-responsive">
                        <table class="table table-centered table-nowrap table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Code</th>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Unit Cost</th>
                                    <th>Total Qty</th>
                                    <th>Available</th>
                                    <th>Status</th>
                                    <th style="width: 140px;">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for resource in resources %}
                                    <tr>
                                        <td><span class="fw-bold">{{ resource.resourceCode }}</span></td>
                                        <td>{{ resource.resourceName }}</td>
                                        <td>
                                            <span class="badge {{ resource.resourceType == 'SOFTWARE' ? 'bg-info-subtle text-info' : 'bg-primary-subtle text-primary' }}">
                                                {{ resource.resourceType }}
                                            </span>
                                        </td>
                                        <td>{{ resource.unitCost }} TND</td>
                                        <td>{{ resource.totalQuantity }}</td>
                                        <td>{{ resource.availableQuantity }}</td>
                                        <td>
                                            <span class="badge {{ resource.status == 'AVAILABLE' ? 'bg-success-subtle text-success' : 'bg-warning-subtle text-warning' }}">
                                                {{ resource.status|default('N/A') }}
                                            </span>
                                        </td>
                                        <td class="d-flex gap-2">
                                            <!-- Edit Button -->
                                            <a href="{{ path('app_resources_management_resource_edit', {'resource_id': resource.resourceId}) }}"
                                               class="btn btn-sm btn-primary">
                                                <i class="mdi mdi-pencil"></i> Edit
                                            </a>

                                            <!-- Delete Button -->
                                            <form method="post"
                                                  action="{{ path('app_resources_management_resource_delete', {'resource_id': resource.resourceId}) }}"
                                                  onsubmit="return confirm('Are you sure you want to delete this resource?');">

                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ resource.resourceId) }}">
                                                <button class="btn btn-sm btn-danger">
                                                    <i class="mdi mdi-delete"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8" class="text-center">No resources found in the database.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                </div> 
            </div> 
        </div> 
    </div>
</div>
{% endblock %}

{% block script %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('resourceSearch');
    const table = document.querySelector('table tbody');
    const rows = table.querySelectorAll('tr');

    searchInput.addEventListener('keyup', function () {
        const query = this.value.toLowerCase();

        rows.forEach(row => {
            // Skip rows that are "No resources found"
            if (row.children.length < 8) return;

            const code = row.children[0].textContent.toLowerCase();
            const name = row.children[1].textContent.toLowerCase();
            const type = row.children[2].textContent.toLowerCase();

            // Show row if any column starts with query
            if (code.startsWith(query) || name.startsWith(query) || type.startsWith(query)) {
                row.style.display = '';
            } else {
                row.style.display = 'none';
            }
        });
    });
});
</script>
{% endblock %}

{% block footer %}{% endblock %}