<!DOCTYPE html>
<html>

<head>
    {{ include('partials/title-meta.html.twig') }}
    {% block css %}{% endblock %}
    {{ include('partials/head-css.html.twig') }}
</head>

<body class="auth-body-bg">

<div class="auth-page-wrapper">
    
    <div class="auth-page-content">
        <div class="container">
            {% block auth_header %}
            <div class="row">
                <div class="col-lg-12">
                    <div class="text-center mt-sm-5 mb-4 text-white-50">
                        <div>
                            <a href="/" class="d-inline-block auth-logo">
                                <img src="assets/images/logo-light.png" alt="" height="20">
                            </a>
                        </div>
                        <p class="mt-3 fs-15 fw-medium">Premium Admin & Dashboard Template</p>
                    </div>
                </div>
            </div>
            {% endblock %}

            {% block content %}{% endblock %}
            
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="text-center">
                        <p class="mb-0 text-muted">&copy; <script>document.write(new Date().getFullYear())</script> Nexum. Crafted with <i class="mdi mdi-heart text-danger"></i> by Nexum Team</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

</div>

{{ include('partials/footer-scripts.html.twig') }}

{% block script %}{% endblock %}

</body>

</html>
