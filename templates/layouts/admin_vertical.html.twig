<!DOCTYPE html>
<html data-topbar-color="{{ topbar_color|default('light') }}" data-menu-color="{{ menu_color|default('light') }}">

<head>
    {{ include('partials/title-meta.html.twig') }}
    {{ include('partials/head-css.html.twig') }}
    {% block css %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@mdi/font@7.4.47/css/materialdesignicons.min.css">
</head>

<body>

<div class="wrapper">

    {{ include('partials/topbar.html.twig', { is_admin_layout: true }) }}
    {{ include('partials/sidenav.html.twig', { is_admin_layout: true }) }}

    <div class="page-content">

        <div class="page-container">

            {% block content %}{% endblock %}

        </div>

        {% block footer %}
        {{ include('partials/footer.html.twig') }}
        {% endblock %}

    </div>
</div>

{{ include('partials/customizer.html.twig') }}
{{ include('partials/footer-scripts.html.twig') }}

{% block script %}<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>{% endblock %}

</body>

</html>
