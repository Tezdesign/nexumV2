<!DOCTYPE html>
<html data-topbar-color="{{ topbar_color|default('brand') }}" data-menu-color="{{ menu_color|default('light') }}">

<head>
    {{ include('partials/title-meta.html.twig') }}
    {{ include('partials/head-css.html.twig') }}
    {% block css %}{% endblock %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
</head>

<body>

<div class="wrapper">

    {{ include('partials/topbar.html.twig', { is_admin_layout: true }) }}
    {{ include('partials/sidenav.html.twig', { is_admin_layout: true }) }}

    <div class="page-content">

        <div class="page-container">

            {% block content %}{% endblock %}

        </div>

        {% block footer %}
        {{ include('partials/footer.html.twig') }}
        {% endblock %}

    </div>
</div>

{{ include('partials/customizer.html.twig') }}
{{ include('partials/footer-scripts.html.twig') }}

{% block script %}{% endblock %}

</body>

</html>
