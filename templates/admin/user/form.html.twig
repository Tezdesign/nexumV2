{% extends 'layouts/admin_vertical.html.twig' %}

{% set title = mode == 'create' ? 'New user' : 'Edit user' %}

{% block css %}
<link href="{{ asset('css/nexum-pages-polish.css') }}" rel="stylesheet">
{% endblock %}

{% block content %}

<div class="row mb-3">
    <div class="col-12">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div>
                    <h4 class="header-title mb-0">{{ title }}</h4>
                    <p class="text-muted fs-13 mb-0">
                        {% if mode == 'create' %}
                            Add a row in <code>utilisateurs</code>. New users should use status <strong>active</strong> to log in.
                        {% else %}
                            Editing #{{ user.id }} — leave password empty to keep the current one.
                        {% endif %}
                    </p>
                </div>
                <a href="{{ path('admin_users_index') }}" class="btn btn-soft-secondary btn-sm">
                    <i class="ri-arrow-left-line me-1"></i> Back to list
                </a>
            </div>
            <div class="card-body">
                {% include 'admin/user/_form_inner.html.twig' with { mode: mode, user: user, modal: false } %}
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block script %}
<script src="{{ asset('js/nexum-validation.js') }}"></script>
<script>
(function () {
    var form = document.getElementById('admin-user-form');
    if (!form || !window.NexumValidate) return;
    var isCreate = {{ mode == 'create' ? 'true' : 'false' }};
    form.addEventListener('submit', function (e) {
        if (NexumValidate.adminUserForm(form, isCreate).length) e.preventDefault();
    });
})();
</script>
{% endblock %}
