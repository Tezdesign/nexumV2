{% extends 'layouts/admin_vertical.html.twig' %}

{% macro sort_link(label, column, current_sort, current_dir) %}
    {% set next_dir = current_sort == column ? (current_dir == 'ASC' ? 'DESC' : 'ASC') : 'ASC' %}
    <a href="{{ path('admin_reclamations_index', {sort: column, dir: next_dir}) }}" class="nexum-sort-link text-body fw-semibold text-decoration-none d-inline-flex align-items-center gap-1">
        {{ label }}
        {% if current_sort == column %}
            <i class="ri-arrow-{{ current_dir == 'ASC' ? 'up' : 'down' }}-s-line text-primary"></i>
        {% else %}
            <i class="ri-expand-up-down-line text-muted opacity-50 fs-14"></i>
        {% endif %}
    </a>
{% endmacro %}

{% import _self as rm %}

{% set title = 'Reclamations' %}

{% block css %}
<link href="{{ asset('css/nexum-pages-polish.css') }}" rel="stylesheet">
<style>
    tr.admin-rec-row--has-file { cursor: pointer; }
    .nexum-page-ambient .table-hover tbody tr { transition: background-color 0.2s ease; }
</style>
{% endblock %}

{% block content %}

<div class="nexum-page-ambient">

<div class="row mb-3">
    <div class="col-12">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>
</div>

<div class="row g-4 mb-4 nexum-stagger">
    <div class="col-xl-3 col-lg-6 nexum-reveal-item">
        <div class="card border-0 shadow-sm h-100 nexum-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted fw-medium mb-1 fs-13">Total</p>
                        <h3 class="mb-0 fw-semibold">{{ stats.total }}</h3>
                    </div>
                    <div class="avatar-md bg-primary-subtle text-primary rounded">
                        <i class="ri-file-list-3-line fs-22"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 nexum-reveal-item">
        <div class="card border-0 shadow-sm h-100 nexum-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted fw-medium mb-1 fs-13">Awaiting</p>
                        <h3 class="mb-0 fw-semibold text-warning">{{ stats.pending }}</h3>
                    </div>
                    <div class="avatar-md bg-warning-subtle text-warning rounded">
                        <i class="ri-time-line fs-22"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 nexum-reveal-item">
        <div class="card border-0 shadow-sm h-100 nexum-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted fw-medium mb-1 fs-13">In progress</p>
                        <h3 class="mb-0 fw-semibold text-info">{{ stats.in_progress }}</h3>
                    </div>
                    <div class="avatar-md bg-info-subtle text-info rounded">
                        <i class="ri-loader-4-line fs-22"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-6 nexum-reveal-item">
        <div class="card border-0 shadow-sm h-100 nexum-stat-card">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted fw-medium mb-1 fs-13">Resolved</p>
                        <h3 class="mb-0 fw-semibold text-success">{{ stats.resolved }}</h3>
                    </div>
                    <div class="avatar-md bg-success-subtle text-success rounded">
                        <i class="ri-checkbox-circle-line fs-22"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row nexum-reveal">
    <div class="col-12">
        <div class="card border-0 shadow-sm nexum-card-static">
            <div class="card-header border-bottom border-dashed nexum-admin-toolbar">
                <div class="d-flex flex-column flex-lg-row flex-wrap align-items-lg-center justify-content-lg-between gap-3">
                    <div>
                        <h4 class="header-title mb-0">All reclamations</h4>
                        <p class="text-muted fs-13 mb-0">Search in real time. Click headers to sort. <strong>Double-click</strong> a row that has an attachment to open the file (new tab).</p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 w-100 w-lg-auto">
                        <div class="input-group input-group-sm flex-grow-1" style="max-width: 420px;">
                            <span class="input-group-text bg-light border-end-0"><i class="ri-search-line"></i></span>
                            <input type="search" id="adminRecSearch" class="form-control border-start-0"
                                   placeholder="Filter by title, category, user, status..."
                                   autocomplete="off"
                                   aria-label="Filter reclamations">
                        </div>
                        <a href="{{ path('admin_reclamations_export_pdf', {sort: sort, dir: dir}) }}" class="btn btn-sm flex-shrink-0 nexum-btn-ghost-purple">
                            <i class="ri-file-pdf-line me-1"></i> Export PDF
                        </a>
                        <button type="button" class="btn btn-sm flex-shrink-0 nexum-btn-gradient" id="adminRecBtnNew" data-bs-toggle="modal" data-bs-target="#adminRecModal" data-fragment-url="{{ path('admin_reclamations_new') }}?fragment=1">
                            <i class="ri-add-line me-1"></i> New reclamation
                        </button>
                    </div>
                </div>
                <p class="text-muted fs-13 mb-0 mt-2">
                    Showing <strong id="adminRecVisibleCount">{{ reclamations|length }}</strong> of <strong>{{ reclamations|length }}</strong>
                    &middot; Sort: <strong>{{ sort }}</strong> {{ dir }}
                </p>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-centered mb-0" id="adminRecTable">
                        <thead class="table-light">
                            <tr>
                                <th>{{ rm.sort_link('Title', 'titre', sort, dir) }}</th>
                                <th>{{ rm.sort_link('Category', 'categorie', sort, dir) }}</th>
                                <th>{{ rm.sort_link('Project / details', 'projet', sort, dir) }}</th>
                                <th>User</th>
                                <th>{{ rm.sort_link('Status', 'statut', sort, dir) }}</th>
                                <th>{{ rm.sort_link('Date', 'date', sort, dir) }}</th>
                                <th class="text-center">File</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for r in reclamations %}
                            {% set uname = (r.user_prenom|default('') ~ ' ' ~ r.user_nom|default(''))|trim %}
                            {% set search_blob = (r.titre ~ ' ' ~ (r.categorie|default('')) ~ ' ' ~ (r.projet|default('')) ~ ' ' ~ (r.statut|default('')) ~ ' ' ~ (r.date|default('')) ~ ' ' ~ uname ~ ' ' ~ (r.user_email|default('')))|lower %}
                            <tr class="admin-rec-row{{ r.has_fichier ? ' admin-rec-row--has-file' : '' }}"
                                data-search="{{ search_blob|e('html_attr') }}"
                                data-has-file="{{ r.has_fichier ? '1' : '0' }}"
                                data-file-url="{{ r.has_fichier ? path('admin_reclamations_fichier', {id: r.idRec}) : '' }}"
                                {% if r.has_fichier %}title="Double-click to open attachment"{% endif %}>
                                <td class="fw-medium">{{ r.titre }}</td>
                                <td>{{ r.categorie ?? '—' }}</td>
                                <td class="text-truncate" style="max-width: 200px;" title="{{ r.projet|default('') }}">{{ r.projet ?? '—' }}</td>
                                <td>
                                    {% if uname != '' %}
                                        <span class="d-block fw-medium">{{ r.user_prenom }} {{ r.user_nom }}</span>
                                        <span class="fs-12 text-muted">{{ r.user_email|default('') }}</span>
                                    {% else %}
                                        <span class="text-muted">Unknown user</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% set st = (r.statut|default(''))|lower %}
                                    <span class="badge {{ st in ['resolved','traité','traite','closed','fermé','ferme'] ? 'bg-success-subtle text-success' : (st in ['in_progress','en_cours','processing'] ? 'bg-info-subtle text-info' : 'bg-warning-subtle text-warning') }}">
                                        {{ r.statut ?? 'pending' }}
                                    </span>
                                </td>
                                <td class="text-nowrap">{{ r.date ?? '—' }}</td>
                                <td class="text-center text-nowrap">
                                    {% if r.has_fichier %}
                                        <a href="{{ path('admin_reclamations_fichier', {id: r.idRec}) }}" target="_blank" rel="noopener" class="btn btn-sm btn-soft-primary" title="Open attachment" onclick="event.stopPropagation();"><i class="ri-attachment-2"></i></a>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td class="text-end text-nowrap" onclick="event.stopPropagation();">
                                    <a href="{{ path('admin_reclamations_history', {id: r.idRec}) }}" class="btn btn-sm btn-soft-info" title="View History">
                                        <i class="ri-history-line"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-soft-primary btn-admin-rec-edit" title="Edit" data-bs-toggle="modal" data-bs-target="#adminRecModal" data-fragment-url="{{ path('admin_reclamations_edit', {id: r.idRec}) }}?fragment=1">
                                        <i class="ri-pencil-line"></i>
                                    </button>
                                    <form method="post" action="{{ path('admin_reclamations_delete', {id: r.idRec}) }}" class="d-inline" onsubmit="return confirm('Delete this reclamation?');">
                                        <button type="submit" class="btn btn-sm btn-soft-danger" title="Delete">
                                            <i class="ri-delete-bin-line"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="8" class="text-center text-muted py-5">No reclamations yet.</td>
                            </tr>
                            {% endfor %}
                            <tr id="adminRecFilterEmpty" class="d-none">
                                <td colspan="8" class="text-center text-muted py-4">No rows match your filter.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="admin-rec-charts-data">{{ charts_json|raw }}</script>

<div class="row g-3 mb-2 mt-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 nexum-chart-card">
            <div class="card-header bg-transparent border-bottom border-dashed py-3">
                <h5 class="header-title mb-0">By status</h5>
                <p class="text-muted fs-13 mb-0">All tickets in the system</p>
            </div>
            <div class="card-body" style="min-height: 120px;">
                <canvas id="adminRecChartStatuts" aria-label="Reclamations by status" style="height:120px;max-height:120px;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 nexum-chart-card">
            <div class="card-header bg-transparent border-bottom border-dashed py-3">
                <h5 class="header-title mb-0">By category</h5>
                <p class="text-muted fs-13 mb-0">Where issues cluster</p>
            </div>
            <div class="card-body" style="min-height: 120px;">
                <canvas id="adminRecChartCategories" aria-label="Reclamations by category" style="height:120px;max-height:120px;"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="modal fade nexum-modal" id="adminRecModal" tabindex="-1" aria-labelledby="adminRecModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header border-bottom border-dashed">
                <h5 class="modal-title" id="adminRecModalTitle">Reclamation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="adminRecModalBody">
                <p class="text-center text-muted py-4 mb-0" id="adminRecModalPlaceholder">Loading…</p>
            </div>
        </div>
    </div>
</div>

</div>

{% endblock %}

{% block script %}
<script src="{{ asset('js/nexum-validation.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js" crossorigin="anonymous"></script>
<script>
(function () {
    var palette = ['#5b69bc', '#10c469', '#ff8acc', '#35b8e0', '#f9c851', '#ff5b5b', '#188ae2', '#8e44ad'];

    var dataEl = document.getElementById('admin-rec-charts-data');
    if (dataEl && typeof Chart !== 'undefined') {
        try {
            var cfg = JSON.parse(dataEl.textContent || '{}');
            var common = {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, font: { size: 12 }, padding: 10 }
                    }
                }
            };
            if (cfg.statuts && document.getElementById('adminRecChartStatuts')) {
                new Chart(document.getElementById('adminRecChartStatuts'), {
                    type: 'doughnut',
                    data: {
                        labels: cfg.statuts.labels,
                        datasets: [{
                            data: cfg.statuts.values,
                            backgroundColor: palette.slice(0, cfg.statuts.labels.length),
                            borderWidth: 0
                        }]
                    },
                    options: common
                });
            }
            if (cfg.categories && document.getElementById('adminRecChartCategories')) {
                new Chart(document.getElementById('adminRecChartCategories'), {
                    type: 'bar',
                    data: {
                        labels: cfg.categories.labels,
                        datasets: [{
                            label: 'Count',
                            data: cfg.categories.values,
                            backgroundColor: palette.slice(0, cfg.categories.labels.length),
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0, font: { size: 11 } } },
                            x: { ticks: { font: { size: 11 } }, grid: { display: false } }
                        }
                    }
                });
            }
        } catch (e) { console.warn('Admin reclamation charts:', e); }
    }

    var input = document.getElementById('adminRecSearch');
    var tbody = document.querySelector('#adminRecTable tbody');
    var countEl = document.getElementById('adminRecVisibleCount');
    var emptyRow = document.getElementById('adminRecFilterEmpty');
    if (!input || !tbody) return;

    var rows = tbody.querySelectorAll('tr.admin-rec-row');
    var total = rows.length;
    var debounce;

    rows.forEach(function (tr) {
        tr.addEventListener('dblclick', function () {
            if (tr.getAttribute('data-has-file') !== '1') return;
            var url = tr.getAttribute('data-file-url');
            if (url) window.open(url, '_blank', 'noopener');
        });
    });

    function applyFilter() {
        var q = input.value.toLowerCase().trim();
        var n = 0;
        rows.forEach(function (tr) {
            var hay = tr.getAttribute('data-search') || '';
            var show = !q || hay.indexOf(q) !== -1;
            tr.classList.toggle('d-none', !show);
            if (show) n++;
        });
        if (countEl) countEl.textContent = String(n);
        if (emptyRow) {
            var showEmpty = q.length > 0 && n === 0 && total > 0;
            emptyRow.classList.toggle('d-none', !showEmpty);
        }
    }

    input.addEventListener('input', function () {
        clearTimeout(debounce);
        debounce = setTimeout(applyFilter, 80);
    });
    applyFilter();
})();

(function () {
    var modalEl = document.getElementById('adminRecModal');
    var bodyEl = document.getElementById('adminRecModalBody');
    var titleEl = document.getElementById('adminRecModalTitle');
    if (!modalEl || !bodyEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) return;

    function loadingHtml() {
        return '<p class="text-center text-muted py-4 mb-0">Loading…</p>';
    }

    function bindRecModalForm(container) {
        var form = container.querySelector('#admin-reclamation-form');
        if (!form || !window.NexumValidate) return;
        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (NexumValidate.adminReclamationForm(form).length) return;
            var submitBtn = form.querySelector('[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;
            var fd = new FormData(form);
            fetch(form.getAttribute('action'), {
                method: 'POST',
                body: fd,
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            }).then(function (res) {
                var ct = (res.headers.get('Content-Type') || '').toLowerCase();
                if (ct.indexOf('application/json') !== -1) {
                    return res.json().then(function (data) {
                        if (data && data.redirect) window.location.href = data.redirect;
                    });
                }
                return res.text().then(function (html) {
                    bodyEl.innerHTML = html;
                    bindRecModalForm(bodyEl);
                });
            }).catch(function () {
                bodyEl.innerHTML = '<div class="alert alert-danger mb-0">Network error. Please try again.</div>';
            }).finally(function () {
                if (submitBtn) submitBtn.disabled = false;
            });
        });
    }

    function loadFragment(url, title) {
        if (titleEl) titleEl.textContent = title;
        bodyEl.innerHTML = loadingHtml();
        fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (res) {
                if (!res.ok) throw new Error('load');
                return res.text();
            })
            .then(function (html) {
                bodyEl.innerHTML = html;
                bindRecModalForm(bodyEl);
            })
            .catch(function () {
                bodyEl.innerHTML = '<div class="alert alert-danger mb-0">Could not load the form.</div>';
            });
    }

    document.getElementById('adminRecBtnNew') && document.getElementById('adminRecBtnNew').addEventListener('click', function () {
        var u = this.getAttribute('data-fragment-url');
        if (u) loadFragment(u, 'New reclamation');
    });

    document.querySelectorAll('.btn-admin-rec-edit').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var u = this.getAttribute('data-fragment-url');
            if (u) loadFragment(u, 'Edit reclamation');
        });
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
        bodyEl.innerHTML = loadingHtml();
    });
})();
</script>
{% endblock %}
