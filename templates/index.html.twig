{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Dashboard' %}

{% block css %}
    <style>
        :root {
            --nexum-violet-50: #f5f3ff;
            --nexum-violet-100: #ede9fe;
            --nexum-violet-500: #8b5cf6;
            --nexum-violet-600: #7c3aed;
            --nexum-violet-700: #6d28d9;
        }

        .nexum-dashboard {
            padding-bottom: 8px;
        }

        .nexum-hero {
            background:
                radial-gradient(circle at top right, rgba(124, 58, 237, 0.12), transparent 30%),
                linear-gradient(135deg, rgba(124, 58, 237, 0.04), rgba(24, 138, 226, 0.02));
            border: 1px solid rgba(124, 58, 237, 0.08);
            border-radius: 24px;
            padding: 24px 28px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.04);
        }

        .nexum-title {
            margin-bottom: 4px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .nexum-subtitle {
            color: #64748b;
            margin-bottom: 0;
        }

        .nexum-btn-primary {
            background: var(--nexum-violet-600) !important;
            border-color: var(--nexum-violet-600) !important;
            box-shadow: 0 10px 20px rgba(124, 58, 237, 0.2);
        }

        .nexum-btn-primary:hover {
            background: var(--nexum-violet-700) !important;
            border-color: var(--nexum-violet-700) !important;
        }

        .btn.btn-primary {
            background: var(--nexum-violet-600) !important;
            border-color: var(--nexum-violet-600) !important;
        }

        .btn.btn-primary:hover {
            background: var(--nexum-violet-700) !important;
            border-color: var(--nexum-violet-700) !important;
        }

        .nexum-metric-card,
        .nexum-panel {
            border-radius: 20px;
            border: 1px solid #edf2f7;
            box-shadow: 0 18px 36px rgba(15, 23, 42, 0.06);
        }

        .nexum-metric-card.is-danger {
            border-color: #fecaca;
        }

        .nexum-metric-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nexum-metric-value {
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            font-weight: 900;
            letter-spacing: -0.04em;
            line-height: 1;
        }

        .nexum-muted-label {
            color: #64748b;
            font-weight: 600;
        }

        .nexum-project-card {
            border-radius: 22px;
        }

        .nexum-project-row + .nexum-project-row {
            border-top: 1px solid #eef2f7;
        }

        .nexum-progress {
            height: 6px;
            border-radius: 999px;
        }

        .nexum-progress .progress-bar {
            border-radius: 999px;
            background: linear-gradient(90deg, var(--nexum-violet-600), var(--nexum-violet-500));
        }

        .nexum-avatars {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
        }

        .nexum-avatar {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            border: 2px solid #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #f1f5f9;
            color: #0f172a;
            font-size: 12px;
            font-weight: 700;
            line-height: 1;
            margin-left: -8px;
            flex: 0 0 auto;
        }

        .nexum-avatar:first-child {
            margin-left: 0;
        }

        .nexum-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .nexum-avatar--add {
            background: #fff;
            color: #64748b;
            border: 1px solid #e2e8f0;
            width: 30px;
            height: 30px;
        }

        .nexum-modal .modal-content {
            border-radius: 16px;
            border: 1px solid #eef2f7;
        }

        .nexum-modal .modal-header {
            border-bottom: 1px solid #f1f5f9;
        }

        .nexum-modal .modal-footer {
            border-top: 1px solid #f1f5f9;
        }

        .nexum-assignee-btn {
            border-radius: 12px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 0 12px;
        }

        .nexum-assignee-left {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .nexum-assignee-name {
            font-weight: 700;
            font-size: 13px;
            color: #0f172a;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 320px;
        }

        .nexum-assignee-role {
            font-size: 12px;
            color: #64748b;
            white-space: nowrap;
        }

        .nexum-assignee-avatar {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            font-weight: 800;
            font-size: 12px;
            flex: 0 0 auto;
        }

        .nexum-assignee-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .nexum-assignee-menu {
            width: 100%;
            border-radius: 14px;
            border: 1px solid #eef2f7;
            padding: 10px;
        }

        .nexum-assignee-item {
            border-radius: 12px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .nexum-assignee-item:hover {
            background: #f8fafc;
        }

        .nexum-assignee-item .meta {
            min-width: 0;
        }

        .nexum-assignee-item .meta .name {
            font-weight: 700;
            font-size: 13px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .nexum-assignee-item .meta .role {
            font-size: 12px;
            color: #64748b;
            margin-top: 2px;
            text-transform: capitalize;
        }

        .nexum-assignee-check {
            width: 18px;
            height: 18px;
            border-radius: 999px;
            border: 2px solid #cbd5e1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            flex: 0 0 auto;
        }

        .nexum-task-card {
            border-radius: 22px;
        }

        .nexum-task-list {
            display: flex;
            flex-direction: column;
        }

        .nexum-task-item {
            padding: 14px 0;
        }

        .nexum-task-item + .nexum-task-item {
            border-top: 1px solid #eef2f7;
        }

        .nexum-task-actions {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            flex: 0 0 auto;
        }

        .nexum-task-actions form {
            margin: 0;
        }

        .nexum-task-action {
            width: 28px;
            height: 28px;
            border-radius: 999px;
            border: 1px solid #e2e8f0;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #94a3b8;
            padding: 0;
            line-height: 1;
        }

        .nexum-task-action.is-done {
            background: #10b981;
            border-color: #10b981;
            color: #fff;
        }

        .nexum-task-action.is-progress {
            background: #ffedd5;
            border-color: #fed7aa;
            color: #c2410c;
        }

        .nexum-task-action.is-disabled {
            opacity: 0.75;
            pointer-events: none;
        }

        .nexum-priority {
            font-size: 11px;
            font-weight: 900;
            border-radius: 999px;
            padding: 4px 10px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: .04em;
        }

        .nexum-priority.high {
            background: #ffe4e6;
            color: #be123c;
            border-color: #fecdd3;
        }

        .nexum-priority.medium {
            background: #fef3c7;
            color: #b45309;
            border-color: #fde68a;
        }

        .nexum-priority.low {
            background: #dbeafe;
            color: #1d4ed8;
            border-color: #bfdbfe;
        }

        .nexum-status {
            font-size: 11px;
            font-weight: 900;
            border-radius: 999px;
            padding: 4px 10px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            letter-spacing: .01em;
        }

        .nexum-status.todo {
            background: #f1f5f9;
            color: #64748b;
            border-color: #e2e8f0;
        }

        .nexum-status.in_progress {
            background: #ffedd5;
            color: #c2410c;
            border-color: #fed7aa;
        }

        .nexum-status.done {
            background: #dcfce7;
            color: #15803d;
            border-color: #bbf7d0;
        }

        .nexum-task-title {
            font-weight: 700;
            color: #1c1917;
            text-decoration: none;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 520px;
            display: inline-block;
        }

        .nexum-task-title:hover {
            text-decoration: underline;
        }

        .nexum-meta {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            color: #64748b;
            font-size: 12px;
            white-space: nowrap;
        }

        .nexum-badge {
            font-size: 11px;
            font-weight: 900;
            border-radius: 999px;
            padding: 4px 10px;
            border: 1px solid transparent;
            display: inline-flex;
            align-items: center;
            letter-spacing: .01em;
        }

        .nexum-empty {
            border: 1px dashed #dbe4f0;
            border-radius: 18px;
            background: #fbfdff;
            color: #64748b;
            padding: 24px;
            text-align: center;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="nexum-dashboard">
        <div class="nexum-hero mb-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <p class="nexum-subtitle mb-1">Welcome back, {{ welcomeName|plain_text }}</p>
                    <h2 class="nexum-title">Here's what's happening with your projects today.</h2>
                    <p class="nexum-subtitle">Track project progress, deadlines, and your latest work in one place.</p>
                </div>

                {% if isManager|default(false) %}
                    <button type="button" class="btn btn-primary nexum-btn-primary text-white rounded-pill px-3 d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createProjectModal">
                        <i class="ti ti-plus me-1"></i>
                        New Project
                    </button>
                {% endif %}
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-3 mb-4">
            {% for metric in metrics|default([]) %}
                <div class="col">
                    <div class="card h-100 nexum-metric-card {{ metric.danger ? 'is-danger' : '' }}">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div>
                                    <div class="nexum-metric-icon mb-3 text-{{ metric.tone }} bg-{{ metric.tone }}-subtle">
                                        <i class="{{ metric.icon }}"></i>
                                    </div>
                                    <div class="nexum-metric-value">{{ metric.value }}</div>
                                    <div class="nexum-muted-label mt-2">{{ metric.label }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="row g-3">
            <div class="col-xxl-8">
                <div class="card nexum-panel nexum-project-card h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="header-title mb-1">Recent Projects</h4>
                            <p class="text-muted mb-0">Track active projects and progress</p>
                        </div>
                        <span class="badge bg-light text-muted border rounded-pill">
                            {{ projectCount|default(0) }} total
                        </span>
                    </div>

                    <div class="card-body px-4 pb-4 pt-3">
                        {% if projectCards|default([]) is not empty %}
                            <div class="d-grid gap-3">
                                {% for project in projectCards %}
                                    {% set memberIds = project.memberIds|default([]) %}
                                    {% set shownMemberIds = memberIds|slice(0, 4) %}
                                    {% set extraMembers = memberIds|length > 4 ? (memberIds|length - 4) : 0 %}
                                    <a href="{{ project.url }}" class="text-decoration-none text-reset">
                                        <div class="nexum-project-row p-3 rounded-4 border border-light-subtle bg-white">
                                            <div class="d-flex align-items-start justify-content-between gap-3">
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                                        <h5 class="mb-0 text-capitalize text-truncate">{{ project.name|plain_text }}</h5>
                                                        <span class="text-muted fw-semibold">{{ project.progress }}%</span>
                                                    </div>

                                                    <div class="progress nexum-progress mt-2 mb-2">
                                                        <div class="progress-bar" role="progressbar"
                                                             style="width: {{ project.progress }}%;"
                                                             aria-valuenow="{{ project.progress }}"
                                                             aria-valuemin="0"
                                                             aria-valuemax="100"></div>
                                                    </div>

                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                                                        <div class="nexum-avatars">
                                                            {% for uid in shownMemberIds %}
                                                                {% set user = usersById[uid] ?? null %}
                                                                {% if user %}
                                                                    {% set fullName = (user.prenom ~ ' ' ~ user.nom)|trim %}
                                                                    {% set avatarUrl = avatarUrlById[user.id] ?? null %}
                                                                    {% if avatarUrl %}
                                                                        <span class="nexum-avatar" title="{{ fullName }}">
                                                                            <img src="{{ avatarUrl }}" alt="{{ fullName }}">
                                                                        </span>
                                                                    {% else %}
                                                                        {% set ap = avatar_placeholder(fullName) %}
                                                                        <span class="nexum-avatar" title="{{ fullName }}" style="background: {{ ap.bg }}; color: {{ ap.fg }};">
                                                                            {{ ap.initial }}
                                                                        </span>
                                                                    {% endif %}
                                                                {% endif %}
                                                            {% endfor %}

                                                            {% if extraMembers > 0 %}
                                                                <span class="nexum-avatar nexum-avatar--add" title="+{{ extraMembers }} more">+{{ extraMembers }}</span>
                                                            {% endif %}
                                                        </div>

                                                        <div class="text-muted small d-flex flex-wrap align-items-center gap-3">
                                                            <span class="d-inline-flex align-items-center gap-1">
                                                                <i class="ti ti-clock"></i>
                                                                <span>Start {{ project.startLabel }}</span>
                                                            </span>
                                                            <span class="d-inline-flex align-items-center gap-1">
                                                                <i class="ti ti-calendar"></i>
                                                                <span>End {{ project.endLabel }}</span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="nexum-empty">
                                No projects available for this account yet.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-xxl-4">
                <div class="card nexum-panel nexum-task-card h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="header-title mb-1">Your Tasks</h4>
                        </div>

                        {% if canCreateTask|default(false) %}
                            <button type="button"
                                    class="btn btn-light border rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                                    style="width: 34px; height: 34px;"
                                    title="Create task"
                                    aria-label="Create task"
                                    data-bs-toggle="modal"
                                    data-bs-target="#createTaskModal">
                                <i class="ti ti-plus"></i>
                            </button>
                        {% endif %}
                    </div>

                    <div class="card-body px-4 pb-4 pt-3">
                        {% if taskCards|default([]) is not empty %}
                            <div class="nexum-task-list">
                                {% for task in taskCards %}
                                    <div class="nexum-task-item d-flex align-items-center gap-3">
                                        <div class="nexum-task-actions">
                                            {% if (task.assignedTo|default(0)) == (currentUserId|default(0)) %}
                                                <form method="post" action="{{ path('app_task_status', {id: task.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('task_status' ~ task.id) }}">
                                                    <input type="hidden" name="status" value="{{ task.statusKey == 'done' ? 'todo' : 'done' }}">
                                                    <input type="hidden" name="back" value="{{ path('dashboard') }}">
                                                    <button type="submit"
                                                            class="nexum-task-action {{ task.statusKey == 'done' ? 'is-done' : '' }}"
                                                            title="{{ task.statusKey == 'done' ? 'Mark as To Do' : 'Mark as Done' }}"
                                                            aria-label="{{ task.statusKey == 'done' ? 'Mark as To Do' : 'Mark as Done' }}">
                                                        <i class="ri-check-line"></i>
                                                    </button>
                                                </form>

                                                <form method="post" action="{{ path('app_task_status', {id: task.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('task_status' ~ task.id) }}">
                                                    <input type="hidden" name="status" value="in_progress">
                                                    <input type="hidden" name="back" value="{{ path('dashboard') }}">
                                                    <button type="submit"
                                                            class="nexum-task-action {{ task.statusKey == 'in_progress' ? 'is-progress' : '' }}"
                                                            title="Mark as In Progress"
                                                            aria-label="Mark as In Progress">
                                                        <i class="ri-time-line"></i>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <span class="nexum-task-action {{ task.statusKey == 'done' ? 'is-done' : '' }} is-disabled"
                                                      title="Progress can be updated only by the assignee"
                                                      aria-hidden="true">
                                                    <i class="ri-check-line"></i>
                                                </span>
                                                <span class="nexum-task-action {{ task.statusKey == 'in_progress' ? 'is-progress' : '' }} is-disabled"
                                                      title="Progress can be updated only by the assignee"
                                                      aria-hidden="true">
                                                    <i class="ri-time-line"></i>
                                                </span>
                                            {% endif %}
                                        </div>

                                        <div class="flex-grow-1 min-w-0">
                                            <div class="d-flex align-items-center justify-content-between gap-2">
                                                <h6 class="mb-1 text-truncate">{{ task.title|plain_text }}</h6>
                                                <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
                                                    <span class="nexum-priority {{ task.priorityKey }}">{{ task.priorityLabel }}</span>
                                                    <span class="nexum-status {{ task.statusKey }}">{{ task.statusLabel }}</span>
                                                </div>
                                            </div>

                                            <div class="nexum-meta">
                                                <span class="text-truncate">{{ task.projectName|plain_text }}</span>
                                                <span class="d-inline-flex align-items-center gap-1">
                                                    <i class="ri-calendar-line"></i>
                                                    <span>{{ task.dueLabel }}</span>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="nexum-empty">
                                No tasks created by this user yet.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {% if isManager|default(false) and createProjectForm is defined and createProjectForm is not null %}
            <div class="modal fade nexum-modal" id="createProjectModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    {% include 'project/_create_modal_content.html.twig' with {
                        createForm: createProjectForm,
                        assignableUsers: assignableUsers,
                        backUrl: path('dashboard')
                    } %}
                </div>
            </div>
        {% endif %}

        {% if canCreateTask|default(false) and createTaskForm is not null %}
            <div class="modal fade nexum-modal" id="createTaskModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    {% include 'task/_create_modal_content.html.twig' with { createForm: createTaskForm, backUrl: path('dashboard') } %}
                </div>
            </div>
        {% endif %}
    </div>
{% endblock %}

{% block script %}
    <script>
        (function () {
            const projectModal = document.getElementById('createProjectModal');
            if (projectModal) {
                const getState = function () {
                    return {
                        selectEl: projectModal.querySelector('select[data-assigned-select="1"]'),
                        btnAvatars: projectModal.querySelector('[data-assignee-avatars]'),
                        btnName: projectModal.querySelector('[data-assignee-name]'),
                        btnRole: projectModal.querySelector('[data-assignee-role]'),
                        searchEl: projectModal.querySelector('[data-assignee-search]'),
                        items: Array.from(projectModal.querySelectorAll('[data-assignee-item]'))
                    };
                };

                const getSelectedIds = function () {
                    const { selectEl } = getState();
                    const ids = [];
                    if (!selectEl) return ids;
                    for (const opt of Array.from(selectEl.options)) {
                        if (opt.selected && opt.value) ids.push(opt.value);
                    }
                    return ids;
                };

                const applySelectedIds = function (ids) {
                    const { selectEl } = getState();
                    if (!selectEl) return;
                    const set = new Set((ids || []).map(String));
                    for (const opt of Array.from(selectEl.options)) {
                        opt.selected = opt.value ? set.has(String(opt.value)) : false;
                    }
                };

                const renderButton = function () {
                    const { btnAvatars, btnName, btnRole, items } = getState();
                    const ids = getSelectedIds();
                    const selectedItems = items.filter((it) => ids.includes(String(it.getAttribute('data-user-id') || '')));

                    items.forEach((it) => {
                        const id = String(it.getAttribute('data-user-id') || '');
                        it.setAttribute('data-selected', ids.includes(id) ? '1' : '0');
                    });

                    if (btnAvatars) {
                        btnAvatars.innerHTML = '';
                        selectedItems.slice(0, 3).forEach((it) => {
                            const srcAvatar = it.querySelector('.nexum-assignee-avatar');
                            if (!srcAvatar) return;
                            const span = document.createElement('span');
                            span.className = 'nexum-assignee-avatar';
                            const style = srcAvatar.getAttribute('style');
                            if (style) span.setAttribute('style', style);
                            span.innerHTML = srcAvatar.innerHTML;
                            btnAvatars.appendChild(span);
                        });
                    }

                    if (btnName) {
                        if (ids.length === 0) {
                            btnName.textContent = 'Select team members...';
                            btnName.classList.add('text-muted');
                        } else if (ids.length === 1) {
                            const one = selectedItems[0];
                            btnName.textContent = one ? (one.getAttribute('data-user-name') || 'User') : '1 selected';
                            btnName.classList.remove('text-muted');
                        } else {
                            btnName.textContent = ids.length + ' selected';
                            btnName.classList.remove('text-muted');
                        }
                    }

                    if (btnRole) {
                        btnRole.textContent = ids.length === 1 ? (selectedItems[0]?.getAttribute('data-user-role') || '') : '';
                    }
                };

                if (getState().selectEl) {
                    renderButton();
                }

                projectModal.addEventListener('click', function (e) {
                    const it = e.target.closest('[data-assignee-item]');
                    if (!it || !projectModal.contains(it)) return;
                    const userId = it.getAttribute('data-user-id');
                    if (!userId) return;

                    const ids = getSelectedIds();
                    const set = new Set(ids.map(String));
                    if (set.has(String(userId))) set.delete(String(userId)); else set.add(String(userId));
                    applySelectedIds(Array.from(set));
                    renderButton();
                });

                projectModal.addEventListener('input', function (e) {
                    const t = e.target;
                    if (!t || !t.matches || !t.matches('[data-assignee-search]')) return;
                    const q = (t.value || '').trim().toLowerCase();
                    const { items } = getState();
                    for (const it of items) {
                        const name = (it.getAttribute('data-user-name') || '').toLowerCase();
                        const role = (it.getAttribute('data-user-role') || '').toLowerCase();
                        const show = q === '' || name.includes(q) || role.includes(q);
                        it.style.display = show ? '' : 'none';
                    }
                });

                projectModal.addEventListener('submit', async function (e) {
                    const form = e.target;
                    if (!form || form.id !== 'createProjectForm') return;
                    e.preventDefault();

                    try {
                        const res = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Accept': 'application/json, text/html;q=0.9'
                            }
                        });

                        const ct = (res.headers.get('Content-Type') || '');
                        if (res.ok && ct.indexOf('application/json') !== -1) {
                            const data = await res.json();
                            if (data && data.location) {
                                window.location.href = data.location;
                            }
                            return;
                        }

                        if (res.status === 422) {
                            const html = await res.text();
                            const wrap = document.getElementById('createProjectModalContent');
                            if (wrap && html) {
                                const doc = new DOMParser().parseFromString(html, 'text/html');
                                const nextWrap = doc.getElementById('createProjectModalContent');
                                if (nextWrap) {
                                    wrap.outerHTML = nextWrap.outerHTML;
                                    renderButton();
                                } else {
                                    window.location.reload();
                                }
                            }
                            return;
                        }

                        if (res.status === 403) {
                            window.location.reload();
                            return;
                        }

                        window.location.reload();
                    } catch (err) {
                        window.location.reload();
                    }
                });
            }

            const taskModal = document.getElementById('createTaskModal');
            if (!taskModal) return;

            const assigneesEndpoint = {{ path('app_task_assignees')|json_encode|raw }};

            async function refreshAssignees(projectId) {
                const assigneeSelect = taskModal.querySelector('select[data-task-assignee="1"]');
                if (!assigneeSelect) return;
                const prev = assigneeSelect.value;
                assigneeSelect.innerHTML = '<option value="">Loading...</option>';

                const pid = parseInt(String(projectId || '0'), 10);
                if (!pid) {
                    assigneeSelect.innerHTML = '<option value="">Select team ...</option>';
                    return;
                }

                try {
                    const res = await fetch(assigneesEndpoint + '?project=' + encodeURIComponent(String(pid)), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const payload = await res.json();
                    const users = (payload && payload.users) ? payload.users : [];

                    let html = '<option value="">Select team ...</option>';
                    for (const u of users) {
                        const id = String(u.id);
                        const name = String(u.name || 'Unknown user');
                        html += '<option value="' + id.replace(/\"/g, '') + '">' + name.replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</option>';
                    }
                    assigneeSelect.innerHTML = html;

                    if (prev) {
                        assigneeSelect.value = prev;
                    }
                } catch (e) {
                    assigneeSelect.innerHTML = '<option value="">Select team ...</option>';
                }
            }

            taskModal.addEventListener('change', function (e) {
                const t = e.target;
                if (t && t.matches && t.matches('select[data-task-project="1"]')) {
                    refreshAssignees(t.value);
                }
            });

            taskModal.addEventListener('submit', async function (e) {
                const form = e.target;
                if (!form || form.id !== 'createTaskForm') return;
                e.preventDefault();
                try {
                    const res = await fetch(form.action, {
                        method: 'POST',
                        body: new FormData(form),
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json, text/html;q=0.9'
                        }
                    });
                    const ct = (res.headers.get('Content-Type') || '');
                    if (res.ok && ct.indexOf('application/json') !== -1) {
                        const data = await res.json();
                        if (data && data.location) {
                            window.location.href = data.location;
                        }
                        return;
                    }
                    if (res.status === 422) {
                        const html = await res.text();
                        const wrap = document.getElementById('createTaskModalContent');
                        if (wrap && html) {
                            const doc = new DOMParser().parseFromString(html, 'text/html');
                            const nextWrap = doc.getElementById('createTaskModalContent');
                            if (nextWrap) {
                                wrap.outerHTML = nextWrap.outerHTML;
                            } else {
                                window.location.reload();
                            }
                        }
                        return;
                    }
                    if (res.status === 403) {
                        window.location.reload();
                        return;
                    }
                    window.location.reload();
                } catch (err) {
                    window.location.reload();
                }
            });

            try {
                const url = new URL(window.location.href);
                const pid = url.searchParams.get('project');
                if (pid) {
                    refreshAssignees(pid);
                }
            } catch (e) {}

            {% if createTaskForm is defined and createTaskForm.vars.submitted and not createTaskForm.vars.valid %}
            if (window.bootstrap && bootstrap.Modal) {
                new bootstrap.Modal(taskModal).show();
            }
            {% endif %}
        })();
    </script>
{% endblock %}
