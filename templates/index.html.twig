{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Dashboard' %}

{% block css %}
    <style>
        :root {
            --nexum-violet-50: #f5f3ff;
            --nexum-violet-100: #ede9fe;
            --nexum-violet-500: #8b5cf6;
            --nexum-violet-600: #7c3aed;
            --nexum-violet-700: #6d28d9;
        }

        .nexum-dashboard {
            padding-bottom: 8px;
        }

        .nexum-hero {
            background:
                radial-gradient(circle at top right, rgba(124, 58, 237, 0.12), transparent 30%),
                linear-gradient(135deg, rgba(124, 58, 237, 0.04), rgba(24, 138, 226, 0.02));
            border: 1px solid rgba(124, 58, 237, 0.08);
            border-radius: 24px;
            padding: 24px 28px;
            box-shadow: 0 18px 40px rgba(15, 23, 42, 0.04);
        }

        .nexum-title {
            margin-bottom: 4px;
            font-weight: 800;
            letter-spacing: -0.03em;
        }

        .nexum-subtitle {
            color: #64748b;
            margin-bottom: 0;
        }

        .nexum-btn-primary {
            background: var(--nexum-violet-600) !important;
            border-color: var(--nexum-violet-600) !important;
            box-shadow: 0 10px 20px rgba(124, 58, 237, 0.2);
        }

        .nexum-btn-primary:hover {
            background: var(--nexum-violet-700) !important;
            border-color: var(--nexum-violet-700) !important;
        }

        .btn.btn-primary {
            background: var(--nexum-violet-600) !important;
            border-color: var(--nexum-violet-600) !important;
        }

        .btn.btn-primary:hover {
            background: var(--nexum-violet-700) !important;
            border-color: var(--nexum-violet-700) !important;
        }

        .nexum-metric-card,
        .nexum-panel {
            border-radius: 20px;
            border: 1px solid #edf2f7;
            box-shadow: 0 18px 36px rgba(15, 23, 42, 0.06);
        }

        .nexum-metric-card.is-danger {
            border-color: #fecaca;
        }

        .nexum-metric-icon {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

        .nexum-metric-value {
            font-size: clamp(1.5rem, 3vw, 2.1rem);
            font-weight: 900;
            letter-spacing: -0.04em;
            line-height: 1;
        }

        .nexum-muted-label {
            color: #64748b;
            font-weight: 600;
        }

        .nexum-project-card {
            border-radius: 22px;
        }

        .nexum-project-row + .nexum-project-row {
            border-top: 1px solid #eef2f7;
        }

        .nexum-progress {
            height: 8px;
            border-radius: 999px;
            background: #e2e8f0;
        }

        .nexum-progress .progress-bar {
            border-radius: 999px;
            background: linear-gradient(90deg, var(--nexum-violet-600), var(--nexum-violet-500));
        }

        .nexum-project-chip {
            width: 34px;
            height: 34px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 13px;
            flex: 0 0 auto;
        }

        .nexum-task-card {
            border-radius: 22px;
        }

        .nexum-task-list {
            display: flex;
            flex-direction: column;
        }

        .nexum-task-item {
            padding: 14px 0;
        }

        .nexum-task-item + .nexum-task-item {
            border-top: 1px solid #eef2f7;
        }

        .nexum-task-dot {
            width: 16px;
            height: 16px;
            border-radius: 999px;
            flex: 0 0 auto;
            border: 2px solid #cbd5e1;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
        }

        .nexum-task-dot.is-done {
            background: #10c469;
            border-color: #10c469;
        }

        .nexum-task-dot.is-progress {
            background: #188ae2;
            border-color: #188ae2;
        }

        .nexum-task-dot.is-todo {
            background: #fff;
            color: transparent;
        }

        .nexum-badge {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.04em;
            border-radius: 999px;
        }

        .nexum-empty {
            border: 1px dashed #dbe4f0;
            border-radius: 18px;
            background: #fbfdff;
            color: #64748b;
            padding: 24px;
            text-align: center;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="nexum-dashboard">
        <div class="nexum-hero mb-4">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                <div>
                    <p class="nexum-subtitle mb-1">Welcome back, {{ welcomeName|plain_text }}</p>
                    <h2 class="nexum-title">Here's what's happening with your projects today.</h2>
                    <p class="nexum-subtitle">Track project progress, deadlines, and your latest work in one place.</p>
                </div>

                {% if isManager|default(false) %}
                    <a href="{{ path('app_project_index') }}" class="btn btn-primary nexum-btn-primary text-white rounded-pill px-3">
                        <i class="ti ti-plus me-1"></i>
                        New Project
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-5 g-3 mb-4">
            {% for metric in metrics|default([]) %}
                <div class="col">
                    <div class="card h-100 nexum-metric-card {{ metric.danger ? 'is-danger' : '' }}">
                        <div class="card-body">
                            <div class="d-flex align-items-start justify-content-between gap-3">
                                <div>
                                    <div class="nexum-metric-icon mb-3 text-{{ metric.tone }} bg-{{ metric.tone }}-subtle">
                                        <i class="{{ metric.icon }}"></i>
                                    </div>
                                    <div class="nexum-metric-value">{{ metric.value }}</div>
                                    <div class="nexum-muted-label mt-2">{{ metric.label }}</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="row g-3">
            <div class="col-xxl-8">
                <div class="card nexum-panel nexum-project-card h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="header-title mb-1">Recent Projects</h4>
                            <p class="text-muted mb-0">Track active projects and progress</p>
                        </div>
                        <span class="badge bg-light text-muted border rounded-pill">
                            {{ projectCount|default(0) }} total
                        </span>
                    </div>

                    <div class="card-body px-4 pb-4 pt-3">
                        {% if projectCards|default([]) is not empty %}
                            <div class="d-grid gap-3">
                                {% for project in projectCards %}
                                    <a href="{{ project.url }}" class="text-decoration-none text-reset">
                                        <div class="nexum-project-row p-3 rounded-4 border border-light-subtle bg-white">
                                            <div class="d-flex align-items-start justify-content-between gap-3">
                                                <div class="flex-grow-1 min-w-0">
                                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                                        <h5 class="mb-0 text-capitalize text-truncate">{{ project.name|plain_text }}</h5>
                                                        <span class="text-muted fw-semibold">{{ project.progress }}%</span>
                                                    </div>

                                                    <div class="progress nexum-progress mt-2 mb-2">
                                                        <div class="progress-bar" role="progressbar"
                                                             style="width: {{ project.progress }}%;"
                                                             aria-valuenow="{{ project.progress }}"
                                                             aria-valuemin="0"
                                                             aria-valuemax="100"></div>
                                                    </div>

                                                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                                                        <small class="text-muted">Start {{ project.startLabel }} · End {{ project.endLabel }}</small>
                                                        <span class="nexum-project-chip bg-{{ project.accentClass }}-subtle text-{{ project.accentClass }}">
                                                            {{ project.initial }}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="nexum-empty">
                                No projects available for this account yet.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-xxl-4">
                <div class="card nexum-panel nexum-task-card h-100">
                    <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex align-items-center justify-content-between">
                        <div>
                            <h4 class="header-title mb-1">Your Tasks</h4>
                            <p class="text-muted mb-0">Tasks created by the logged user</p>
                        </div>

                        <a href="{{ path('app_task_index', { create: 1, back: path('dashboard') }) }}"
                           class="btn btn-light border rounded-circle p-0 d-inline-flex align-items-center justify-content-center"
                           style="width: 34px; height: 34px;"
                           title="Create task"
                           aria-label="Create task">
                            <i class="ti ti-plus"></i>
                        </a>
                    </div>

                    <div class="card-body px-4 pb-4 pt-3">
                        {% if taskCards|default([]) is not empty %}
                            <div class="nexum-task-list">
                                {% for task in taskCards %}
                                    <a href="{{ task.url }}" class="text-decoration-none text-reset">
                                        <div class="nexum-task-item d-flex align-items-center gap-3">
                                            <span class="nexum-task-dot {{ task.completed ? 'is-done' : (task.statusClass == 'primary' ? 'is-progress' : 'is-todo') }}">
                                                {% if task.completed %}
                                                    <i class="ti ti-check fs-12"></i>
                                                {% endif %}
                                            </span>

                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex align-items-center justify-content-between gap-2">
                                                    <h6 class="mb-1 text-truncate">{{ task.title|plain_text }}</h6>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge text-bg-{{ task.priorityClass }} nexum-badge">{{ task.priorityLabel }}</span>
                                                        <span class="badge text-bg-{{ task.statusClass }} nexum-badge">{{ task.statusLabel }}</span>
                                                    </div>
                                                </div>

                                                <div class="d-flex align-items-center justify-content-between gap-2 text-muted small">
                                                    <span class="text-truncate">{{ task.projectName|plain_text }}</span>
                                                    <span>{{ task.dueLabel }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        {% else %}
                            <div class="nexum-empty">
                                No tasks created by this user yet.
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block script %}{% endblock %}
