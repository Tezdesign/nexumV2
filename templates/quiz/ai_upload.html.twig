{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Générer un quiz IA depuis un PDF' %}

{% block content %}
<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">{{ title }}</h3>
            <div class="text-muted">Upload un PDF, puis génère un quiz localement (sans API externe, sans base).</div>
        </div>
        <a href="{{ path('app_formation_index') }}" class="btn btn-outline-secondary">
            Retour
        </a>
    </div>

    <div class="card shadow-sm rounded-4">
        <div class="card-body p-4">

            {{ form_start(form, {
                action: path('app_quiz_ai_generate'),
                method: 'POST',
                attr: { novalidate: 'novalidate' },
                multipart: true
            }) }}

            <div class="mb-3">
                {{ form_label(form.pdf) }}
                {{ form_widget(form.pdf, { attr: { class: 'form-control' } }) }}
                <div class="form-text">Formats acceptés: PDF. Taille max: 25 Mo.</div>
                {{ form_errors(form.pdf) }}
            </div>

            <div class="d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary">
                    Générer le quiz
                </button>
                <span class="text-muted small">Le traitement peut prendre quelques minutes selon le PDF.</span>
            </div>

            {{ form_end(form) }}

        </div>
    </div>

</div>
{% endblock %}

