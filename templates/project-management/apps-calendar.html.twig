{% extends 'layouts/vertical.html.twig' %}

{% set topbar_color = 'light' %}
{% set title = 'Calendar' %}

{% block css %}
    <style>
        :root {
            --nexum-accent: #7c3aed;
            --nexum-card-radius: 16px;
            --nexum-stone-50: #fafaf9;
            --nexum-stone-100: #f5f5f4;
            --nexum-stone-200: #e7e5e4;
            --nexum-stone-500: #78716c;
            --nexum-stone-900: #1c1917;
        }

        .app-topbar,
        .app-topbar .topbar-menu {
            background: #ffffff !important;
        }

        .app-topbar .page-title,
        .app-topbar .topbar-link,
        .app-topbar .topbar-search,
        .app-topbar .topbar-search span,
        .app-topbar .topbar-search i,
        .app-topbar .sidenav-toggle-button,
        .app-topbar .topnav-toggle-button {
            color: #6c757d !important;
        }

        .app-topbar .topbar-search {
            background: #eaeff3 !important;
        }

        .page-content {
            background: var(--ct-body-bg);
        }

        .page-container {
            padding-top: 1rem;
        }

        .calendar-shell {
            border-radius: var(--nexum-card-radius);
            border: 1px solid var(--nexum-stone-200);
            background: #fff;
            box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
        }

        .calendar-head {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .calendar-title {
            font-size: 26px;
            font-weight: 800;
            margin: 0;
        }

        .calendar-subtitle {
            color: var(--nexum-stone-500);
            margin-top: 4px;
        }

        .calendar-legend {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .calendar-chip {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--nexum-stone-200);
            border-radius: 999px;
            padding: 6px 12px;
            font-size: 12px;
            font-weight: 700;
            color: #334155;
            background: #fff;
        }

        .calendar-dot {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            display: inline-block;
        }

        .calendar-dot.info { background: #0ea5e9; }
        .calendar-dot.danger { background: #ef4444; }
        .calendar-dot.primary { background: #7c3aed; }
        .calendar-dot.warning { background: #f59e0b; }

        .calendar-wrap {
            padding: 16px;
        }

        #calendar {
            min-height: 720px;
        }

        .fc .fc-toolbar-title {
            font-size: 20px;
            font-weight: 800;
            color: var(--nexum-stone-900);
        }

        .fc .fc-button-primary {
            background: var(--nexum-accent);
            border-color: var(--nexum-accent);
        }

        .fc .fc-button-primary:hover,
        .fc .fc-button-primary:focus,
        .fc .fc-button-primary:not(:disabled).fc-button-active {
            background: #6d28d9;
            border-color: #6d28d9;
        }

        .fc .fc-daygrid-event,
        .fc .fc-list-event {
            cursor: pointer;
        }

        .nexum-modal .modal-content {
            border-radius: 16px;
            border: 1px solid var(--nexum-stone-200);
        }

        .nexum-modal .modal-header,
        .nexum-modal .modal-footer {
            border-color: var(--nexum-stone-200);
        }

        .nexum-modal .modal-dialog {
            max-width: 720px;
        }

        .nexum-modal .modal-title {
            font-weight: 900;
        }

        .nexum-modal .modal-footer .btn {
            border-radius: 8px;
            padding: 10px 20px;
            font-weight: 800;
            font-family: "Inter", "Segoe UI", sans-serif;
            font-size: 14px;
            cursor: pointer;
        }

        .nexum-modal .modal-footer .btn.btn-outline-secondary {
            border-color: #e2e8f0;
            color: #334155;
            background: #fff;
        }

        .nexum-btn-primary {
            background: var(--nexum-accent) !important;
            border-color: var(--nexum-accent) !important;
            box-shadow: 0 10px 18px rgba(124, 58, 237, 0.18);
        }

        .nexum-btn-primary:hover {
            background: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }

        .btn.btn-primary {
            background: var(--nexum-accent) !important;
            border-color: var(--nexum-accent) !important;
        }

        .btn.btn-primary:hover {
            background: #6d28d9 !important;
            border-color: #6d28d9 !important;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="calendar-head">
        <div>
            <h2 class="calendar-title">Calendar</h2>
            <div class="calendar-subtitle">
                {{ calendarScopeLabel }} - {{ calendarVisibleProjects }} projects, {{ calendarVisibleTasks }} tasks, public holidays for {{ calendarHolidayCountryCode }}
            </div>
        </div>

        <div class="calendar-legend">
            <span class="calendar-chip"><span class="calendar-dot info"></span> Project start</span>
            <span class="calendar-chip"><span class="calendar-dot danger"></span> Project deadline</span>
            <span class="calendar-chip"><span class="calendar-dot primary"></span> Task deadline</span>
            <span class="calendar-chip"><span class="calendar-dot warning"></span> Public holiday</span>
        </div>
    </div>

    <div class="card calendar-shell">
        <div class="calendar-wrap">
            <div id="calendar" data-events-url="{{ calendarEventsUrl }}"></div>
        </div>
    </div>

    {% include 'project-management/_calendar_event_modal.html.twig' %}
{% endblock %}

{% block script %}
    {{ parent() }}
    <script src="/vendor/fullcalendar/index.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            const modalEl = document.getElementById('calendarEventModal');
            const titleEl = document.getElementById('calendarEventTitle');
            const typeEl = document.getElementById('calendarEventType');
            const dateEl = document.getElementById('calendarEventDate');
            const projectEl = document.getElementById('calendarEventProject');
            const projectWrapEl = document.getElementById('calendarEventProjectWrap');
            const assignedEl = document.getElementById('calendarEventAssignedTo');
            const assignedWrapEl = document.getElementById('calendarEventAssignedWrap');
            const taskWrapEl = document.getElementById('calendarEventTaskWrap');
            const taskEl = document.getElementById('calendarEventTask');
            const detailsEl = document.getElementById('calendarEventDetails');
            const linkEl = document.getElementById('calendarEventLink');
            if (!calendarEl || !window.FullCalendar) {
                return;
            }

            const eventsUrl = String(calendarEl.dataset.eventsUrl || '');

            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                height: 'auto',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listMonth'
                },
                buttonText: {
                    today: 'Today',
                    month: 'Month',
                    week: 'Week',
                    list: 'List'
                },
                events: {
                    url: eventsUrl,
                    failure: function () {
                        console.error('Failed to load calendar events.');
                    }
                },
                eventDisplay: 'block',
                displayEventTime: false,
                fixedWeekCount: false,
                dayMaxEvents: true,
                navLinks: true,
                nowIndicator: true,
                eventClick: function (info) {
                    info.jsEvent.preventDefault();

                    const event = info.event;
                    const props = event.extendedProps || {};
                    const kind = String(props.kind || '');
                    const title = String(props.roleLabel || event.title || 'Event');
                    const projectName = String(props.projectName || 'Unknown project');
                    const dateLabel = String(props.dateLabel || (event.start ? event.start.toLocaleDateString() : ''));
                    const isHoliday = kind === 'public_holiday';
                    const details = String(props.details || (
                        kind === 'task_deadline'
                            ? 'Task deadline tracked on the calendar.'
                            : (isHoliday ? 'Public holiday.' : 'Project milestone tracked on the calendar.')
                    ));

                    if (titleEl) titleEl.textContent = event.title || title;
                    if (typeEl) typeEl.textContent = title;
                    if (dateEl) dateEl.textContent = dateLabel;
                    if (projectWrapEl) projectWrapEl.classList.toggle('d-none', isHoliday);
                    if (projectEl) projectEl.textContent = isHoliday ? '—' : projectName;
                    if (assignedWrapEl) assignedWrapEl.classList.toggle('d-none', isHoliday);
                    if (assignedEl) assignedEl.textContent = isHoliday ? '—' : String(props.assignedToName || 'Unassigned');
                    if (detailsEl) detailsEl.textContent = details;

                    if (taskWrapEl) {
                        const taskName = String(props.taskName || '');
                        if (!isHoliday && taskName !== '') {
                            taskWrapEl.classList.remove('d-none');
                            if (taskEl) taskEl.textContent = taskName;
                        } else {
                            taskWrapEl.classList.add('d-none');
                        }
                    }

                    if (linkEl) {
                        const link = String(props.taskUrl || props.projectUrl || event.url || '');
                        linkEl.href = link || '#';
                        linkEl.classList.toggle('d-none', link === '');
                    }

                    if (modalEl && window.bootstrap && bootstrap.Modal) {
                        bootstrap.Modal.getOrCreateInstance(modalEl).show();
                    }
                }
            });

            calendar.render();
        });
    </script>
{% endblock %}
