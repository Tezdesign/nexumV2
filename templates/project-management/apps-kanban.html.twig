{% extends 'layouts/vertical.html.twig' %}

{% set title = isManager ? 'Project Kanban' : 'My Kanban' %}

{% block css %}
    {% include 'partials/_task_project_design_system.html.twig' %}
    <style>
        .kanban-shell {
            padding: 22px 0 28px;
        }

        .kanban-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin-bottom: 18px;
            flex-wrap: wrap;
        }

        .kanban-toolbar {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .kanban-filter-btn,
        .kanban-add-btn {
            border-radius: 14px;
            padding: 11px 18px;
            font-weight: 800;
        }

        .kanban-filter-btn {
            border: 1px solid #d9e2ef;
            background: #fff;
            color: #314155;
        }

        .kanban-filter-btn:hover {
            border-color: #c3cfdf;
            color: #0f172a;
        }

        .kanban-filter-summary {
            margin-top: 8px;
            color: #7b8da6;
            font-size: 14px;
            font-weight: 600;
        }

        .kanban-board {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
        }

        .kanban-column {
            border-radius: 22px;
            border: 1px solid #dfe6f1;
            background: linear-gradient(180deg, #f7f9fc 0%, #f2f5f9 100%);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
            overflow: hidden;
        }

        .kanban-column-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 14px 14px 10px;
            font-weight: 800;
            color: #52657d;
        }

        .kanban-column-title {
            font-size: 15px;
            color: #243245;
        }

        .kanban-count {
            min-width: 26px;
            height: 26px;
            border-radius: 999px;
            background: #e8eef6;
            color: #8193aa;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 900;
        }

        .kanban-stack {
            padding: 0 12px 12px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            min-height: 620px;
        }

        .kanban-stack .nexum-row {
            border-top: 0;
        }

        .kanban-task-card {
            border-radius: 18px;
            background: #fff;
            border: 1px solid rgba(223, 230, 241, 0.9);
            box-shadow: 0 10px 22px rgba(31, 41, 55, 0.08);
            padding: 12px 14px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 14px;
            transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
        }

        .kanban-task-card.is-draggable {
            cursor: grab;
        }

        .kanban-task-card.is-locked {
            cursor: default;
        }

        .kanban-task-card.is-dragging {
            opacity: 0.55;
            transform: rotate(1deg) scale(0.99);
            box-shadow: 0 20px 34px rgba(31, 41, 55, 0.16);
        }

        .kanban-task-main {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
            flex: 1 1 auto;
        }

        .kanban-task-toggle {
            flex: 0 0 auto;
        }

        .kanban-task-check {
            width: 24px;
            height: 24px;
            border-radius: 999px;
            border: 2px solid #d6dee9;
            background: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: transparent;
            padding: 0;
        }

        .kanban-task-check.is-done {
            border-color: #22c58b;
            background: rgba(34, 197, 139, 0.12);
            color: #22c58b;
        }

        .kanban-task-check.is-disabled {
            cursor: default;
        }

        .kanban-column.is-drop-target .kanban-stack {
            background: rgba(124, 58, 237, 0.05);
        }

        .kanban-column.is-updating {
            opacity: 0.75;
        }

        .kanban-task-body {
            min-width: 0;
        }

        .kanban-task-title {
            display: block;
            max-width: 230px;
            font-size: 15px;
            font-weight: 800;
            color: #1f2d3d;
            text-decoration: none;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .kanban-task-title:hover {
            text-decoration: underline;
        }

        .kanban-task-title.is-done {
            color: #8a97aa;
            text-decoration: line-through;
        }

        .kanban-task-assignee {
            margin-top: 4px;
            font-size: 12px;
            font-weight: 700;
            color: #6c7b90;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .kanban-task-badges {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            flex: 0 0 auto;
        }

        .kanban-empty {
            min-height: 132px;
            border-radius: 18px;
            border: 1px dashed #d7e0ed;
            background: rgba(255, 255, 255, 0.52);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #7b8da6;
            font-size: 13px;
            font-weight: 700;
            padding: 24px 18px;
        }

        .kanban-modal .modal-dialog {
            max-width: 540px;
        }

        .kanban-modal .modal-content {
            border-radius: 18px;
            border: 1px solid #e2e8f0;
        }

        .kanban-modal .modal-header,
        .kanban-modal .modal-footer {
            border-color: #eef2f7;
        }

        .kanban-modal .modal-title {
            font-weight: 900;
        }

        .kanban-modal .form-select {
            border-radius: 12px;
            border-color: #d8e1ee;
            padding-top: 10px;
            padding-bottom: 10px;
        }

        @media (max-width: 1199.98px) {
            .kanban-board {
                grid-template-columns: 1fr;
            }

            .kanban-stack {
                min-height: auto;
            }
        }
    </style>
{% endblock %}

{% block content %}
    <div class="kanban-shell">
        <div class="kanban-head">
            <div>
                <h1 class="nexum-title">{{ title }}</h1>
                <div class="nexum-subtitle">
                    {{ isManager ? 'Managers can review every task across every project.' : 'Only your assigned tasks are shown here.' }}
                </div>
                <div class="kanban-filter-summary">
                    {% if selectedProjectId > 0 and selectedProjectName %}
                        Showing {{ selectedProjectName|plain_text }}
                    {% elseif not showAllOption and projectChoices is empty %}
                        No related projects available
                    {% else %}
                        Showing {{ allProjectsLabel }}
                    {% endif %}
                </div>
            </div>

            <div class="kanban-toolbar">
                <button type="button" class="btn kanban-filter-btn" data-bs-toggle="modal" data-bs-target="#kanbanFilterModal">
                    <i class="ri-filter-2-line me-1"></i> Filter
                </button>
                {% if canCreateTask %}
                    <a href="{{ createTaskUrl }}" class="btn nexum-btn-primary text-white kanban-add-btn">
                        <i class="ti ti-plus me-1"></i> Add Task
                    </a>
                {% endif %}
            </div>
        </div>

        <div class="kanban-board">
            {% for column in columns %}
                <section class="kanban-column"
                         aria-label="{{ column.label }}"
                         data-column-key="{{ column.key }}"
                         data-column-label="{{ column.label }}">
                    <div class="kanban-column-head">
                        <div class="kanban-column-title">{{ column.label }}</div>
                        <span class="kanban-count">{{ column.tasks|length }}</span>
                    </div>

                    <div class="kanban-stack">
                        {% if column.tasks is not empty %}
                            {% for task in column.tasks %}
                                {% include 'task/_kanban_card.html.twig' with {
                                    task: task,
                                    currentUserId: currentUserId,
                                    isManager: isManager,
                                    usersById: usersById,
                                    avatarUrlById: avatarUrlById,
                                    taskUrl: path('app_task_show', {id: task.id})
                                } %}
                            {% endfor %}
                        {% else %}
                            <div class="kanban-empty">No tasks in {{ column.label|lower }}.</div>
                        {% endif %}
                    </div>
                </section>
            {% endfor %}
        </div>
    </div>

    <div class="modal fade kanban-modal" id="kanbanFilterModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1">Filter Board</h5>
                        <div class="text-muted small">Choose which project to display on the Kanban board.</div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form method="get" action="{{ path('apps-kanban') }}">
                    <div class="modal-body">
                        <label for="kanbanProjectFilter" class="form-label">Project</label>
                        <select id="kanbanProjectFilter" name="project" class="form-select">
                            {% if showAllOption %}
                                <option value="0" {{ selectedProjectId == 0 ? 'selected' : '' }}>{{ allProjectsLabel }}</option>
                            {% endif %}
                            {% for pid, project in projectChoices %}
                                <option value="{{ pid }}" {{ pid == selectedProjectId ? 'selected' : '' }}>
                                    {{ project.name|plain_text }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Apply</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade nexum-modal nexum-danger" id="deleteTaskModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0">
                    <div class="nexum-danger-head">
                        <div class="nexum-danger-icon" aria-hidden="true">
                            <i class="ri-error-warning-line"></i>
                        </div>
                        <div>
                            <h5 class="nexum-danger-title">Delete Task?</h5>
                            <div class="nexum-danger-sub">This action cannot be undone.</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body pt-0">
                    <div class="nexum-danger-box">
                        <div>You are about to permanently delete:</div>
                        <div class="nexum-danger-task" id="deleteTaskTitle">—</div>
                        <div class="mt-1 text-muted">This task will be removed from your project.</div>
                    </div>
                </div>

                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" action="" id="deleteTaskForm" class="m-0">
                        <input type="hidden" name="_token" id="deleteTaskToken" value="">
                        <input type="hidden" name="back" value="{{ app.request.requestUri }}">
                        <button type="submit" class="btn btn-danger">Delete Task</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade nexum-modal" id="editTaskModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" id="editTaskModalContent">
                <div class="modal-body text-muted small p-4">Loading...</div>
            </div>
        </div>
    </div>
{% endblock %}

{% block script %}
    <script>
        (function () {
            const board = document.querySelector('.kanban-board');
            if (!board) return;

            const statusLabels = {
                todo: 'To Do',
                in_progress: 'In Progress',
                done: 'Done'
            };

            let draggingCard = null;
            let sourceColumn = null;

            const updateColumnCounts = function () {
                board.querySelectorAll('[data-column-key]').forEach((column) => {
                    const count = column.querySelectorAll('[data-task-card]').length;
                    const badge = column.querySelector('.kanban-count');
                    if (badge) {
                        badge.textContent = String(count);
                    }
                });
            };

            const syncEmptyStates = function () {
                board.querySelectorAll('[data-column-key]').forEach((column) => {
                    const stack = column.querySelector('.kanban-stack');
                    if (!stack) return;

                    const hasCards = stack.querySelector('[data-task-card]') !== null;
                    let empty = stack.querySelector('.kanban-empty');

                    if (!hasCards && !empty) {
                        empty = document.createElement('div');
                        empty.className = 'kanban-empty';
                        empty.textContent = 'No tasks in ' + String(column.getAttribute('data-column-label') || '').toLowerCase() + '.';
                        stack.appendChild(empty);
                    }

                    if (hasCards && empty) {
                        empty.remove();
                    }
                });
            };

            const syncCardVisual = function (card, statusKey) {
                const checkButton = card.querySelector('[data-check-button]');
                const title = card.querySelector('[data-task-title]');
                const statusBadge = card.querySelector('[data-status-badge]');
                const toggleInput = card.querySelector('[data-toggle-status-input]');
                const isDone = statusKey === 'done';

                card.setAttribute('data-status-key', statusKey);

                if (statusBadge) {
                    statusBadge.textContent = statusLabels[statusKey] || 'To Do';
                    statusBadge.classList.remove('todo', 'in_progress', 'done');
                    statusBadge.classList.add(statusKey);
                }

                if (title) {
                    title.classList.toggle('is-done', isDone);
                }

                if (checkButton) {
                    checkButton.classList.toggle('is-done', isDone);
                    if ('innerHTML' in checkButton) {
                        checkButton.innerHTML = isDone ? '<i class="ri-check-line"></i>' : '';
                    }
                    if (checkButton.tagName === 'BUTTON') {
                        const nextStatus = isDone ? 'todo' : 'done';
                        checkButton.setAttribute('title', isDone ? 'Mark as To Do' : 'Mark as Done');
                        checkButton.setAttribute('aria-label', isDone ? 'Mark as To Do' : 'Mark as Done');
                        if (toggleInput) {
                            toggleInput.value = nextStatus;
                        }
                    }
                }
            };

            const postStatusUpdate = async function (card, statusKey) {
                const url = card.getAttribute('data-update-url') || '';
                const csrf = card.getAttribute('data-csrf-token') || '';
                if (!url || !csrf) {
                    throw new Error('Missing task status metadata.');
                }

                const formData = new FormData();
                formData.append('_token', csrf);
                formData.append('status', statusKey);
                formData.append('back', window.location.pathname + window.location.search);

                const res = await fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'text/plain, text/html;q=0.9'
                    }
                });

                if (res.status === 204) {
                    return;
                }

                if (res.status === 403) {
                    throw new Error('You can update progress only for tasks assigned to you.');
                }

                if (!res.ok) {
                    throw new Error('Failed to update task status.');
                }
            };

            board.querySelectorAll('[data-task-card]').forEach((card) => {
                if (card.getAttribute('draggable') !== 'true') {
                    return;
                }

                card.addEventListener('dragstart', function () {
                    draggingCard = card;
                    sourceColumn = card.closest('[data-column-key]');
                    card.classList.add('is-dragging');
                });

                card.addEventListener('dragend', function () {
                    card.classList.remove('is-dragging');
                    board.querySelectorAll('[data-column-key]').forEach((column) => {
                        column.classList.remove('is-drop-target', 'is-updating');
                    });
                    draggingCard = null;
                    sourceColumn = null;
                });
            });

            board.querySelectorAll('[data-column-key]').forEach((column) => {
                const stack = column.querySelector('.kanban-stack');
                if (!stack) return;

                stack.addEventListener('dragover', function (e) {
                    if (!draggingCard) return;
                    e.preventDefault();
                    column.classList.add('is-drop-target');
                });

                stack.addEventListener('dragleave', function (e) {
                    if (!column.contains(e.relatedTarget)) {
                        column.classList.remove('is-drop-target');
                    }
                });

                stack.addEventListener('drop', async function (e) {
                    if (!draggingCard) return;
                    e.preventDefault();
                    column.classList.remove('is-drop-target');

                    const targetStatus = column.getAttribute('data-column-key') || '';
                    const currentStatus = draggingCard.getAttribute('data-status-key') || '';
                    if (!targetStatus || targetStatus === currentStatus) {
                        return;
                    }

                    column.classList.add('is-updating');
                    if (sourceColumn) {
                        sourceColumn.classList.add('is-updating');
                    }

                    try {
                        await postStatusUpdate(draggingCard, targetStatus);
                        stack.appendChild(draggingCard);
                        syncCardVisual(draggingCard, targetStatus);
                        syncEmptyStates();
                        updateColumnCounts();
                    } catch (err) {
                        window.alert(err instanceof Error ? err.message : 'Failed to update task status.');
                    } finally {
                        column.classList.remove('is-updating');
                        if (sourceColumn) {
                            sourceColumn.classList.remove('is-updating');
                        }
                    }
                });
            });

            syncEmptyStates();
            updateColumnCounts();
        })();

        (function () {
            const delModal = document.getElementById('deleteTaskModal');
            if (delModal) {
                delModal.addEventListener('show.bs.modal', function (ev) {
                    const btn = ev.relatedTarget;
                    if (!btn) return;

                    const action = btn.getAttribute('data-delete-action') || '';
                    const token = btn.getAttribute('data-delete-token') || '';
                    const title = btn.getAttribute('data-task-title') || '—';

                    const form = document.getElementById('deleteTaskForm');
                    const tokenEl = document.getElementById('deleteTaskToken');
                    const titleEl = document.getElementById('deleteTaskTitle');
                    if (form) form.setAttribute('action', action);
                    if (tokenEl) tokenEl.value = token;
                    if (titleEl) titleEl.textContent = title;
                });
            }
        })();

        (function () {
            const editModal = document.getElementById('editTaskModal');
            const editContent = document.getElementById('editTaskModalContent');
            if (!editModal || !editContent) return;

            const wireEditForm = function () {
                const form = editContent.querySelector('form');
                if (!form) return;

                form.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    try {
                        const res = await fetch(form.action, {
                            method: form.method || 'POST',
                            body: new FormData(form),
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (res.status === 204) {
                            if (window.bootstrap && bootstrap.Modal) {
                                bootstrap.Modal.getInstance(editModal)?.hide();
                            }
                            window.location.reload();
                            return;
                        }

                        const html = await res.text();
                        editContent.innerHTML = html;
                        wireEditForm();
                    } catch (err) {
                        editContent.innerHTML = '<div class="modal-body p-4 text-danger small">Failed to load the edit form.</div>';
                    }
                }, { once: true });
            };

            editModal.addEventListener('show.bs.modal', async function (ev) {
                const btn = ev.relatedTarget;
                const url = btn ? (btn.getAttribute('data-edit-url') || '') : '';
                editContent.innerHTML = '<div class="modal-body text-muted small p-4">Loading...</div>';
                if (!url) return;

                try {
                    const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const html = await res.text();
                    editContent.innerHTML = html;
                    wireEditForm();
                } catch (err) {
                    editContent.innerHTML = '<div class="modal-body p-4 text-danger small">Failed to load the edit form.</div>';
                }
            });
        })();
    </script>
{% endblock %}

{% block footer %}{% endblock %}
