{% extends 'base.html.twig' %}

{% block title %}Resource{% endblock %}

{% block body %}
    <h1>Resource</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Resource_id</th>
                <td>{{ resource.resourceId }}</td>
            </tr>
            <tr>
                <th>Resource_code</th>
                <td>{{ resource.resourceCode }}</td>
            </tr>
            <tr>
                <th>Resource_name</th>
                <td>{{ resource.resourceName }}</td>
            </tr>
            <tr>
                <th>Resource_type</th>
                <td>{{ resource.resourceType }}</td>
            </tr>
            <tr>
                <th>Unit_cost</th>
                <td>{{ resource.unitCost }}</td>
            </tr>
            <tr>
                <th>Total_quantity</th>
                <td>{{ resource.totalQuantity }}</td>
            </tr>
            <tr>
                <th>Available_quantity</th>
                <td>{{ resource.availableQuantity }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ resource.status }}</td>
            </tr>
            <tr>
                <th>Image_path</th>
                <td>{{ resource.imagePath }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_resources_management_resource_index') }}">back to list</a>

    <a href="{{ path('app_resources_management_resource_edit', {'resource_id': resource.resource_id}) }}">edit</a>

    {{ include('resources_management/resource/_delete_form.html.twig') }}
{% endblock %}
