<form method="post" action="{{ path('app_resources_management_resource_delete', {'resource_id': resource.resource_id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ resource.resource_id) }}">
    <button class="btn">Delete</button>
</form>
