{% extends '/layouts/vertical.html.twig' %}

{% set title = 'Chat' %}

{% block css %}{% endblock %}

{% block content %}

    <div class="chat d-flex gap-2 position-relative" data-apps-chat="chat-root" data-current-user-name="{{ currentUser.name|e('html_attr') }}" data-current-user-avatar="{{ (currentUser.avatarSrc ?? '')|e('html_attr') }}">
        <div class="offcanvas-xxl offcanvas-start" tabindex="-1" id="chatUserList" aria-labelledby="chatUserListLabel">
            <div id="chat-user-list" class="card collapse collapse-horizontal show">
                <div class="chat-user-list">
                    <div class="card-body py-2 px-3 border-bottom">
                        <div class="d-flex align-items-center gap-2 py-1">
                            <div class="chat-users">
                                <div class="avatar-lg chat-avatar-online">
                                    {% if currentUser.avatarSrc %}
                                        <img src="{{ currentUser.avatarSrc }}" class="w-100 h-100 object-fit-cover rounded-circle" alt="{{ currentUser.name }}">
                                    {% else %}
                                        <div class="h-100 w-100 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-semibold">
                                            {{ currentUser.name|slice(0, 1)|upper }}
                                        </div>
                                    {% endif %}
                                </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-0">
                                        <a href="#!" class="text-reset lh-base">
                                            {{ currentUser.name }} (You)
                                        </a>
                                    </h5>
                                    <p class="mb-0 fs-13 text-muted">
                                        {{ currentUser.role }}
                                    </p>
                                </div>
                                <div class="dropdown lh-1">
                                    <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                        <iconify-icon icon="solar:settings-outline" class="align-middle"></iconify-icon>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end">
                                        <!-- item-->
                                        <a href="javascript:void(0);" class="dropdown-item">
                                            <i class="ti ti-user-plus me-1 fs-17 align-middle"></i>
                                            <span class="align-middle">
                                                New Contact
                                            </span>
                                        </a>
                                        <!-- item-->
                                        <a href="javascript:void(0);" class="dropdown-item">
                                            <i class="ti ti-users-plus me-1 fs-17 align-middle"></i>
                                            <span class="align-middle">
                                                New Group
                                            </span>
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <button type="button" class="dropdown-item d-flex align-items-center justify-content-between active" data-chat-filter="all" data-chat-filter-label="All" aria-pressed="true">
                                            <span>
                                            <i class="ti ti-filter me-1 fs-17 align-middle"></i>
                                            <span class="align-middle">
                                                All
                                            </span>
                                            </span>
                                            <i class="ti ti-check fs-16" data-chat-filter-check></i>
                                        </button>
                                        <button type="button" class="dropdown-item d-flex align-items-center justify-content-between" data-chat-filter="dm" data-chat-filter-label="DM" aria-pressed="false">
                                            <span>
                                            <i class="ti ti-star me-1 fs-17 align-middle"></i>
                                            <span class="align-middle">
                                                DM
                                            </span>
                                            </span>
                                            <i class="ti ti-check fs-16 d-none" data-chat-filter-check></i>
                                        </button>
                                        <button type="button" class="dropdown-item d-flex align-items-center justify-content-between" data-chat-filter="group" data-chat-filter-label="Groups" aria-pressed="false">
                                            <span>
                                            <i class="ti ti-archive me-1 fs-17 align-middle"></i>
                                            <span class="align-middle">
                                                Groups
                                            </span>
                                            </span>
                                            <i class="ti ti-check fs-16 d-none" data-chat-filter-check></i>
                                        </button>
                                    </div>
                                </div>
                                <button type="button" class="flex-grow-0 btn btn-sm btn-icon btn-soft-danger d-xl-none" data-bs-dismiss="offcanvas" data-bs-target="#chatUserList" aria-label="Close">
                                    <i class="ti ti-x fs-20"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Contact list -->
                        <div class="d-flex flex-column">
                            <div class="px-3 py-2">
                                <div class="app-search py-1">
                                    <input type="text" class="form-control border-light bg-light bg-opacity-50 rounded-2" placeholder="Search conversations..." data-apps-chat="search-input">
                                        <i class="app-search-icon ti ti-search text-muted fs-16"></i>
                                    </div>
                                </div>

                                <div class="users-list position-relative list-scroll" data-simplebar>
                                    <div class="d-flex align-items-center px-3 py-2 bg-body-secondary position-sticky top-0 z-1">
                                        <iconify-icon icon="solar:chat-line-bold-duotone" class="fs-18 text-muted"></iconify-icon>
                                        <h5 class="mb-0 ms-1 fw-semibold fs-14">
                                            Conversations
                                        </h5>
                                        <span class="badge text-bg-light ms-auto" data-apps-chat="filter-label">All</span>
                                    </div>

                                    {% for conversation in conversations %}
                                        <a href="javascript:void(0);" class="text-body d-block" data-apps-chat="conversation-item" data-conversation-id="{{ conversation.id }}" data-messages-endpoint="{{ path('apps-chat-conversation-messages', {'conversationId': conversation.id}) }}" data-conversation-name="{{ conversation.name|e('html_attr') }}" data-conversation-avatar="{{ (conversation.avatarSrc ?? '')|e('html_attr') }}" data-conversation-type="{{ conversation.isDm ? 'DM' : 'GROUP' }}" data-conversation-is-admin="{{ conversation.isAdmin ? '1' : '0' }}" data-conversation-created-at="{{ (conversation.createdAtLabel ?? '--')|e('html_attr') }}" data-dm-name="{{ conversation.isDm ? conversation.name|e('html_attr') : '' }}" data-group-title="{{ conversation.isDm ? '' : conversation.name|e('html_attr') }}">
                                            <div class="chat-users">
                                                <div class="avatar-md {{ conversation.isDm ? 'chat-avatar-online' : 'chat-avatar-offline' }}">
                                                    {% if conversation.avatarSrc %}
                                                        <img src="{{ conversation.avatarSrc }}" class="w-100 h-100 object-fit-cover rounded-circle" alt="{{ conversation.name }}" data-apps-chat="conversation-avatar-image" />
                                                    {% else %}
                                                        <div class="h-100 w-100 rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center fw-semibold" data-apps-chat="conversation-avatar-fallback">
                                                            {{ conversation.name|slice(0, 1)|upper }}
                                                        </div>
                                                    {% endif %}
                                                </div>

                                                <div class="flex-grow-1 overflow-hidden">
                                                    <h5 class="m-0">
                                                        <span class="float-end text-muted fs-12">
                                                            {{ conversation.lastMessageTimeLabel ?? '--' }}
                                                        </span>
                                                        <span data-apps-chat="conversation-name">{{ conversation.name }}</span>
                                                    </h5>
                                                    <p class="mt-1 mb-0 text-muted lh-1">
                                                        <span class="w-75 d-inline-block text-truncate overflow-hidden fs-13">
                                                            {{ conversation.lastMessagePreview ?? 'No messages yet' }}
                                                        </span>
                                                    </p>
                                                </div>
                                            </div>
                                        </a>
                                    {% else %}
                                        <div class="px-3 py-3 text-muted fs-13">
                                            No conversations found for this user.
                                        </div>
                                    {% endfor %}

                                    <div class="px-3 py-3 text-muted fs-13 d-none" data-apps-chat="filter-empty">
                                        No conversations match this filter.
                                    </div>
                                </div>
                            </div>
                        <!-- End Contact list -->
                        </div>
                    </div>
                </div>

                <div class="card chat-content">
                    <div class="card-header py-2 px-3 border-bottom">
                        <div class="d-flex align-items-center justify-content-between py-1">
                            <div class="d-flex align-items-center gap-2">

                                <a href="#" class="btn btn-sm btn-icon btn-soft-primary d-none d-xl-flex me-2" data-bs-toggle="collapse" data-bs-target="#chat-user-list" aria-expanded="true">
                                    <i class="ti ti-chevrons-left fs-20"></i>
                                </a>

                                <button class="btn btn-sm btn-icon btn-ghost-light text-dark d-xl-none d-flex" type="button" data-bs-toggle="offcanvas" data-bs-target="#chatUserList" aria-controls="chatUserList">
                                    <i class="ti ti-menu-2 fs-20"></i>
                                </button>

                                <img src="" class="avatar-lg rounded-circle d-none" alt="conversation avatar" data-apps-chat="active-conversation-avatar">
                                <div class="avatar-lg rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center fw-semibold" data-apps-chat="active-conversation-avatar-fallback">
                                    -
                                </div>

                                    <div>
                                        <h5 class="my-0 lh-base">
                                            <a href="#" class="text-reset" data-apps-chat="active-conversation-name">
                                                Select a conversation
                                            </a>
                                        </h5>
                                        <p class="mb-0 text-muted" data-apps-chat="active-conversation-meta">
                                            Choose a conversation from the list
                                        </p>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <a href="javascript: void(0);" class="btn btn-sm btn-icon btn-ghost-light d-none d-xl-flex" data-bs-toggle="modal" data-bs-target="#userCall" data-bs-toggle="tooltip" data-bs-placement="top" title="Voice Call">
                                        <i class="ti ti-phone-call fs-20"></i>
                                    </a>
                                    <a href="javascript: void(0);" class="btn btn-sm btn-icon btn-ghost-light d-none d-xl-flex" data-bs-toggle="modal" data-bs-target="#userVideoCall" data-bs-toggle="tooltip" data-bs-placement="top" title="Video Call">
                                        <i class="ti ti-video fs-20"></i>
                                    </a>

                                    <a href="javascript: void(0);" class="btn btn-sm btn-icon btn-ghost-light d-xl-flex" data-apps-chat="details-toggle" aria-expanded="false">
                                        <i class="ti ti-info-circle fs-20"></i>
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div>
                            <div class="chat-scroll p-3" data-simplebar data-apps-chat="messages-scroll-wrapper">
                                <ul class="chat-list" data-apps-chat="messages-list"></ul>
                                <div class="px-2 py-3 text-muted fs-13" data-apps-chat="messages-state">
                                    Select a conversation to load messages.
                                </div>
                            </div>

                            <div class="p-3 border-top position-sticky bottom-0 w-100 mb-0">
                                <form class="d-flex align-items-center gap-1" name="chat-form" id="chat-form">

                                    <div>
                                        <button type="button" class="btn btn-icon btn-soft-warning">
                                            <iconify-icon icon="solar:smile-circle-outline" class="fs-20"></iconify-icon>
                                        </button>
                                    </div>

                                    <input type="text" name="message" class="form-control" placeholder="Type Message..." required data-apps-chat="chat-input" disabled>

                                        <div class="d-flex align-items-center gap-1">
                                            <button type="submit" class="btn btn-icon btn-success chat-send" data-apps-chat="chat-send" disabled>
                                                <i class='ti ti-send'></i>
                                            </button>
                                            <a href="#" class="btn btn-icon btn-soft-primary d-none d-md-inline-flex">
                                                <i class="ti ti-microphone"></i>
                                            </a>
                                            <a href="#" class="btn btn-icon btn-soft-primary d-none d-md-inline-flex">
                                                <i class="ti ti-paperclip"></i>
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                <div class="d-none" data-apps-chat="details-backdrop" style="position:absolute; inset:0; background:rgba(15,23,42,0.42); z-index:1040;"></div>

                <div class="card d-none h-100 overflow-auto" style="position:absolute; top:0; right:0; bottom:0; width: 340px; min-width: 340px; z-index:1050; box-shadow:-20px 0 40px rgba(0,0,0,0.18);" data-apps-chat="details-drawer">
                    <div class="card-body border-bottom d-flex align-items-center justify-content-between">
                        <h5 class="mb-0 fs-15">Conversation info</h5>
                        <button type="button" class="btn btn-sm btn-icon btn-ghost-light" data-apps-chat="details-close" aria-label="Close details">
                            <i class="ti ti-x fs-18"></i>
                        </button>
                    </div>
                    <div class="card-body text-center border-bottom">
                        <img src="" class="avatar-xl rounded-circle d-none mx-auto" alt="details avatar" data-apps-chat="details-avatar">
                        <div class="avatar-xl rounded-circle bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center fw-semibold mx-auto" data-apps-chat="details-avatar-fallback">-</div>
                        <h5 class="mt-3 mb-1" data-apps-chat="details-name">Select a conversation</h5>
                        <p class="text-muted mb-0" data-apps-chat="details-type">Conversation</p>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom" data-apps-chat="details-chat-info-toggle" role="button" tabindex="0" aria-expanded="false">
                            <span class="fw-medium">Chat info</span>
                            <i class="ti ti-chevron-down text-muted" data-apps-chat="details-chat-info-chevron"></i>
                        </div>
                        <div class="pb-2 border-bottom d-none" data-apps-chat="details-chat-info-body">
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Name</span>
                                <span class="fw-medium" data-apps-chat="details-info-name">-</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Type</span>
                                <span class="fw-medium" data-apps-chat="details-info-type">-</span>
                            </div>
                            <div class="d-flex justify-content-between py-1">
                                <span class="text-muted">Created at</span>
                                <span class="fw-medium" data-apps-chat="details-info-created">--</span>
                            </div>
                        </div>
                        <div class="d-none" data-apps-chat="details-customize-section">
                            <div class="d-flex align-items-center justify-content-between py-2 border-bottom" data-apps-chat="details-customize-toggle" role="button" tabindex="0" aria-expanded="false">
                                <span class="fw-medium">Customize chat</span>
                                <i class="ti ti-chevron-down text-muted" data-apps-chat="details-customize-chevron"></i>
                            </div>
                            <div class="py-2 border-bottom d-none d-flex flex-column gap-2" data-apps-chat="details-customize-body">
                                <button type="button" class="btn btn-sm btn-light text-start" data-apps-chat="customize-name-toggle">
                                    <i class="ti ti-edit me-1"></i>
                                    <span>Change chat name</span>
                                </button>
                                <button type="button" class="btn btn-sm btn-light text-start" data-apps-chat="customize-avatar-toggle">
                                    <i class="ti ti-photo-up me-1"></i>
                                    <span>Change chat picture</span>
                                </button>
                            </div>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <span class="fw-medium">Chat members</span>
                            <i class="ti ti-chevron-down text-muted"></i>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 border-bottom">
                            <span class="fw-medium">Media, files and links</span>
                            <i class="ti ti-chevron-down text-muted"></i>
                        </div>
                        <div class="d-flex align-items-center justify-content-between py-2 text-danger" data-apps-chat="details-danger-action-wrap">
                            <span class="fw-medium d-inline-flex align-items-center gap-2">
                                <i class="ti ti-trash fs-16" data-apps-chat="details-danger-icon"></i>
                                <span data-apps-chat="details-danger-action">Delete conversation</span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="modal fade" tabindex="-1" aria-hidden="true" data-apps-chat="rename-modal">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form data-apps-chat="rename-form">
                                <div class="modal-header">
                                    <h5 class="modal-title">Change chat name</h5>
                                    <button type="button" class="btn-close" data-apps-chat="rename-modal-close" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <label for="chatRenameInput" class="form-label">Chat name</label>
                                    <input type="text" class="form-control" id="chatRenameInput" maxlength="120" autocomplete="off" data-apps-chat="rename-input" required>
                                    <div class="invalid-feedback d-none mt-2" data-apps-chat="rename-error"></div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-light" data-apps-chat="rename-modal-cancel">Cancel</button>
                                    <button type="submit" class="btn btn-primary" data-apps-chat="rename-submit">Save changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <input type="file" accept="image/*" class="d-none" data-apps-chat="customize-avatar-input">

    </div>

{% endblock %}

{% block script %}
    <script src="/js/pages/apps-chat.js?v=20260408a"></script>
{% endblock %}
