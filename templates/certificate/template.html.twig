<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: DejaVu Sans, sans-serif;
            background: #ffffff;
            color: #2d2d2d;
        }

        .page {
            width: 100%;
            height: 100%;
            padding: 40px;
        }

        .cert-box {
            border: 8px solid #7F22FE;
            border-radius: 16px;
            padding: 50px 60px;
            text-align: center;
        }

        .academy {
            font-size: 13px;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #7F22FE;
            margin-bottom: 30px;
        }

        .title {
            font-size: 38px;
            font-weight: bold;
            color: #1a1a2e;
            margin-bottom: 8px;
        }

        .subtitle {
            font-size: 14px;
            color: #888;
            margin-bottom: 40px;
        }

        .label {
            font-size: 13px;
            color: #999;
            margin-bottom: 6px;
        }

        .name {
            font-size: 30px;
            font-weight: bold;
            color: #7F22FE;
            border-bottom: 2px solid #e0e0e0;
            display: inline-block;
            padding-bottom: 6px;
            margin-bottom: 30px;
        }

        .formation-label {
            font-size: 13px;
            color: #999;
            margin-bottom: 6px;
        }

        .formation-name {
            font-size: 20px;
            font-weight: bold;
            color: #1a1a2e;
            margin-bottom: 40px;
        }

        .meta-row {
            display: table;
            width: 100%;
            margin-bottom: 40px;
        }

        .meta-cell {
            display: table-cell;
            text-align: center;
            width: 50%;
        }

        .meta-cell .meta-label {
            font-size: 11px;
            color: #aaa;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .meta-cell .meta-value {
            font-size: 14px;
            font-weight: bold;
            color: #333;
        }

        .qr-section {
            margin-top: 20px;
        }

        .qr-section img {
            width: 100px;
            height: 100px;
        }

        .qr-label {
            font-size: 10px;
            color: #bbb;
            margin-top: 6px;
        }

        .footer {
            margin-top: 30px;
            font-size: 11px;
            color: #ccc;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .badge {
            display: inline-block;
            background: #7F22FE;
            color: white;
            font-size: 11px;
            padding: 4px 14px;
            border-radius: 20px;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
<div class="page">
    <div class="cert-box">

        <div class="academy">NEXUM Academy</div>

        <div class="title">Certificat de Réussite</div>
        <div class="subtitle">Ce certificat est décerné à</div>

        <div class="name">{{ user.nom }}{% if user.prenom is defined and user.prenom %} {{ user.prenom }}{% endif %}</div>

        <div class="formation-label">pour avoir complété avec succès la formation</div>
        <div class="formation-name">{{ formation.titre }}</div>

        <span class="badge">✓ VALIDÉ</span>

        <div class="meta-row">
            <div class="meta-cell">
                <div class="meta-label">Date de validation</div>
                <div class="meta-value">{{ date }}</div>
            </div>
            <div class="meta-cell">
                <div class="meta-label">Identifiant certificat</div>
                <div class="meta-value">{{ certId }}</div>
            </div>
        </div>

        {% if qrBase64 %}
        <div class="qr-section">
            <img src="{{ qrBase64 }}" alt="QR Code certificat">
            <div class="qr-label">Scannez pour vérifier l'authenticité</div>
        </div>
        {% endif %}

        <div class="footer">nexum-academy.com &nbsp;|&nbsp; {{ date }}</div>

    </div>
</div>
</body>
</html> 