<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            background-color: #f4f6f9;
            padding: 20px;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 10px;
        }

        .header {
            text-align: center;
            border-bottom: 2px solid #007bff;
            margin-bottom: 20px;
        }

        .header h1 {
            color: #007bff;
            margin: 0;
        }

        .section {
            margin-bottom: 15px;
        }

        .label {
            font-weight: bold;
            color: #333;
        }

        .value {
            float: right;
            color: #555;
        }

        .row {
            padding: 8px 0;
            border-bottom: 1px solid #ddd;
        }

        .status {
            text-align: center;
            margin-top: 20px;
            padding: 10px;
            background: orange;
            color: white;
            border-radius: 5px;
        }

        .footer {
            margin-top: 30px;
            text-align: center;
            font-size: 12px;
            color: #999;
        }

        .clear {
            clear: both;
        }
    </style>
</head>

<body>
<div class="container">

    <div class="header">
        <h1>NEXUM</h1>
        <p>Resource Request Document</p>
    </div>

    <div class="section">
        <div class="row">
            <span class="label">Client:</span>
            <span class="value">{{ user }}</span>
            <div class="clear"></div>
        </div>

        <div class="row">
            <span class="label">Resource:</span>
            <span class="value">{{ resource }}</span>
            <div class="clear"></div>
        </div>

        <div class="row">
            <span class="label">Quantity:</span>
            <span class="value">{{ quantity }}</span>
            <div class="clear"></div>
        </div>

        <div class="row">
            <span class="label">Total Cost:</span>
            <span class="value">{{ cost }} $</span>
            <div class="clear"></div>
        </div>

        <div class="row">
            <span class="label">Date:</span>
            <span class="value">{{ date }}</span>
            <div class="clear"></div>
        </div>
    </div>

    <div class="status">
        STATUS: PENDING
    </div>

    <div class="footer">
        © 2026 NEXUM - Resource Management System
    </div>

</div>
</body>
</html>