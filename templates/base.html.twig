<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}NEXUM{% endblock %}</title>

    <!-- Favicon -->
    <link href="{{ asset('images/logo-removebg.png') }}" rel="icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap http -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            color: #0f172a;
        }

        /* NAVBAR */
        .navbar-custom {
            background: white;
            border-bottom: 1px solid #e2e8f0;
            padding: 15px 0;
        }

        .logo-img {
            height: 40px;
        }

        .brand-name {
            font-weight: 700;
            font-size: 20px;
            margin-left: 10px;
            background: linear-gradient(90deg,#7c3aed,#6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-link {
            color: #475569 !important;
            font-weight: 500;
        }

        .nav-link:hover {
            color: #7c3aed !important;
        }

        /* MAIN */
        main {
            min-height: 80vh;
            padding: 50px 0;
        }

        /* CARD */
        .card-premium {
            background: white;
            border-radius: 18px;
            padding: 30px;
            border: 1px solid #e2e8f0;
            box-shadow: 0 10px 30px rgba(0,0,0,0.04);
        }

        /* BUTTON */
        .btn-purple {
            background: linear-gradient(135deg,#7c3aed,#6366f1);
            border: none;
            color: white;
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 500;
            transition: 0.3s;
        }

        .btn-purple:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(124,58,237,0.2);
        }

        /* HERO (optional section) */
        .hero {
            text-align: center;
            margin-bottom: 40px;
        }

        .hero h1 {
            font-weight: 700;
            font-size: 36px;
        }

        .hero span {
            background: linear-gradient(90deg,#7c3aed,#6366f1);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* FOOTER */
        .footer {
            background: white;
            border-top: 1px solid #e2e8f0;
            padding: 30px 0;
        }

        .footer h5 {
            color: #7c3aed;
        }

        .footer a {
            color: #64748b;
        }

        .footer a:hover {
            color: #7c3aed;
        }

        /* SCROLL */
        .scroll-top {
            position: fixed;
            right: 20px;
            bottom: 20px;
            background: #7c3aed;
            color: white;
            border-radius: 50%;
            padding: 10px;
            display: none;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

<!-- 🔥 NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-custom">
    <div class="container">

        <a class="navbar-brand d-flex align-items-center" href="{{ path('app_home') }}">
            <img src="{{ asset('images/logo-removebg.png') }}" class="logo-img">
            <span class="brand-name">NEXUM</span>
        </a>

        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav">
            <i class="bi bi-list"></i>
        </button>

        <div class="collapse navbar-collapse justify-content-end" id="nav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="#">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="{{path('app_formation_index')}}">Trainings</a></li>
             </ul>
        </div>

    </div>
</nav>

<!-- 🔥 MAIN -->
<main class="container">

    <!-- OPTIONAL HERO -->
    <div class="hero">
        <h1>Welcome to <span>NEXUM</span></h1>
        <p class="text-muted">Next-generation smart platform</p>
    </div>

    <!-- CONTENT -->
    <div class="card-premium">
        {% block body %}{% endblock %}
    </div>

</main>

<!-- 🔥 FOOTER -->
<footer class="footer text-center">

    <img src="{{ asset('images/logo-removebg.png') }}" style="height:45px;margin-bottom:10px">

    <h5>NEXUM</h5>
    <p class="text-muted">Smart Digital Platform</p>

    <div class="mt-3">
        <a href="#"><i class="bi bi-facebook me-3"></i></a>
        <a href="#"><i class="bi bi-instagram me-3"></i></a>
        <a href="#"><i class="bi bi-linkedin"></i></a>
    </div>

    <hr>

    <p>© {{ "now"|date("Y") }} NEXUM</p>

</footer>

<!-- Scroll -->
<a href="#" class="scroll-top" id="scrollBtn">
    <i class="bi bi-arrow-up"></i>
</a>

<script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const btn = document.getElementById('scrollBtn');
    window.onscroll = () => {
        btn.style.display = window.scrollY > 200 ? 'block' : 'none';
    };
</script>

{% block javascripts %}{% endblock %}

</body>
</html>