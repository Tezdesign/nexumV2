{% extends 'base.html.twig' %}

{% block title %}ProjectBudget{% endblock %}

{% block body %}
    <h1>ProjectBudget</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project_budget.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ project_budget.name }}</td>
            </tr>
            <tr>
                <th>Total_budget</th>
                <td>{{ project_budget.totalBudget }}</td>
            </tr>
            <tr>
                <th>ActualSpend</th>
                <td>{{ project_budget.actualSpend }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ project_budget.status }}</td>
            </tr>
            <tr>
                <th>DueDate</th>
                <td>{{ project_budget.dueDate ? project_budget.dueDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>ProjectId</th>
                <td>{{ project_budget.projectId }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_financial_analysis_project_budget_index') }}">back to list</a>

    <a href="{{ path('app_financial_analysis_project_budget_edit', {'id': project_budget.id}) }}">edit</a>

    {{ include('financial_analysis/project_budget/_delete_form.html.twig') }}
{% endblock %}
