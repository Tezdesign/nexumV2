{% extends 'base.html.twig' %}

{% block title %}ProjectBudget index{% endblock %}

{% block body %}
    <h1>ProjectBudget index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Total_budget</th>
                <th>ActualSpend</th>
                <th>Status</th>
                <th>DueDate</th>
                <th>ProjectId</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project_budget in project_budgets %}
            <tr>
                <td>{{ project_budget.id }}</td>
                <td>{{ project_budget.name }}</td>
                <td>{{ project_budget.totalBudget }}</td>
                <td>{{ project_budget.actualSpend }}</td>
                <td>{{ project_budget.status }}</td>
                <td>{{ project_budget.dueDate ? project_budget.dueDate|date('Y-m-d') : '' }}</td>
                <td>{{ project_budget.projectId }}</td>
                <td>
                    <a href="{{ path('app_financial_analysis_project_budget_show', {'id': project_budget.id}) }}">show</a>
                    <a href="{{ path('app_financial_analysis_project_budget_edit', {'id': project_budget.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_financial_analysis_project_budget_new') }}">Create new</a>
{% endblock %}
