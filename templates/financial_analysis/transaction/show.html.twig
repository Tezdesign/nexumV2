{% extends 'base.html.twig' %}

{% block title %}Transaction{% endblock %}

{% block body %}
    <h1>Transaction</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ transaction.id }}</td>
            </tr>
            <tr>
                <th>Reference</th>
                <td>{{ transaction.reference }}</td>
            </tr>
            <tr>
                <th>Cost</th>
                <td>{{ transaction.cost }}</td>
            </tr>
            <tr>
                <th>Date_stamp</th>
                <td>{{ transaction.dateStamp ? transaction.dateStamp|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Expense_category</th>
                <td>{{ transaction.expenseCategory }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ transaction.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_financial_analysis_transaction_index') }}">back to list</a>

    <a href="{{ path('app_financial_analysis_transaction_edit', {'id': transaction.id}) }}">edit</a>

    {{ include('financial_analysis/transaction/_delete_form.html.twig') }}
{% endblock %}
