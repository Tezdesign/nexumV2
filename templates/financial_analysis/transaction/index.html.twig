{% extends 'base.html.twig' %}

{% block title %}Transaction index{% endblock %}

{% block body %}
    <h1>Transaction index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Reference</th>
                <th>Cost</th>
                <th>Date_stamp</th>
                <th>Expense_category</th>
                <th>Description</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for transaction in transactions %}
            <tr>
                <td>{{ transaction.id }}</td>
                <td>{{ transaction.reference }}</td>
                <td>{{ transaction.cost }}</td>
                <td>{{ transaction.dateStamp ? transaction.dateStamp|date('Y-m-d') : '' }}</td>
                <td>{{ transaction.expenseCategory }}</td>
                <td>{{ transaction.description }}</td>
                <td>
                    <a href="{{ path('app_financial_analysis_transaction_show', {'id': transaction.id}) }}">show</a>
                    <a href="{{ path('app_financial_analysis_transaction_edit', {'id': transaction.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_financial_analysis_transaction_new') }}">Create new</a>
{% endblock %}
