{% extends 'base.html.twig' %}

{% block title %}BudgetProfile index{% endblock %}

{% block body %}
    <h1>BudgetProfile index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Fiscal_year</th>
                <th>Budget_disposable</th>
                <th>Total_expense</th>
                <th>Margin_profit</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for budget_profile in budget_profiles %}
            <tr>
                <td>{{ budget_profile.id }}</td>
                <td>{{ budget_profile.fiscalYear }}</td>
                <td>{{ budget_profile.budgetDisposable }}</td>
                <td>{{ budget_profile.totalExpense }}</td>
                <td>{{ budget_profile.marginProfit }}</td>
                <td>
                    <a href="{{ path('app_financial_analysis_budget_profile_show', {'id': budget_profile.id}) }}">show</a>
                    <a href="{{ path('app_financial_analysis_budget_profile_edit', {'id': budget_profile.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_financial_analysis_budget_profile_new') }}">Create new</a>
{% endblock %}
