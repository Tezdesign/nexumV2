{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Edit Project' %}
{% set subtitle = 'Project Management' %}

{% block content %}

    <div class="d-flex align-items-center justify-content-between gap-3 mb-3">
        <div class="flex-grow-1">
            {{ include('partials/page-title.html.twig', { title: title, subtitle: subtitle }) }}
        </div>
        <div class="flex-shrink-0 d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('app_project_index') }}">Back</a>
            {{ include('project/_delete_form.html.twig') }}
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {{ include('project/_form.html.twig', {'button_label': 'Update'}) }}
        </div>
    </div>

{% endblock %}
