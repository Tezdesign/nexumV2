<div class="modal-header">
    <div>
        <h5 class="modal-title mb-1">Edit Project</h5>
        <div class="text-muted small">Update project details</div>
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

{{ form_start(form, {
    action: path('app_project_edit', {id: project.id}),
    method: 'POST',
    attr: { id: 'editProjectForm', novalidate: 'novalidate' }
}) }}

<div class="modal-body">
    {{ form_errors(form) }}

    <div class="mb-3">
        {{ form_label(form.name) }} <span class="text-danger">*</span>
        {{ form_widget(form.name, { attr: { class: 'form-control', placeholder: 'e.g. Q4 Marketing Campaign' } }) }}
        {{ form_errors(form.name) }}
    </div>

    <div class="mb-3">
        {{ form_label(form.description) }}
        {{ form_widget(form.description, { attr: { class: 'form-control', placeholder: 'Describe the goals and scope of this project...' } }) }}
        {{ form_errors(form.description) }}
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            {{ form_label(form.start_date) }} <span class="text-danger">*</span>
            {{ form_widget(form.start_date, { attr: { class: 'form-control' } }) }}
            {{ form_errors(form.start_date) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_label(form.end_date) }} <span class="text-danger">*</span>
            {{ form_widget(form.end_date, { attr: { class: 'form-control' } }) }}
            {{ form_errors(form.end_date) }}
        </div>
    </div>

    <div class="mt-3">
        {{ form_label(form.budget) }}
        {{ form_widget(form.budget, { attr: { class: 'form-control', placeholder: 'e.g. 25000' } }) }}
        {{ form_errors(form.budget) }}
    </div>
</div>

<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" class="btn btn-primary">Save</button>
</div>

{{ form_end(form) }}
