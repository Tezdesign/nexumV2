{% set projectForm = projectForm|default(createForm|default(null)) %}
{% set contentId = contentId|default('createProjectModalContent') %}
{% set formId = formId|default('createProjectForm') %}
{% set submitLabel = submitLabel|default('Create Project') %}
{% set headingTitle = headingTitle|default('Create New Project') %}
{% set headingSubtitle = headingSubtitle|default('Start a new initiative for your team') %}
{% set formAction = formAction|default(null) %}
{% set formMethod = formMethod|default(null) %}
{% set aiTaskSuggestionsJson = aiTaskSuggestionsJson|default('[]') %}

<div class="modal-content" id="{{ contentId }}">
    {{ form_start(projectForm, {
        action: formAction,
        method: formMethod,
        attr: { id: formId, novalidate: 'novalidate' }
    }) }}
    <input type="hidden" name="back" value="{{ backUrl|default('') }}">
    <input type="hidden"
           name="ai_task_suggestions"
           value="{{ aiTaskSuggestionsJson|e('html_attr') }}"
           data-ai-task-suggestions="1">

    <div class="modal-header">
        <div>
            <h5 class="modal-title mb-1">{{ headingTitle }}</h5>
            <div class="text-muted small">{{ headingSubtitle }}</div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        {{ form_errors(projectForm) }}

        <div class="mb-3">
            {{ form_label(projectForm.name) }} <span class="text-danger">*</span>
            {{ form_widget(projectForm.name, { attr: { class: 'form-control', placeholder: 'e.g. Q4 Marketing Campaign' } }) }}
            {{ form_errors(projectForm.name) }}
        </div>

        <div class="mb-3">
            {{ form_label(projectForm.description) }}
            {{ form_widget(projectForm.description, { attr: { class: 'form-control', placeholder: 'Describe the goals and scope of this project...' } }) }}
            {{ form_errors(projectForm.description) }}
        </div>

        <div class="row g-3">
            <div class="col-12 col-md-6">
                {{ form_label(projectForm.start_date) }} <span class="text-danger">*</span>
                {{ form_widget(projectForm.start_date, { attr: { class: 'form-control' } }) }}
                {{ form_errors(projectForm.start_date) }}
            </div>
            <div class="col-12 col-md-6">
                {{ form_label(projectForm.end_date) }} <span class="text-danger">*</span>
                {{ form_widget(projectForm.end_date, { attr: { class: 'form-control' } }) }}
                {{ form_errors(projectForm.end_date) }}
            </div>
        </div>

        <div class="mt-4">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                <div>
                    <div class="fw-semibold">AI Task Suggestions</div>
                    <div class="text-muted small">Generate 5 starter tasks from the project brief before saving.</div>
                </div>
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-ai-suggest-btn="1"
                        data-ai-suggest-url="{{ path('app_project_ai_task_suggestions') }}">
                    <i class="ri-magic-line me-1"></i> Suggest 5 Tasks
                </button>
            </div>
            <div class="text-muted small mb-3" data-ai-suggest-status="1"></div>
            <div class="d-flex flex-column gap-2" data-ai-suggestions-list="1"></div>
        </div>

        {% include 'project/_team_dropdown.html.twig' with {
            teamForm: projectForm,
            teamUsers: assignableUsers|default([]),
            teamLabel: 'Assign Team'
        } %}
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary nexum-btn-primary text-white">{{ submitLabel }}</button>
    </div>

    {{ form_end(projectForm) }}
</div>
