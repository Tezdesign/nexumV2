{% set draftStatus = (draft.status ?? 'PENDING')|upper %}
{% set statusColorClass = '' %}
{% if draftStatus == 'APPROVED' %}
    {% set statusColorClass = 'text-success border-success bg-success-subtle' %}
{% elseif draftStatus == 'REJECTED' %}
    {% set statusColorClass = 'text-danger border-danger bg-danger-subtle' %}
{% else %}
    {% set statusColorClass = 'text-warning border-warning bg-warning-subtle' %}
{% endif %}

{% set cb = draft.createdBy ?? null %}
{% set u = cb is not null ? (usersById[cb.id] ?? null) : null %}
{% set fullName = u ? ((u.prenom ~ ' ' ~ u.nom)|trim|plain_text) : 'Unknown' %}
{% set budgetName = draft.projectBudgetRelated ? draft.projectBudgetRelated.name|plain_text : 'Unknown Budget' %}
{% set subjectText = draft.subject|default('No Subject')|plain_text %}

<div class="nexum-draft-item border-bottom border-light" data-search-content="{{ draft.description|plain_text|lower }} {{ draft.category|plain_text|lower }} {{ budgetName|lower }} {{ subjectText|lower }} {{ fullName|lower }}">
    
    {# The main flex row #}
    <div class="nexum-row border-0">
        <div class="nexum-row-left d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-link p-0 text-decoration-none text-muted" type="button" data-bs-toggle="collapse" data-bs-target="#draftCollapse{{ draft.id }}" aria-expanded="false" aria-controls="draftCollapse{{ draft.id }}">
                <i class="ri-arrow-down-s-line fs-5"></i>
            </button>
            
            <div class="d-flex flex-column">
                <span class="fw-bold text-truncate text-dark" style="max-width: 250px;" title="{{ subjectText }}">
                    {{ subjectText }}
                </span>
                <span class="text-muted small text-truncate" style="max-width: 250px;" title="{{ budgetName }} &bull; {{ draft.category|plain_text }}">
                    {{ budgetName }} &bull; {{ draft.category|plain_text }}
                </span>
            </div>
        </div>

        <div class="nexum-meta d-flex align-items-center gap-3">
            <span class="fw-bold {{ draft.amount < 0 ? 'text-danger' : '' }}">
                {{ currency_symbol|default('$') }}{{ draft.amount|number_format(2, '.', ',') }}
            </span>

            <span class="badge border {{ statusColorClass }}">
                {{ draftStatus }}
            </span>

            <span class="d-inline-flex align-items-center gap-1 text-muted small" title="Created Date">
                <i class="ri-calendar-line"></i>
                <span>{{ draft.createdAt ? draft.createdAt|date('d M Y') : '—' }}</span>
            </span>

            {% if u %}
                {% set ap = avatar_placeholder(fullName) %}
                <span class="nexum-assignee" title="Created by {{ fullName }}">
                    <span class="nexum-assignee-dot" style="background: {{ ap.bg }}; color: {{ ap.fg }};">
                        {{ ap.initial }}
                    </span>
                    <span class="d-none d-sm-inline">{{ fullName }}</span>
                </span>
            {% else %}
                <span class="nexum-assignee is-empty">Unknown</span>
            {% endif %}
            
            <div class="d-flex align-items-center gap-1">
                <button type="button" class="nexum-icon-btn" title="Edit Draft" aria-label="Edit Draft">
                    <i class="ri-pencil-line"></i>
                </button>
                <button type="button" class="nexum-icon-btn" title="Delete Draft" aria-label="Delete Draft">
                    <i class="ri-delete-bin-line"></i>
                </button>
            </div>
        </div>
    </div>
    
    {# The collapsible body, located OUTSIDE the flex row so it drops down fully #}
    <div class="collapse w-100" id="draftCollapse{{ draft.id }}">
        <div class="p-3 pt-0 ms-4">
            <div class="card card-body bg-light border-0 p-3 shadow-none">
                
                {# Description rendering safely as HTML inside Quill's styling #}
                <div class="ql-editor p-0 text-break fs-14">
                    {{ draft.description|raw }}
                </div>
                
                {# Static Rejection Area #}
                <div class="mt-3 pt-3 border-top border-dashed">
                    <h6 class="mb-1 text-danger fs-13">
                        <i class="ri-error-warning-line me-1"></i>Rejection Reason
                    </h6>
                    <p class="mb-0 text-muted fs-13">This draft has not been examined yet.</p>
                </div>
                
            </div>
        </div>
    </div>
</div>