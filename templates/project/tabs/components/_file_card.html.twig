{% set fileName = file.originalName|default(file.original_name|default(file.name|default('Untitled file'))) %}
{% set fileUrl = file.secureUrl|default(file.secure_url|default(file.url|default('#'))) %}
{% set uploaderName = file.uploadedByName|default(file.uploaded_by_name|default(file.uploader_name|default('Unknown uploader'))) %}
{% set extension = file.extension|default(file.format|default(file.type|default('FILE')))|upper %}
{% set uploadedAt = file.createdAt|default(file.created_at|default(file.uploaded_at|default(null))) %}
{% set sizeLabel = file.sizeLabel|default(file.size_label|default(file.bytes is defined and file.bytes ? (file.bytes ~ ' bytes') : null)) %}

<article class="project-file-card">
    <div class="project-file-card__main">
        <div class="project-file-card__icon">{{ extension|slice(0, 4) }}</div>
        <div class="project-file-card__content min-w-0">
            <div class="project-file-card__name">{{ fileName|plain_text }}</div>
            <div class="project-file-card__meta">
                <span>{{ uploaderName|plain_text }}</span>
                {% if uploadedAt %}
                    <span>•</span>
                    <span>{{ uploadedAt|date('M d, Y') }}</span>
                {% endif %}
                {% if sizeLabel %}
                    <span>•</span>
                    <span>{{ sizeLabel }}</span>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="project-file-card__actions">
        <a class="btn btn-sm btn-outline-secondary"
           href="{{ fileUrl }}"
           {% if fileUrl != '#' %}target="_blank" rel="noopener"{% endif %}>
            Open
        </a>
    </div>
</article>
