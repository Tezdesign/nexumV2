<div class="card nexum-shell-card">
    <div class="card-body d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Tasks</h5>
        {% if canCreateTask|default(false) %}
            <button class="nexum-icon-btn"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#createTaskModal"
                    title="Add task"
                    aria-label="Add task">
                <i class="ri-add-line"></i>
            </button>
        {% endif %}
    </div>
    <div class="card-body pt-0">
        {% for task in (tasks|default([]))|slice(0, 50) %}
            {% include 'task/_task_card.html.twig' with {
                task: task,
                currentUserId: currentUserId,
                isManager: isManager,
                usersById: membersById,
                avatarUrlById: avatarUrlById,
                projectName: project.name|default(''),
                taskUrl: path('app_task_show', {id: task.id})
            } %}
        {% else %}
            <div class="text-muted small py-2">No tasks for this project yet.</div>
        {% endfor %}
    </div>
</div>
