{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Financial Analysis'|trans %}

{% block css %}
    <meta name="turbo-visit-control" content="reload">
    <!-- Tabler Icons Webfont (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">

    <link href="/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />

    <link href="/vendor/nouislider/nouislider.min.css" rel="stylesheet" type="text/css" />

    <link href="/css/FA.css?v={{ random() }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
    <div class="container-fluid pt-4" data-turbo="false">
        <!-- Breadcrumb -->
        <div class="row align-items-center mb-3">
            <div class="col-12 d-flex justify-content-between align-items-center">
                <div class="page-title-box mb-0 flex-shrink-1">
                    <h4 class="page-title m-0">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ol class="breadcrumb m-0 p-0 bg-transparent align-items-center">
                                <li class="breadcrumb-item">
                                    <a href="{{ path('apps-financial-analysis-landing') }}" class="text-dark text-decoration-none">
                                        <i class="ti ti-smart-home fs-16 me-1"></i>{{ 'Fiscal Budget Profiles'|trans }}
                                    </a>
                                </li>
                                <li class="breadcrumb-item active text-muted" aria-current="page">{{ 'FY'|trans }} {{ budgetProfile.fiscalYear }} {{ 'Dashboard'|trans }}</li>
                            </ol>
                        </nav>
                    </h4>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap justify-content-end flex-grow-1">
                    <span class="text-muted fs-14 text-nowrap fw-medium me-3 d-flex align-items-center">
                        <a href="javascript:void(0);" id="btn-reset-currency" class="text-muted me-2" title="{{ 'Reset Currency'|trans }}"><i class="ti ti-refresh fs-16"></i></a>
                        <i class="ti ti-cash fs-18 me-1 "></i>{{ 'Base Currency:'|trans }}&nbsp;<strong class="text-dark me-2" id="current-currency-display">{{ budgetProfile.baseCurrency|default('N/A') }}</strong>
                        <i class="ti ti-link fs-16 me-1 text-primary " title="{{ 'Live Exchange Rates'|trans }}"></i>
                        <div style="width: 150px" >
                        <select id="currency-exchange-select" class="form-select form-select-sm w-100" >
                            <!-- Options populated via JS -->
                        </select>
                        </div>
                    </span>
                    <button type="button" class="btn btn-outline-primary rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#updateProfileModal">
                        <i class="ti ti-pencil me-1"></i> {{ 'Edit Profile'|trans }}
                    </button>
                    <button type="button" class="btn btn-outline-danger rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#deleteBudgetProfileModal">
                        <i class="ti ti-trash me-1"></i> {{ 'Delete Profile'|trans }}
                    </button>
                </div>
            </div>
        </div>

        <!-- 5 KPI Widgets Row -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-5">
            
            <!-- Widget 1: Total Budget -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Total Budget'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-{{ kpi_budget_class|default('success') }} rounded-pill fs-13">{{ kpi_budget_badge|default('0%') }}
                                <i class="{{ kpi_budget_icon|default('ti ti-trending-up') }}"></i>
                            </span>
                            <div class="text-end">
                                <h3 class="fw-semibold kpi-value" data-raw-value="{{ budgetProfile.budgetDisposable }}"><span class="kpi-symbol">{{ currency_symbol|default('$') }}</span><span class="kpi-number">{{ kpi_budget_value|default('0.00') }}</span></h3>
                                <p class="text-muted mb-0">{{ kpi_budget_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-success" role="progressbar" style="width: {{ kpi_budget_progress|default('0') }}%" aria-valuenow="{{ kpi_budget_progress|default('0') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 2: Total Spending -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Total Spending'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-{{ kpi_spending_class|default('danger') }} rounded-pill fs-13">{{ kpi_spending_badge|default('0%') }}
                                <i class="{{ kpi_spending_icon|default('ti ti-trending-up') }}"></i>
                            </span>
                            <div class="text-end">
                                {% set raw_spending = budgetProfile.totalExpense|default(0) %}
                                <h3 class="fw-semibold kpi-value" data-raw-value="{{ raw_spending }}"><span class="kpi-symbol">{{ currency_symbol|default('$') }}</span><span class="kpi-number">{{ kpi_spending_value|default('0.00') }}</span></h3>
                                <p class="text-muted mb-0">{{ kpi_spending_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: {{ kpi_spending_progress|default('0') }}%" aria-valuenow="{{ kpi_spending_progress|default('0') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 3: Remaining Budget -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Remaining Budget'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-{{ kpi_remaining_class|default('info') }} rounded-pill fs-13">{{ kpi_remaining_badge|default('0%') }}
                                <i class="{{ kpi_remaining_icon|default('ti ti-trending-down') }}"></i>
                            </span>
                            <div class="text-end">
                                {% set raw_remaining = budgetProfile.budgetDisposable - raw_spending %}
                                <h3 class="fw-semibold kpi-value" data-raw-value="{{ raw_remaining }}"><span class="kpi-symbol">{{ currency_symbol|default('$') }}</span><span class="kpi-number">{{ kpi_remaining_value|default('0.00') }}</span></h3>
                                <p class="text-muted mb-0">{{ kpi_remaining_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-info" role="progressbar" style="width: {{ kpi_remaining_progress|default('0') }}%" aria-valuenow="{{ kpi_remaining_progress|default('0') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 4: Customer Satisfaction -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Utilization'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-{{ kpi_utilization_class|default('primary') }} rounded-pill fs-13">{{ kpi_utilization_badge|default('0%') }}
                                <i class="{{ kpi_utilization_icon|default('ti ti-trending-up') }}"></i>
                            </span>
                            <div class="text-end">
                                <h3 class="fw-semibold">{{ kpi_utilization_value|default('0%') }}</h3>
                                <p class="text-muted mb-0">{{ kpi_utilization_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: {{ kpi_utilization_progress|default('0') }}%" aria-valuenow="{{ kpi_utilization_progress|default('0') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 5: New Users -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Cash Flow'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'X/100'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-end gap-2 justify-content-between">
                            <div class="text-end flex-shrink-0">
                                <div id="chart-two" data-colors="#f9c851,#F6F7FB"></div>
                            </div>
                            <div class="text-end">
                                {% set raw_allocated = 0 %}
                                {% set raw_cashflow = budgetProfile.budgetDisposable - raw_allocated %}
                                <h3 class="fw-semibold kpi-value" data-raw-value="{{ raw_cashflow }}"><span class="kpi-symbol">{{ currency_symbol|default('$') }}</span><span class="kpi-number">{{ kpi_cashflow_value|default('0.00') }}</span>
                                    {% if kpi_cashflow_badge|default('0%') != '0%' %}
                                        <span class="badge badge-soft-{{ kpi_cashflow_class|default('warning') }} rounded-pill fs-11 ms-1">
                                            {{ kpi_cashflow_badge }} <i class="{{ kpi_cashflow_icon|default('ti ti-trending-up') }}"></i>
                                        </span>
                                    {% endif %}
                                </h3>
                                <p class="text-muted mb-0">{{ kpi_cashflow_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


        </div> <!-- end row -->

        <!-- Project Budgets Section -->
        <div class="row mt-4">
            <div class="col-12 col-lg-9 col-xl-8">
                {% include 'financial-analysis/FA_components/_project_budget_action_bar.html.twig' %}
                
                <!-- Project Budgets Display -->
                {% if projects is empty %}
                    <!-- Empty State: No Projects Found -->
                    <div class="row justify-content-center align-items-center mt-4">
                        <div class="col-md-10">
                            <div class="card text-center bg-transparent shadow-none">
                                <div class="card-body p-5">
                                    <div class="mb-4">
                                        <i class="ti ti-calendar-off text-muted opacity-50" style="font-size: 5rem;"></i>
                                    </div>
                                    <h4 class="mt-3 mb-2 fw-semibold">{{ 'No Project Budgets Found'|trans }}</h4>
                                    <p class="text-muted mb-4 fs-14">
                                        {{ 'There are no active project budgets that fall within the scope of this Fiscal Year ('|trans }}{{ budgetProfile.startDate|date('Y-m-d') }} to {{ budgetProfile.endDate|date('Y-m-d') }}).
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <!-- Grid View Container -->
                    <div id="project-grid-view" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                        {% for project in projects %}
                            <div class="col">
                                {% include 'financial-analysis/FA_components/_project_budget_card.html.twig' with {'project': project} %}
                            </div>
                        {% endfor %}
                    </div>

                    <!-- List View Container (Hidden by default) -->
                    <div id="project-list-view" class="d-none">
                        {% for project in projects %}
                            {% include 'financial-analysis/FA_components/_project_budget_list_row.html.twig' with {'project': project} %}
                        {% endfor %}
                    </div>

                    <!-- Live Search Empty State (Hidden by default) -->
                    <div id="project-search-empty-state" class="row justify-content-center align-items-center mt-2 d-none">
                        <div class="col-md-10">
                            <div class="card text-center bg-transparent shadow-none">
                                <div class="card-body p-4">
                                    <div class="mb-3">
                                        <i class="ti ti-search text-muted opacity-50" style="font-size: 4rem;"></i>
                                    </div>
                                    <h5 class="mt-2 mb-1 fw-semibold">{{ 'No matches found'|trans }}</h5>
                                    <p class="text-muted mb-0 fs-13">
                                        {{ 'Try adjusting your search term.'|trans }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
                
                <!-- End Project Budgets Section -->
            </div>
            
            <!-- Data Widgets (Right Side) -->
            <div class="col-12 col-lg-3 col-xl-4">
                <div class="row row-cols-1 row-cols-md-2 g-3">
                    <div class="col">
                        <div class="card h-100 mb-0">
                            <div class="card-body widget-user">
                                <div class="text-center">
                                    <h2 class="fw-normal text-primary">{{ totalBudgetsCount|default(0) }}</h2>
                                    <p class="mb-0 fw-semibold fs-13">{{ 'Total Budgets'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 mb-0">
                            <div class="card-body widget-user">
                                <div class="text-center">
                                    <h2 class="text-danger">{{ uniqueProjectsCount|default(0) }}</h2>
                                    <p class="mb-0 fw-semibold fs-13">{{ 'Unique Projects'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 mb-0">
                            <div class="card-body widget-user">
                                <div class="text-center">
                                    <h2 class="fw-semibold text-warning">{{ topProjectData.budgetCount|default(0) }}</h2>
                                    <p class="mb-0 fw-semibold fs-13">{{ 'Top Project:'|trans }}<br><span class="text-muted fw-normal">{{ topProjectData.projectName|default('N/A') }}</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 mb-0">
                            <div class="card-body widget-user">
                                <div class="text-center">
                                    <h2 class="text-info">{{ projectsWithoutBudgetCount|default(0) }}</h2>
                                    <p class="mb-0 fw-semibold fs-13">{{ 'Without Budget'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 mb-0">
                            <div class="card-body widget-user">
                                <div class="text-center">
                                    <h2 class="text-success">{{ totalTransactionsCount|default(0) }}</h2>
                                    <p class="mb-0 fw-semibold fs-13">{{ 'Transactions'|trans }}</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="card h-100 mb-0">
                            <div class="card-body widget-user">
                                <div class="text-center">
                                    <h2 class="fw-semibold text-primary">{{ bestProjectData.score|default(0)|number_format(1) }}</h2>
                                    <p class="mb-0 fw-semibold fs-13">{{ 'Best Performer:'|trans }}<br><span class="text-muted fw-normal">{{ bestProjectData.name|default('N/A') }}</span></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Charts Section (Bottom) -->
        <div class="row mt-4">
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header border-bottom border-dashed d-flex align-items-center">
                        <h4 class="header-title m-0">{{ 'Historical Fiscal Year Comparison'|trans }}</h4>
                    </div>
                    <div class="card-body">
                        <div id="historical-bar-chart" class="apex-charts" data-colors="#5b69bc,#10c469"></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card h-100">
                    <div class="card-header border-bottom border-dashed d-flex align-items-center">
                        <h4 class="header-title m-0">{{ 'Project Progression vs Spending'|trans }}</h4>
                    </div>
                    <div class="card-body">
                        <div id="progression-column-chart" class="apex-charts" data-colors="#39afd1,#ff5b5b"></div>
                    </div>
                </div>
            </div>
        </div>

    </div> <!-- end container -->

    {% include 'financial-analysis/FA_components/_update_profile_modal.html.twig' %}
    {% include 'financial-analysis/FA_components/_create_project_budget_modal.html.twig' %}
    {% include 'financial-analysis/FA_components/_delete_budget_profile_modal.html.twig' %}
{% endblock %}

{% block script %}
    <!-- Flatpickr js -->
    <script src="/vendor/flatpickr/flatpickr.min.js"></script>

    <!-- Select2 js -->
    <script src="/vendor/select2/js/select2.min.js"></script>

    <!-- Apex Chart js -->
    <script src="/vendor/apexcharts/apexcharts.min.js"></script>

    <!-- Widgets js -->
    <script src="/js/pages/widgets.js"></script>

    <!-- NoUiSlider js -->
    <script src="/vendor/nouislider/nouislider.min.js"></script>
    <script src="/vendor/wnumb/wNumb.min.js"></script>

    <!-- Custom FA JS Logic -->
    <script src="/js/FA_custom.js?v={{ random() }}"></script>
    <script src="/js/FA_functions.js?v={{ random() }}"></script>
    <script src="/js/FA_PBfunctions.js?v={{ random() }}"></script>

    <script>
        $(document).ready(function() {
            // Initialize Select2 for Fiscal Year
            if ($('[data-toggle="select2"]').length) {
                $('[data-toggle="select2"]').select2();
            }

            // Initialize Currency Exchange
            initializeCurrencyExchange('#currency-exchange-select', {{ budgetProfile.id }}, '{{ budgetProfile.baseCurrency|default('TND') }}');

            // Initialize Historical Bar Chart
            var historicalData = {{ historicalData|json_encode|raw }};
            if (historicalData && historicalData.length > 0 && $("#historical-bar-chart").length > 0) {
                var colors = ["#5b69bc", "#10c469"];
                var dataColors = $("#historical-bar-chart").data('colors');
                if (dataColors) {
                    colors = dataColors.split(",");
                }

                var categories = historicalData.map(d => d.year);
                var allocatedData = historicalData.map(d => d.allocated);
                var spentData = historicalData.map(d => d.spent);

                var options = {
                    chart: {
                        height: 380,
                        type: 'bar',
                        toolbar: { show: false }
                    },
                    plotOptions: {
                        bar: {
                            horizontal: false,
                            columnWidth: '55%',
                            endingShape: 'rounded'
                        },
                    },
                    dataLabels: { enabled: false },
                    stroke: {
                        show: true,
                        width: 2,
                        colors: ['transparent']
                    },
                    series: [{
                        name: 'Allocated',
                        data: allocatedData
                    }, {
                        name: 'Spent',
                        data: spentData
                    }],
                    colors: colors,
                    xaxis: {
                        categories: categories,
                    },
                    yaxis: {
                        title: { text: 'Amount' },
                        labels: {
                            formatter: function (value) {
                                return window.faCurrentSymbol ? window.faCurrentSymbol + value.toFixed(0) : value.toFixed(0);
                            }
                        }
                    },
                    fill: { opacity: 1 },
                    tooltip: {
                        y: {
                            formatter: function (val) {
                                return window.faCurrentSymbol ? window.faCurrentSymbol + val.toFixed(2) : val.toFixed(2);
                            }
                        }
                    }
                };

                window.historicalBarChart = new ApexCharts(
                    document.querySelector("#historical-bar-chart"),
                    options
                );
                window.historicalBarChart.render();
            }

            // Initialize Progression Column Chart
            var progressionData = {{ progressionData|json_encode|raw }};
            if (progressionData && progressionData.length > 0 && $("#progression-column-chart").length > 0) {
                var progColors = ["#39afd1", "#ff5b5b"];
                var progDataColors = $("#progression-column-chart").data('colors');
                if (progDataColors) {
                    progColors = progDataColors.split(",");
                }

                var projCategories = progressionData.map(d => d.projectName);
                
                // Calculate Spending % (utilization)
                var spendingPercentData = progressionData.map(d => {
                    var total = parseFloat(d.total) || 0;
                    var spent = parseFloat(d.spent) || 0;
                    if (total > 0) {
                        return parseFloat(((spent / total) * 100).toFixed(1));
                    }
                    return 0;
                });
                
                // Project Progress %
                var progressPercentData = progressionData.map(d => parseFloat(d.progress) || 0);

                var progOptions = {
                    chart: {
                        height: 380,
                        type: 'bar',
                        toolbar: { show: false }
                    },
                    plotOptions: {
                        bar: {
                            horizontal: false,
                            columnWidth: '55%',
                            endingShape: 'rounded'
                        },
                    },
                    dataLabels: { enabled: false },
                    stroke: {
                        show: true,
                        width: 2,
                        colors: ['transparent']
                    },
                    series: [{
                        name: 'Work Progress %',
                        data: progressPercentData
                    }, {
                        name: 'Budget Spent %',
                        data: spendingPercentData
                    }],
                    colors: progColors,
                    xaxis: {
                        categories: projCategories,
                    },
                    yaxis: {
                        title: { text: 'Percentage (%)' },
                        max: 100,
                        labels: {
                            formatter: function (value) {
                                return value + "%";
                            }
                        }
                    },
                    fill: { opacity: 1 },
                    tooltip: {
                        y: {
                            formatter: function (val) {
                                return val + "%";
                            }
                        }
                    }
                };

                window.progressionColumnChart = new ApexCharts(
                    document.querySelector("#progression-column-chart"),
                    progOptions
                );
                window.progressionColumnChart.render();
            }

            window.updateChartCurrencies = function(rate, symbol) {
                window.faCurrentSymbol = symbol;
                
                if (window.historicalBarChart && historicalData) {
                    var convertedAllocated = historicalData.map(d => d.allocated * rate);
                    var convertedSpent = historicalData.map(d => d.spent * rate);
                    
                    window.historicalBarChart.updateSeries([{
                        name: 'Allocated',
                        data: convertedAllocated
                    }, {
                        name: 'Spent',
                        data: convertedSpent
                    }]);
                }
            };
        });
    </script>
{% endblock %}


