{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Financial Analysis'|trans %}

{% block css %}
    <!-- Tabler Icons Webfont (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    
    <!-- Select2 css -->
    <link href="/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
    
    <!-- Custom FA css -->
    <link href="/css/FA.css" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
    <div class="container-fluid pt-4">
        <!-- Title & Fiscal Year Selector -->
        <div class="row align-items-center mb-3">
            <div class="col-12 d-flex align-items-center justify-content-between">
                <div class="page-title-box mb-0">
                    <h4 class="page-title m-0">{{ 'Financial Overview'|trans }}</h4>
                </div>
                <div class="d-inline-flex align-items-center">
                    <label for="fiscalYearSelect" class="me-2 fw-semibold text-muted mb-0">{{ 'Fiscal Year:'|trans }}</label>
                    <div style="min-width: 150px; text-align: left;">
                        <select id="fiscalYearSelect" class="form-control select2" data-toggle="select2">
                            <option value="">{{ 'Select Year'|trans }}</option>
                            <optgroup label="{{ '2020s'|trans }}">
                                <option value="2026" selected>2026</option>
                                <option value="2025">2025</option>
                                <option value="2024">2024</option>
                            </optgroup>
                            <optgroup label="{{ '2010s'|trans }}">
                                <option value="2019">2019</option>
                                <option value="2018">2018</option>
                            </optgroup>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5 KPI Widgets Row -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-5">
            
            <!-- Widget 1: Total Budget -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Total Budget'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-success rounded-pill fs-13">{{ kpi_budget_badge|default('32%') }}
                                <i class="ti ti-trending-up"></i>
                            </span>
                            <div class="text-end">
                                <h3 class="fw-semibold">{{ currency_symbol|default('$') }}{{ kpi_budget_value|default('5.42M') }}</h3>
                                <p class="text-muted mb-0">{{ kpi_budget_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-success" role="progressbar" style="width: {{ kpi_budget_progress|default('25') }}%" aria-valuenow="{{ kpi_budget_progress|default('25') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 2: Total Spending -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Total Spending'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-danger rounded-pill fs-13">{{ kpi_spending_badge|default('12%') }}
                                <i class="ti ti-trending-up"></i>
                            </span>
                            <div class="text-end">
                                <h3 class="fw-semibold">{{ currency_symbol|default('$') }}{{ kpi_spending_value|default('1.20M') }}</h3>
                                <p class="text-muted mb-0">{{ kpi_spending_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: {{ kpi_spending_progress|default('45') }}%" aria-valuenow="{{ kpi_spending_progress|default('45') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 3: Remaining Budget -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Remaining Budget'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-info rounded-pill fs-13">{{ kpi_remaining_badge|default('5.7%') }}
                                <i class="ti ti-trending-down"></i>
                            </span>
                            <div class="text-end">
                                <h3 class="fw-semibold">{{ currency_symbol|default('$') }}{{ kpi_remaining_value|default('4.22M') }}</h3>
                                <p class="text-muted mb-0">{{ kpi_remaining_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-info" role="progressbar" style="width: {{ kpi_remaining_progress|default('75') }}%" aria-valuenow="{{ kpi_remaining_progress|default('75') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 4: Customer Satisfaction -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Utilization'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'As percentile'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-center gap-2 justify-content-between">
                            <span class="badge badge-soft-primary rounded-pill fs-13">{{ kpi_utilization_badge|default('2.1%') }}
                                <i class="ti ti-trending-up"></i>
                            </span>
                            <div class="text-end">
                                <h3 class="fw-semibold">{{ kpi_utilization_value|default('94.3%') }}</h3>
                                <p class="text-muted mb-0">{{ kpi_utilization_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>

                        <div class="progress progress-soft progress-sm mt-3">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: {{ kpi_satisfaction_progress|default('94.3') }}%" aria-valuenow="{{ kpi_satisfaction_progress|default('94.3') }}" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Widget 5: New Users -->
            <div class="col">
                <div class="card">
                    <div class="d-flex card-header justify-content-between align-items-center">
                        <div>
                            <h4 class="header-title">{{ 'Cash Flow'|trans }}</h4>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="ri-more-2-fill fs-18"></i>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'X/100'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Raw Numbers'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Time Frame'|trans }}</a>
                                <a href="javascript:void(0);" class="dropdown-item">{{ 'Action'|trans }}</a>
                            </div>
                        </div>
                    </div>

                    <div class="card-body pt-0">
                        <div class="d-flex align-items-end gap-2 justify-content-between">
                            <div class="text-end flex-shrink-0">
                                <div id="chart-two" data-colors="#f9c851,#F6F7FB"></div>
                            </div>
                            <div class="text-end">
                                <h3 class="fw-semibold">{{ kpi_cashflow_value|default('45.3k') }}</h3>
                                <p class="text-muted mb-0">{{ kpi_cashflow_subtitle|default('Since last month'|trans) }}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div> <!-- end row -->

        <!-- Project Budgets Section -->
        <div class="row mt-4">
            <div class="col-12 col-lg-9 col-xl-8">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="header-title m-0">{{ 'Project Budgets'|trans }}</h4>
                    <div class="d-flex gap-2 align-items-center p-2 rounded" style="background-color: var(--ct-secondary-bg-subtle, rgba(91, 105, 188, 0.1));">
                        <!-- Search Bar (Styled like topbar) -->
                        <div class="app-search d-none d-lg-block">
                            <form>
                                <div class="position-relative">
                                    <input type="search" class="form-control border-0" style="background-color: var(--ct-body-bg, #fff); border-radius: 20px; padding-left: 35px; box-shadow: none;" placeholder="{{ 'Search...'|trans }}" id="top-search">
                                    <i class="ri-search-line fs-18 position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                                </div>
                            </form>
                        </div>
                        
                        <!-- Toggle Buttons (Smaller, Light Purple) -->
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-sm" style="background-color: rgba(91, 105, 188, 0.15); color: var(--ct-secondary, #5b69bc); border-color: transparent;" id="btn-grid-view"><i class="ri-grid-fill fs-16"></i></button>
                            <button type="button" class="btn btn-sm" style="background-color: transparent; color: var(--ct-secondary, #5b69bc); border-color: rgba(91, 105, 188, 0.15);" id="btn-list-view"><i class="ri-list-check fs-16"></i></button>
                        </div>
                    </div>
                </div>
                
                <!-- Mock Data Array (Until Controller provides it) -->
                {% set projects = [
                    {id: 1, name: 'Project Alpha', subtitle: 'Web Development', status: 'ON TRACK', totalBudget: '120.5k', actualSpend: '45.2k', remaining: '75.3k', dueDate: '2026-10-15'},
                    {id: 2, name: 'Project Beta', subtitle: 'Mobile App', status: 'AT RISK', totalBudget: '85.0k', actualSpend: '70.0k', remaining: '15.0k', dueDate: '2026-06-30'},
                    {id: 3, name: 'Project Gamma', subtitle: 'Marketing Campaign', status: 'OVERBUDGET', totalBudget: '50.0k', actualSpend: '55.0k', remaining: '-5.0k', dueDate: '2026-05-12'},
                    {id: 4, name: 'Project Delta', subtitle: 'Infrastructure', status: 'ON TRACK', totalBudget: '200.0k', actualSpend: '10.0k', remaining: '190.0k', dueDate: '2027-01-01'},
                    {id: 5, name: 'Project Epsilon', subtitle: 'Cloud Migration', status: 'ON TRACK', totalBudget: '300.0k', actualSpend: '150.0k', remaining: '150.0k', dueDate: '2026-11-20'},
                    {id: 6, name: 'Project Zeta', subtitle: 'Data Warehouse', status: 'AT RISK', totalBudget: '150.0k', actualSpend: '140.0k', remaining: '10.0k', dueDate: '2026-07-15'},
                    {id: 7, name: 'Project Eta', subtitle: 'Security Audit', status: 'ON TRACK', totalBudget: '40.0k', actualSpend: '10.0k', remaining: '30.0k', dueDate: '2026-09-01'}
                ] %}

                <!-- Grid View Container -->
                <div id="project-grid-view" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                    {% for project in projects|slice(0, 6) %}
                        <div class="col">
                            {% include 'financial-analysis/FA_components/_project_budget_card.html.twig' with {'project': project} %}
                        </div>
                    {% endfor %}
                </div>

                <!-- List View Container (Hidden by default) -->
                <div id="project-list-view" class="d-none">
                    {% for project in projects|slice(0, 6) %}
                        {% include 'financial-analysis/FA_components/_project_budget_list_row.html.twig' with {'project': project} %}
                    {% endfor %}
                </div>
                
                <!-- End Project Budgets Section -->
            </div>
        </div>

    </div> <!-- end container -->
{% endblock %}

{% block script %}
    <!-- Select2 js -->
    <script src="/vendor/select2/js/select2.min.js"></script>

    <!-- Apex Chart js -->
    <script src="/vendor/apexcharts/apexcharts.min.js"></script>

    <!-- Widgets js -->
    <script src="/js/pages/widgets.js"></script>

    <script>
        $(document).ready(function() {
            // Initialize Select2 for Fiscal Year
            if ($('[data-toggle="select2"]').length) {
                $('[data-toggle="select2"]').select2();
            }

            // Grid/List View Toggle Logic
            const activeStyle = 'background-color: rgba(91, 105, 188, 0.15); color: var(--ct-secondary, #5b69bc); border-color: transparent;';
            const inactiveStyle = 'background-color: transparent; color: var(--ct-secondary, #5b69bc); border-color: rgba(91, 105, 188, 0.15);';

            $('#btn-grid-view').on('click', function() {
                $(this).attr('style', activeStyle);
                $('#btn-list-view').attr('style', inactiveStyle);
                $('#project-grid-view').removeClass('d-none');
                $('#project-list-view').addClass('d-none');
            });

            $('#btn-list-view').on('click', function() {
                $(this).attr('style', activeStyle);
                $('#btn-grid-view').attr('style', inactiveStyle);
                $('#project-list-view').removeClass('d-none');
                $('#project-grid-view').addClass('d-none');
            });
        });
    </script>
{% endblock %}


{% block footer %}{% endblock %}