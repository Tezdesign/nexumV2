{% extends 'base.html.twig' %}

{% block title %}BudgetProfile{% endblock %}

{% block body %}
    <h1>BudgetProfile</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ budget_profile.id }}</td>
            </tr>
            <tr>
                <th>Fiscal_year</th>
                <td>{{ budget_profile.fiscalYear }}</td>
            </tr>
            <tr>
                <th>Budget_disposable</th>
                <td>{{ budget_profile.budgetDisposable }}</td>
            </tr>
            <tr>
                <th>Total_expense</th>
                <td>{{ budget_profile.totalExpense }}</td>
            </tr>
            <tr>
                <th>Margin_profit</th>
                <td>{{ budget_profile.marginProfit }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_financial_analysis_budget_profile_index') }}">back to list</a>

    <a href="{{ path('app_financial_analysis_budget_profile_edit', {'id': budget_profile.id}) }}">edit</a>

    {{ include('financial_analysis/budget_profile/_delete_form.html.twig') }}
{% endblock %}
