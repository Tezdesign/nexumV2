<div class="d-flex flex-column bg-white rounded shadow-sm p-3 mb-3">
    <!-- Header Row -->
    <div class="d-flex justify-content-between align-items-start border-bottom pb-2 mb-3">
        <div>
            <h4 class="m-0 fw-semibold text-dark">{{ 'AI Projection Results'|trans }}</h4>
            <p class="text-muted fs-13 m-0">{{ 'Based on local Gemma predictive modeling.'|trans }}</p>
        </div>
        <div>
            <span id="res-risk-badge"></span>
            <button class="btn btn-soft-secondary btn-sm rounded-pill ms-2" id="btn-rerun-ai">
                <i class="ti ti-refresh me-1"></i> {{ 'Rerun'|trans }}
            </button>
        </div>
    </div>

    <!-- Main Content Row -->
    <div class="d-flex flex-row align-items-center">
        <!-- Column 1 -->
        <div class="d-flex flex-column align-items-center justify-content-center border-end px-3" style="width: 33.33%;">
            <span class="text-muted fs-13 text-uppercase fw-semibold mb-2">{{ 'Projected Variance'|trans }}</span>
            <span id="res-variance" class="fs-2 fw-bold text-dark">--</span>
            <span id="res-variance-sub" class="text-muted fs-12 mt-1">--</span>
        </div>

        <!-- Column 2 -->
        <div class="px-4" style="width: 33.33%;">
            <div class="row g-3">
                <div class="col-6">
                    <p class="text-muted mb-1 fs-12">{{ 'Projected Total'|trans }}</p>
                    <h5 class="m-0 fw-semibold text-dark" id="res-total">--</h5>
                </div>
                <div class="col-6">
                    <p class="text-muted mb-1 fs-12">{{ 'Allocated Budget'|trans }}</p>
                    <h5 class="m-0 fw-semibold text-dark"><span class="currency-value" data-raw-value="{{ projectBudgetEntity.totalBudget }}"><span class="currency-symbol">{{ currency_symbol|default('$') }}</span><span class="currency-number">{{ projectBudgetEntity.totalBudget|number_format(2) }}</span></span></h5>
                </div>
                <div class="col-6">
                    <p class="text-muted mb-1 fs-12">{{ 'Inflection Date'|trans }}</p>
                    <h5 class="m-0 fw-semibold text-dark" id="res-date">--</h5>
                </div>
                <div class="col-6">
                    <p class="text-muted mb-1 fs-12">{{ 'Confidence Engine'|trans }}</p>
                    <h5 class="m-0 fw-semibold text-dark">Gemma 2 (Local)</h5>
                </div>
            </div>
        </div>

        <!-- Column 3 -->
        <div class="d-flex flex-column align-items-center justify-content-center px-3" style="width: 33.33%;">
            <div class="position-relative d-flex align-items-center justify-content-center" style="width: 144px; height: 144px;">
                <svg width="144" height="144" viewBox="0 0 144 144" class="circular-progress">
                    <circle class="bg" cx="72" cy="72" r="60" fill="none" stroke="#eef2f7" stroke-width="12"></circle>
                    <circle id="res-prob-ring" class="progress" cx="72" cy="72" r="60" fill="none" stroke="#10c469" stroke-width="12" stroke-dasharray="376.99" stroke-dashoffset="376.99" stroke-linecap="round" style="transform: rotate(-90deg); transform-origin: 50% 50%; transition: stroke-dashoffset 1s ease-in-out;"></circle>
                </svg>
                <span id="res-prob-text" class="position-absolute fs-3 fw-bold text-dark m-0 p-0" style="top: 50%; left: 50%; transform: translate(-50%, -50%); line-height: 1;">--%</span>
            </div>
            <span class="text-muted fs-12 mt-2">{{ 'Success Probability'|trans }}</span>
        </div>
    </div>
    
    <!-- Chart Section -->
    <div class="mt-3 pt-3 border-top d-none" id="ai-chart-container">
        <h5 class="fs-14 fw-semibold mb-2">{{ 'Projected Spending Timeline'|trans }}</h5>
        <div dir="ltr">
            <div id="ai-predictions-chart" class="apex-charts" data-colors="#fa5c7c"></div>
        </div>
    </div>
    
    <!-- Solutions -->
    <div class="mt-2 pt-2 border-top">
        <h5 class="fs-14 fw-semibold mb-2">{{ 'AI Recommended Solutions'|trans }}</h5>
        <div id="ai-analysis-content" class="text-muted fs-14">
            <!-- Content -->
        </div>
    </div>
</div>
