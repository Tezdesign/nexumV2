<div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mt-0 header-title d-flex align-items-center">
            <i class="ti ti-robot fs-20 text-primary me-2"></i> 
            {{ 'AI Financial Analysis (Gemma)'|trans }}
        </h4>
        <button class="btn btn-soft-secondary btn-sm rounded-pill" id="btn-rerun-ai">
            <i class="ti ti-refresh me-1"></i> {{ 'Rerun Analysis'|trans }}
        </button>
    </div>
    
    <div class="card border-primary border border-1 bg-primary-subtle mb-3">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8 text-start">
                    <div class="row">
                        <div class="col-sm-6 mb-3 mb-sm-0">
                            <h5 class="text-muted fw-normal mt-0" title="Variance">{{ 'Variance Analysis'|trans }}</h5>
                            <h3 class="fw-semibold text-primary mt-2 mb-0" id="ai-variance-text">--</h3>
                        </div>
                        <div class="col-sm-6">
                            <h5 class="text-muted fw-normal mt-0" title="Risk">{{ 'Risk Level'|trans }}</h5>
                            <h3 class="fw-semibold mt-2 mb-0" id="ai-risk-text">--</h3>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-center">
                    <h5 class="text-muted fw-normal mt-0 mb-1" title="Probability">{{ 'Success Probability'|trans }}</h5>
                    <div dir="ltr" class="d-flex justify-content-center">
                        <div id="ai-success-chart" class="apex-charts" data-colors="#10c469"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="card border-0 shadow-none">
        <div class="card-body p-0">
            <h5 class="header-title mb-3">{{ 'Recommended Solutions & Analysis'|trans }}</h5>
            <div id="ai-analysis-content" class="bg-light p-4 rounded text-start">
