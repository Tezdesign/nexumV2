<div class="card">
    <div class="card-body">
        <div class="row align-items-center mb-3">
            <div class="col-md-6">
                <h3 class="m-0">{{ projectBudget.name|trans }}</h3>
                <p class="text-muted fs-14 mt-1 mb-0">{{ projectBudget.projectName|trans }}</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="d-inline-flex gap-4 text-start">
                    <div>
                        <p class="text-muted fw-semibold text-uppercase mb-1 fs-12">{{ 'Total Budget'|trans }}</p>
                        <h4 class="fw-semibold text-primary m-0">{{ currency_symbol|default('$') }}{{ projectBudget.totalBudget }}</h4>
                    </div>
                    <div>
                        <p class="text-muted fw-semibold text-uppercase mb-1 fs-12">{{ 'Actual Spend'|trans }}</p>
                        <h4 class="fw-semibold text-danger m-0">{{ currency_symbol|default('$') }}{{ projectBudget.actualSpend }}</h4>
                    </div>
                    <div>
                        <p class="text-muted fw-semibold text-uppercase mb-1 fs-12">{{ 'Remaining Balance'|trans }}</p>
                        <h4 class="fw-semibold text-success m-0">{{ currency_symbol|default('$') }}{{ projectBudget.remaining }}</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 justify-content-between mt-4">
            <span class="fw-semibold fs-15">{{ 'Budget Utilization'|trans }}</span>
            <div class="text-end">
                <h4 class="fw-bold text-primary m-0">{{ projectBudget.utilization }}%</h4>
            </div>
        </div>

        <div class="progress mt-2" style="height: 12px; border-radius: 6px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: {{ projectBudget.utilization }}%" aria-valuenow="{{ projectBudget.utilization }}" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
    </div>
</div>