<div class="card">
    <div class="card-body">
        <div class="row align-items-start mb-3">
            <div class="col-md-6">
                <h3 class="m-0">{{ projectBudget.name|trans }}</h3>
                <p class="text-muted fs-14 mt-1 mb-1">{{ projectBudget.projectName|trans }}</p>
                <p class="text-muted mb-0 fs-13"><i class="ti ti-calendar-event me-1"></i>{{ 'Due:'|trans }} {{ projectBudget.dueDate }}</p>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <div class="d-flex justify-content-md-end justify-content-between align-items-center mb-3">
                    <span class="badge {% if projectBudget.status == 'ON TRACK' %}badge-soft-success{% elseif projectBudget.status == 'AT RISK' %}badge-soft-warning{% else %}badge-soft-danger{% endif %} rounded-pill fs-12 me-3">{{ projectBudget.status|trans }}</span>
                    <div class="dropdown">
                        <a href="#" class="dropdown-toggle drop-arrow-none card-drop" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="ri-more-2-fill fs-20 text-muted"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <a href="javascript:void(0);" class="dropdown-item text-dark" data-bs-toggle="modal" data-bs-target="#updateProjectBudgetModal"><i class="ti ti-pencil me-1"></i>{{ 'Update'|trans }}</a>
                            <a href="javascript:void(0);" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteProjectBudgetModal"><i class="ti ti-trash me-1"></i>{{ 'Delete'|trans }}</a>
                        </div>
                    </div>
                </div>
                <div class="d-inline-flex gap-4 text-start">
                    <div>
                        <p class="text-muted fw-semibold text-uppercase mb-1 fs-12">{{ 'Total Budget'|trans }}</p>
                        <h4 class="fw-semibold text-primary m-0">{{ currency_symbol|default('$') }}{{ projectBudget.totalBudget }}</h4>
                    </div>
                    <div>
                        <p class="text-muted fw-semibold text-uppercase mb-1 fs-12">{{ 'Actual Spend'|trans }}</p>
                        <h4 class="fw-semibold text-danger m-0">{{ currency_symbol|default('$') }}{{ projectBudget.actualSpend }}</h4>
                    </div>
                    <div>
                        <p class="text-muted fw-semibold text-uppercase mb-1 fs-12">{{ 'Remaining Balance'|trans }}</p>
                        <h4 class="fw-semibold text-success m-0">{{ currency_symbol|default('$') }}{{ projectBudget.remaining }}</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2 justify-content-between mt-4">
            <span class="fw-semibold fs-15">{{ 'Budget Utilization'|trans }}</span>
            <div class="text-end">
                <h4 class="fw-bold text-primary m-0">{{ projectBudget.utilization }}%</h4>
            </div>
        </div>

        <div class="progress mt-2" style="height: 12px; border-radius: 6px;">
            <div class="progress-bar bg-primary" role="progressbar" style="width: {{ projectBudget.utilization }}%" aria-valuenow="{{ projectBudget.utilization }}" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
    </div>
</div>