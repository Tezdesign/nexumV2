<div class="card h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mt-1 mb-1">
            <h4 class="m-0 text-truncate pe-2">
                <a href="#" class="text-dark">{{ project.name|trans }}</a>
            </h4>
            <span class="badge {% if project.status == 'ON TRACK' %}bg-success{% elseif project.status == 'AT RISK' %}bg-warning{% else %}bg-danger{% endif %} rounded-pill fs-11 flex-shrink-0">{{ project.status|trans }}</span>
        </div>
        <p class="text-muted fs-13 mb-3">{{ project.subtitle|trans }}</p>
        
        <div class="row text-center mt-2 mb-2 g-0">
            <div class="col-4">
                <h4 class="fw-normal fs-14 m-0">{{ currency_symbol|default('$') }}{{ project.totalBudget }}</h4>
                <p class="text-muted mb-0 fs-12">{{ 'Total'|trans }}</p>
            </div>
            <div class="col-4 border-start border-light">
                <h4 class="fw-normal fs-14 m-0">{{ currency_symbol|default('$') }}{{ project.actualSpend }}</h4>
                <p class="text-muted mb-0 fs-12">{{ 'Spend'|trans }}</p>
            </div>
            <div class="col-4 border-start border-light">
                <h4 class="fw-normal fs-14 m-0">{{ currency_symbol|default('$') }}{{ project.remaining }}</h4>
                <p class="text-muted mb-0 fs-12">{{ 'Left'|trans }}</p>
            </div>
        </div>
        
        <div class="mt-3 d-flex justify-content-between align-items-center">
            <p class="text-muted mb-0 fs-12"><i class="ti ti-calendar-event me-1"></i>{{ 'Due:'|trans }} {{ project.dueDate }}</p>
            <a href="#" class="btn btn-soft-primary btn-sm">{{ 'Details'|trans }}</a>
        </div>
    </div>
</div>
