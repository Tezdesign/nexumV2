<div class="row mb-3">
    <div class="col-xl-3 col-md-6">
        <div class="card h-100 mb-0">
            <div class="card-body widget-user">
                <div class="text-center">
                    <h2 class="fw-normal text-primary">{{ budgetStats.ranking.display|default('N/A') }}</h2>
                    <p class="mb-0 fw-semibold">{{ 'Project Spending Rank'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100 mb-0">
            <div class="card-body widget-user">
                <div class="text-center">
                    <h2 class="text-danger">{{ budgetStats.allocatedShare.display|default('0%') }}</h2>
                    <p class="mb-0 fw-semibold">{{ 'Share of Project Budget'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100 mb-0">
            <div class="card-body widget-user">
                <div class="text-center">
                    <h2 class="fw-semibold text-warning">{{ budgetStats.spentShare.display|default('0%') }}</h2>
                    <p class="mb-0 fw-semibold">{{ 'Share of Project Spend'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card h-100 mb-0">
            <div class="card-body widget-user">
                <div class="text-center">
                    <h2 class="fw-bold text-{{ budgetStats.prediction.class|default('secondary') }}">
                        {{ budgetStats.prediction.displayPercentage|default('0%') }}
                    </h2>
                    <p class="mb-0 fw-semibold">{{ budgetStats.prediction.status|default('UNKNOWN')|trans }} {{ 'Prediction'|trans }}</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card h-100">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title m-0">{{ 'Transactions Over Time'|trans }}</h4>
            </div>
            <div class="card-body">
                <div id="transactions-mixed-chart" class="apex-charts" data-colors="#5b69bc,#10c469,#fa5c7c"></div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card h-100">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title m-0">{{ 'Expense Categories'|trans }}</h4>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div id="category-pie-chart" class="apex-charts" data-colors="#5b69bc,#10c469,#fa5c7c,#f9c851,#39afd1"></div>
            </div>
        </div>
    </div>
</div>