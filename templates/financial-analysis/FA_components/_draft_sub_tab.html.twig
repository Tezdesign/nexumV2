{% if isConsultant %}
    <div class="row h-100" id="consultant-draft-interface" data-ajax-url="{{ path('apps-financial-analysis-consultant-drafts-list', {id: projectBudgetEntity.id}) }}">
        <!-- Left Column: Drafts List (60%) -->
        <div class="col-lg-7 d-flex flex-column h-100" style="min-height: 400px;">
            <!-- Filter Tabs -->
            <ul class="nav nav-pills bg-light rounded p-1 mb-3">
                <li class="nav-item flex-fill text-center">
                    <a class="nav-link active consultant-filter-tab bg-white shadow-sm" href="#" data-filter="flawed">
                        <i class="ri-error-warning-line me-1"></i>{{ 'Flawed'|trans }}
                    </a>
                </li>
                <li class="nav-item flex-fill text-center">
                    <a class="nav-link consultant-filter-tab" href="#" data-filter="approved">
                        <i class="ri-check-line me-1"></i>{{ 'Approved'|trans }}
                    </a>
                </li>
                <li class="nav-item flex-fill text-center">
                    <a class="nav-link consultant-filter-tab text-danger" href="#" data-filter="rejected">
                        <i class="ri-close-circle-line me-1"></i>{{ 'Rejected'|trans }}
                    </a>
                </li>
            </ul>

            <!-- Dynamic List Container -->
            <div id="consultant-draft-list" class="flex-grow-1 overflow-auto pe-2" style="max-height: 350px;">
                <div class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            </div>
        </div>

        <!-- Right Column: Evaluation Panel (40%) -->
        <div class="col-lg-5 h-100">
            <div class="card h-100 border-0 shadow-none bg-light" id="consultant-eval-panel">
                <div class="card-body d-flex flex-column align-items-center justify-content-center text-center p-4">
                    <i class="ri-file-search-line fs-1 text-muted mb-2"></i>
                    <h5 class="text-muted">{{ 'Select a Draft'|trans }}</h5>
                    <p class="text-muted small mb-0">{{ 'Click on a draft row to view its evaluation details and take action.'|trans }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden Template for Evaluation Panel content -->
    <template id="eval-panel-template">
        <div class="d-flex flex-column h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0 fw-bold">{{ 'Evaluation Summary'|trans }}</h5>
                <span class="badge border badge-status">STATUS</span>
            </div>

            <div class="eval-content flex-grow-1 overflow-auto pe-1 mb-3" style="max-height: 250px; font-size: 13px;">
                <!-- Content will be injected here via JS -->
            </div>

            <!-- Action Buttons -->
            <div class="mt-auto border-top border-dashed pt-3 d-flex gap-2 consultant-action-buttons">
                <button type="button" class="btn btn-outline-danger flex-grow-1 btn-reject-draft" data-bs-toggle="modal" data-bs-target="#consultantRejectModal">
                    <i class="ri-close-circle-line me-1"></i>{{ 'Reject'|trans }}
                </button>
                <button type="button" class="btn btn-success flex-grow-1 btn-approve-draft">
                    <i class="ri-check-line me-1"></i>{{ 'Approve'|trans }}
                </button>
            </div>
        </div>
    </template>

    <!-- Consultant Reject Modal -->
    <div class="modal fade" id="consultantRejectModal" tabindex="-1" aria-labelledby="consultantRejectModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-bottom border-dashed d-flex align-items-center">
                    <h4 class="modal-title text-danger" id="consultantRejectModalLabel">
                        <i class="ri-close-circle-line me-1"></i>{{ 'Reject Draft'|trans }}
                    </h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted fs-14 mb-3">{{ 'Please confirm rejection and generate the reason for the project manager based on the evaluation data.'|trans }}</p>
                    <label class="form-label">{{ 'Rejection Reason (Generated from Evaluation)'|trans }}</label>
                    <textarea id="consultant-reject-reason" class="form-control" rows="4" placeholder="e.g. Draft exceeds budget limits..."></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                    <button type="button" class="btn btn-danger" id="submit-consultant-reject">{{ 'Confirm Rejection'|trans }}</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Ensure the JS is loaded -->
    <script src="{{ asset('js/FA_consultant.js') }}"></script>

{% else %}
    <p class="text-muted">{{ 'Select a transaction to view details.'|trans }}</p>
{% endif %}