{% if transactions is empty %}
    <!-- Empty State: No Transactions Found -->
    <div class="row justify-content-center align-items-center mt-2">
        <div class="col-md-10">
            <div class="card text-center bg-transparent shadow-none">
                <div class="card-body p-4">
                    <div class="mb-3">
                        {% if app.request.query.get('q') %}
                            <i class="ti ti-search text-muted opacity-50" style="font-size: 4rem;"></i>
                        {% else %}
                            <i class="ti ti-receipt-off text-muted opacity-50" style="font-size: 4rem;"></i>
                        {% endif %}
                    </div>
                    {% if app.request.query.get('q') %}
                        <h5 class="mt-2 mb-1 fw-semibold">{{ 'No matches found'|trans }}</h5>
                        <p class="text-muted mb-0 fs-13">{{ 'Try adjusting your search term.'|trans }}</p>
                    {% else %}
                        <h5 class="mt-2 mb-1 fw-semibold">{{ 'No Transactions Found'|trans }}</h5>
                        <p class="text-muted mb-0 fs-13">{{ 'There are no transactions recorded for this budget yet.'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% else %}
    <!-- Transaction items go here -->
    {% for transaction in transactions %}
        {% include 'financial-analysis/FA_components/_transaction_list_row.html.twig' with {'transaction': transaction} %}
    {% endfor %}
{% endif %}
