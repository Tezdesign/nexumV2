<div class="card h-100 profile-card">
    <div class="card-body">
        {% set trend = profileTrends[profile.id] ?? null %}
        <div class="d-flex justify-content-between align-items-center mt-1 mb-1">
            <h4 class="m-0 text-truncate pe-2">
                <a href="{{ path('apps-financial-analysis-profile', {id: profile.id}) }}" class="text-dark">{{ 'FY'|trans }} {{ profile.fiscalYear }}</a>
            </h4>
            <span class="badge {% if profile.status == 'ACTIVE' %}badge-soft-success{% elseif profile.status == 'DRAFT' %}badge-soft-warning{% else %}badge-soft-secondary{% endif %} rounded-pill fs-11 flex-shrink-0">{{ profile.status|trans }}</span>
        </div>
        <p class="text-muted fs-13 mb-3">{{ 'Base Currency:'|trans }} {{ profile.baseCurrency|default('N/A') }}</p>
        
        <div class="row text-center mt-2 mb-2 g-0">
            <div class="col-4">
                <h4 class="fw-normal fs-14 m-0">
                    {{ currency_symbol|default('$') }}{{ profile.budgetDisposable }}
                    {% if trend and trend.budget.is_different %}
                        <span class="badge badge-soft-{{ trend.budget.class }} rounded-pill fs-10 mt-1 d-block">
                            {{ trend.budget.badge }} <i class="ti ti-trending-{{ trend.budget.direction }}"></i>
                        </span>
                    {% endif %}
                </h4>
                <p class="text-muted mb-0 fs-12">{{ 'Disposable'|trans }}</p>
            </div>
            <div class="col-4 border-start border-light">
                <h4 class="fw-normal fs-14 m-0">
                    {{ currency_symbol|default('$') }}{{ profile.totalExpense|default('0.00') }}
                    {% if trend and trend.spending.is_different %}
                        <span class="badge badge-soft-{{ trend.spending.class }} rounded-pill fs-10 mt-1 d-block">
                            {{ trend.spending.badge }} <i class="ti ti-trending-{{ trend.spending.direction }}"></i>
                        </span>
                    {% endif %}
                </h4>
                <p class="text-muted mb-0 fs-12">{{ 'Expense'|trans }}</p>
            </div>
            <div class="col-4 border-start border-light">
                <h4 class="fw-normal fs-14 m-0">
                    {{ profile.marginProfit|default('0') }}%
                    {% if trend and trend.utilization.is_different %}
                        <span class="badge badge-soft-{{ trend.utilization.class }} rounded-pill fs-10 mt-1 d-block">
                            {{ trend.utilization.badge }} <i class="ti ti-trending-{{ trend.utilization.direction }}"></i>
                        </span>
                    {% endif %}
                </h4>
                <p class="text-muted mb-0 fs-12">{{ 'Margin'|trans }}</p>
            </div>
        </div>
        
        <div class="mt-3 d-flex justify-content-between align-items-center">
            <p class="text-muted mb-0 fs-12">
                <i class="ti ti-calendar-event me-1"></i>
                {% if profile.startDate and profile.endDate %}
                    {{ profile.startDate|date('Y-m-d') }} to {{ profile.endDate|date('Y-m-d') }}
                {% else %}
                    {{ 'Dates not set'|trans }}
                {% endif %}
            </p>
            <a href="{{ path('apps-financial-analysis-profile', {id: profile.id}) }}" class="btn btn-soft-primary btn-sm">{{ 'View Dashboard'|trans }}</a>
        </div>
    </div>
</div>
