<div class="card mb-2">
    <div class="card-body p-3">
        <div class="row align-items-center">
            <!-- Project Info -->
            <div class="col-md-3">
                <h5 class="m-0">
                    <a href="#" class="text-dark">{{ project.name|trans }}</a>
                </h5>
                <p class="text-muted mb-0 fs-13">{{ project.subtitle|trans }}</p>
            </div>
            
            <!-- Status Badge -->
            <div class="col-md-2 col-lg-1 text-center mt-2 mt-md-0">
                <span class="badge {% if project.status == 'ON TRACK' %}bg-success{% elseif project.status == 'AT RISK' %}bg-warning{% else %}bg-danger{% endif %} rounded-pill fs-11">{{ project.status|trans }}</span>
            </div>
            
            <!-- Financials -->
            <div class="col-md-2 text-center mt-2 mt-md-0">
                <p class="text-muted mb-0 fs-12">{{ 'Total Budget'|trans }}</p>
                <h5 class="fw-normal m-0 fs-15">{{ currency_symbol|default('$') }}{{ project.totalBudget }}</h5>
            </div>
            
            <div class="col-md-2 text-center mt-2 mt-md-0">
                <p class="text-muted mb-0 fs-12">{{ 'Actual Spend'|trans }}</p>
                <h5 class="fw-normal m-0 fs-15">{{ currency_symbol|default('$') }}{{ project.actualSpend }}</h5>
            </div>
            
            <div class="col-md-2 text-center mt-2 mt-md-0">
                <p class="text-muted mb-0 fs-12">{{ 'Remaining'|trans }}</p>
                <h5 class="fw-normal m-0 fs-15">{{ currency_symbol|default('$') }}{{ project.remaining }}</h5>
            </div>
            
            <!-- Action & Due Date -->
            <div class="col-md-1 col-lg-2 text-md-end text-center mt-3 mt-md-0">
                <p class="text-muted mb-1 fs-12"><i class="ti ti-calendar-event me-1"></i>{{ project.dueDate }}</p>
                <a href="#" class="btn btn-soft-primary btn-sm">{{ 'Details'|trans }}</a>
            </div>
        </div>
    </div>
</div>
