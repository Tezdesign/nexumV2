<!-- Update Profile Modal -->
<div class="modal fade" id="updateProfileModal" tabindex="-1" aria-labelledby="updateProfileModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="modal-title" id="updateProfileModalLabel">{{ 'Update Budget Profile'|trans }}</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            {{ form_start(form, {'attr': {'id': 'updateProfileForm', 'novalidate': 'novalidate', 'data-turbo': 'false'}}) }}
            <div class="modal-body p-4">

                <div class="row">
                    <!-- Left Column: Currency & Budget -->
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.base_currency, 'Base Currency'|trans, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.base_currency, {'attr': {
                            'class': 'form-select ' ~ (form.base_currency.vars.valid ? '' : 'is-invalid'),
                            'data-toggle': 'select2'
                        }}) }}
                        {% if not form.base_currency.vars.valid %}
                            <div class="text-danger mt-1" style="font-size: 0.875em; display: block;">
                                {% for error in form.base_currency.vars.errors %}
                                    <span class="d-block">{{ error.message }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="col-md-6 mb-3">
                        {{ form_label(form.budget_disposable, 'Total Disposable Budget'|trans, {'label_attr': {'class': 'form-label'}}) }}
                                                <div class="input-group">
                            <span class="input-group-text" id="budget-addon">{{ currency_symbol|default('$') }}</span>
                            {{ form_widget(form.budget_disposable, {'attr': {
                                'class': 'form-control ' ~ (form.budget_disposable.vars.valid ? '' : 'is-invalid'),
                                'aria-describedby': 'budget-addon'
                            }}) }}
                        </div>
                        {% if not form.budget_disposable.vars.valid %}
                            <div class="text-danger mt-1" style="font-size: 0.875em; display: block;">
                                {% for error in form.budget_disposable.vars.errors %}
                                    <span class="d-block">{{ error.message }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>

                                <hr class="border-dashed my-3">

                <!-- Date Selection Type & Status -->
                <div class="row mb-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label d-block">{{ 'Fiscal Period Type'|trans }}</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="period_type" id="periodStandard" value="standard" checked>
                            <label class="form-check-label" for="periodStandard">{{ 'Standard Year'|trans }}</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="period_type" id="periodCustom" value="custom">
                            <label class="form-check-label" for="periodCustom">{{ 'Custom Dates'|trans }}</label>
                        </div>
                    </div>
                    
                </div>

                <!-- Fiscal Year -->
                <div class="row mb-3 align-items-end">
                    <div class="col-md-6">
                        {{ form_label(form.fiscal_year, 'Fiscal Year'|trans, {'label_attr': {'class': 'form-label d-block'}}) }}
                        {{ form_widget(form.fiscal_year, {'attr': {
                            'class': 'form-select ' ~ (form.fiscal_year.vars.valid ? '' : 'is-invalid'),
                            'id': 'budget_profile_fiscal_year',
                            'data-toggle': 'select2'
                        }}) }}
                        {% if not form.fiscal_year.vars.valid %}
                            <div class="text-danger mt-1" style="font-size: 0.875em; display: block;">
                                {% for error in form.fiscal_year.vars.errors %}
                                    <span class="d-block">{{ error.message }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="statusSelect">{{ 'Profile Status'|trans }}</label>
                        <select class="form-select" id="statusSelect" data-toggle="select2" disabled>
                            <option value="DRAFT" selected>{{ 'DRAFT'|trans }}</option>
                            <option value="ACTIVE">{{ 'ACTIVE'|trans }}</option>
                            <option value="CLOSED">{{ 'CLOSED'|trans }}</option>
                        </select>
                    </div>
                </div>

                <!-- Custom Date Selectors -->
                <div class="row" id="customDatesWrapper">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.start_date, 'Start Date'|trans, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.start_date, {'attr': {
                            'class': 'form-control ' ~ (form.start_date.vars.valid ? '' : 'is-invalid'),
                            'data-provider': 'flatpickr',
                            'data-date-format': 'Y-m-d'
                        }}) }}
                        {% if not form.start_date.vars.valid %}
                            <div class="text-danger mt-1" style="font-size: 0.875em; display: block;">
                                {% for error in form.start_date.vars.errors %}
                                    <span class="d-block">{{ error.message }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="col-md-6 mb-3">
                        {{ form_label(form.end_date, 'End Date'|trans, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.end_date, {'attr': {
                            'class': 'form-control ' ~ (form.end_date.vars.valid ? '' : 'is-invalid'),
                            'data-provider': 'flatpickr',
                            'data-date-format': 'Y-m-d'
                        }}) }}
                        {% if not form.end_date.vars.valid %}
                            <div class="text-danger mt-1" style="font-size: 0.875em; display: block;">
                                {% for error in form.end_date.vars.errors %}
                                    <span class="d-block">{{ error.message }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
                
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                <button type="submit" class="btn btn-legacy-purple">{{ 'Update Profile'|trans }}</button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const updateModalEl = document.getElementById('updateProfileModal');
        
        {% if form.vars.submitted and not form.vars.valid %}
            const myModal = bootstrap.Modal.getOrCreateInstance(updateModalEl);
            myModal.show();
        {% endif %}

        if (updateModalEl) {
            updateModalEl.addEventListener('hidden.bs.modal', function () {
                const form = document.getElementById('updateProfileForm');
                if (form) {
                    form.reset();

                    // Recall the original data straight from the cached PHP entity!
                    const budgetInput = document.getElementById('budget_profile_budget_disposable');
                    if (budgetInput) budgetInput.value = '{{ budgetProfile.budgetDisposable|number_format(0, "", "") }}';
                    
                    const currencySelect = document.getElementById('budget_profile_base_currency');
                    if (currencySelect) $(currencySelect).val('{{ budgetProfile.baseCurrency }}').trigger('change.select2');

                    const fiscalSelect = document.getElementById('budget_profile_fiscal_year');
                    if (fiscalSelect) $(fiscalSelect).val('{{ budgetProfile.fiscalYear }}').trigger('change.select2');

                    const sInput = document.getElementById('budget_profile_start_date');
                    if (sInput && sInput._flatpickr) {
                        sInput._flatpickr.setDate('{{ budgetProfile.startDate ? budgetProfile.startDate|date("Y-m-d") : "" }}', true);
                    }

                    const eInput = document.getElementById('budget_profile_end_date');
                    if (eInput && eInput._flatpickr) {
                        eInput._flatpickr.setDate('{{ budgetProfile.endDate ? budgetProfile.endDate|date("Y-m-d") : "" }}', true);
                    }

                    $(form).find('.is-invalid').removeClass('is-invalid');
                    $(form).find('.text-danger.mt-1').remove();
                }
            });
        }
    });
</script>

