<div class="row">
    <!-- Transactions List (60%) -->
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="header-title m-0 text-nowrap">{{ 'Transactions'|trans }}</h4>
                <div class="d-flex align-items-center gap-2 py-1 px-2 rounded" style="background-color: var(--ct-secondary-bg-subtle, rgba(91, 105, 188, 0.1));">

                    <!-- Multi-Delete Actions -->
                    <div class="d-flex align-items-center" id="multiDeleteContainer">
                        <div class="confirm-delete-wrapper">
                            <button type="button" class="btn btn-outline-danger rounded-pill btn-sm" id="confirmDeleteBtn">
                                {{ 'Confirm Delete'|trans }} <span id="deleteCountBadge" class="badge bg-danger text-white ms-1">0</span>
                            </button>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm rounded-pill" id="multiDeleteToggleBtn" title="{{ 'Multi-Delete'|trans }}">
                            <i class="ti ti-trash fs-16"></i>
                        </button>
                    </div>

                    <!-- Search Bar -->
                    <div class="app-search d-none d-sm-block">
                        <form class="mb-0">
                            <div class="position-relative">
                                <input type="search" id="transaction-search-input" value="{{ app.request.query.get('q') }}" class="form-control border-0" style="background-color: var(--ct-body-bg, #fff); border-radius: 20px; padding-left: 35px; box-shadow: none; min-width: 150px;" placeholder="{{ 'Search...'|trans }}">
                                <i class="ri-search-line fs-18 position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                            </div>
                        </form>
                    </div>

                    <!-- Filter Parameters Button (Dropdown) -->
                    {% include 'financial-analysis/FA_components/_transaction_filter_dropdown.html.twig' %}

                    <!-- Right Side Actions -->
                    <button type="button" class="btn btn-legacy-purple btn-sm" data-bs-toggle="modal" data-bs-target="#createTransactionModal"><i class="ti ti-playlist-add fs-20"></i></button>
                </div>
            </div>
            <div class="card-body" id="transaction-list-container" data-simplebar data-simplebar-primary style="max-height: 250px; padding-right: 10px;">
                
                {% include 'financial-analysis/FA_components/_transaction_list_ajax.html.twig' %}
                
            </div>
        </div>
    </div>

    <!-- Extra Component Tabs -->
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header border-bottom border-dashed d-flex align-items-center">
                <h4 class="header-title m-0">{{ 'Advanced Functions'|trans }}</h4>
            </div>
            <div class="card-body p-0">
                <ul class="nav nav-tabs nav-bordered mb-0">
                    <li class="nav-item">
                        <a href="#subtab1" data-bs-toggle="tab" aria-expanded="true" class="nav-link active">
                            <span>{{ 'Draft for Transactions'|trans }}</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="#subtab2" data-bs-toggle="tab" aria-expanded="false" class="nav-link">
                            <span>{{ 'Other'|trans }}</span>
                        </a>
                    </li>
                </ul>
                <div class="tab-content p-3">
                    <div class="tab-pane show active" id="subtab1">
                        {% include 'financial-analysis/FA_components/_draft_sub_tab.html.twig'%}
                    </div>
                    <div class="tab-pane" id="subtab2">
                        <p class="text-muted">{{ 'No attachments available.'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'financial-analysis/FA_components/_delete_transactions_modal.html.twig' %}