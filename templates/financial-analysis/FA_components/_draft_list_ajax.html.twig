{% if drafts is defined and drafts|length > 0 %}
    <div class="draft-list-wrapper">
        {% for draft in drafts %}
            {% include 'financial-analysis/FA_components/_draft_row_ajax.html.twig' with {'draft': draft} %}
        {% endfor %}
    </div>
{% else %}
    <div class="text-center py-5 text-muted">
        <i class="ri-inbox-line fs-1 text-secondary opacity-50"></i>
        <p class="mt-2">{{ 'No drafts available in this category.'|trans }}</p>
    </div>
{% endif %}

<!-- Hidden Template for Evaluation Panel content, dynamically generated per tab -->
<template id="eval-panel-template">
    <div class="d-flex flex-column h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 fw-bold">{{ 'Evaluation Summary'|trans }}</h5>
            <span class="badge border badge-status">STATUS</span>
        </div>

        <div class="eval-content flex-grow-1 overflow-auto pe-1 mb-3" style="max-height: 250px; font-size: 13px;">
            <!-- Content will be injected here via JS -->
        </div>

        <!-- Action Buttons generated by Twig for the current tab -->
        <div class="mt-auto border-top border-dashed pt-3 d-flex gap-2 consultant-action-buttons">
            {% if active_filter == 'approved' %}
                <button type="button" class="btn btn-outline-danger flex-grow-1 btn-reject-draft" data-bs-toggle="modal" data-bs-target="#consultantRejectModal">
                    <i class="ri-close-circle-line me-1"></i>{{ 'Reject'|trans }}
                </button>
                <button type="button" class="btn btn-primary flex-grow-1 btn-to-transaction-draft" data-bs-toggle="modal" data-bs-target="#consultantToTransactionModal">
                    <i class="ri-add-line me-1"></i>{{ 'Add as Transaction'|trans }}
                </button>
            {% elseif active_filter == 'rejected' %}
                <form method="POST" class="flex-grow-1 form-revert-draft m-0">
                    <button type="submit" class="btn btn-outline-warning w-100">
                        <i class="ri-history-line me-1"></i>{{ 'Revert Decision'|trans }}
                    </button>
                </form>
            {% else %}
                {# flawed, pending #}
                <button type="button" class="btn btn-outline-danger flex-grow-1 btn-reject-draft" data-bs-toggle="modal" data-bs-target="#consultantRejectModal">
                    <i class="ri-close-circle-line me-1"></i>{{ 'Reject'|trans }}
                </button>
                <form method="POST" class="flex-grow-1 form-approve-draft m-0">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="ri-check-line me-1"></i>{{ 'Approve'|trans }}
                    </button>
                </form>
            {% endif %}
        </div>
    </div>
</template>