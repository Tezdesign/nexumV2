{% extends 'layouts/vertical.html.twig' %}

{% set title = 'All Project Budgets'|trans %}

{% block css %}
    <!-- Tabler Icons Webfont (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    
    <!-- Flatpickr css -->
    <link rel="stylesheet" href="/vendor/flatpickr/flatpickr.min.css">
    
    <!-- Select2 css -->
    <link href="/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
    
    <!-- Custom FA css -->
    <link href="/css/FA.css?v={{ random() }}" rel="stylesheet" type="text/css" />
{% endblock %}

{% block content %}
    <div class="container-fluid pt-4">
        <!-- Breadcrumb -->
        <div class="row align-items-center mb-4">
            <div class="col-12">
                <div class="page-title-box mb-0">
                    <h4 class="page-title m-0">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ol class="breadcrumb m-0 p-0 bg-transparent align-items-center">
                                <li class="breadcrumb-item">
                                    <a href="{{ path('apps-financial-analysis-landing') }}" class="text-dark text-decoration-none">
                                        <i class="ti ti-smart-home fs-16 me-1"></i>{{ 'Fiscal Budget Profiles'|trans }}
                                    </a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a href="{{ path('apps-financial-analysis-profile', {id: budgetProfile.id}) }}" class="text-dark text-decoration-none">
                                        {{ 'FY'|trans }} {{ budgetProfile.fiscalYear }} {{ 'Dashboard'|trans }}
                                    </a>
                                </li>
                                <li class="breadcrumb-item active text-muted" aria-current="page">{{ 'All Project Budgets'|trans }}</li>
                            </ol>
                        </nav>
                    </h4>
                </div>
            </div>
        </div>

        <!-- Action Bar (Wider version using col-12) -->
        <div class="row mb-4">
            <div class="col-12">
                {% include 'financial-analysis/FA_components/_project_budget_action_bar.html.twig' with {
                    'title': 'Project Budgets List'|trans,
                    'show_all_button': false
                } %}
            </div>
        </div>

        <!-- Project Budgets Display -->
        <div class="row">
            <div class="col-12" data-simplebar data-simplebar-primary style="max-height: 600px; padding-right: 10px;">
                {% if projects is empty %}
                    <!-- Empty State -->
                    <div class="card text-center bg-transparent shadow-none mt-5">
                        <div class="card-body p-5">
                            <div class="mb-4">
                                <i class="ti ti-calendar-off text-muted opacity-50" style="font-size: 5rem;"></i>
                            </div>
                            <h4 class="mt-3 mb-2 fw-semibold">{{ 'No Project Budgets Found'|trans }}</h4>
                            <p class="text-muted mb-4 fs-14">
                                {{ 'There are no active project budgets that fall within the scope of this Fiscal Year.'|trans }}
                            </p>
                        </div>
                    </div>
                {% else %}
                    <!-- Grid View Container -->
                    <div id="project-grid-view" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-4 g-3">
                        {% for project in projects %}
                            <div class="col">
                                {% include 'financial-analysis/FA_components/_project_budget_card.html.twig' with {'project': project} %}
                            </div>
                        {% endfor %}
                    </div>

                    <!-- List View Container (Hidden by default) -->
                    <div id="project-list-view" class="d-none">
                        {% for project in projects %}
                            {% include 'financial-analysis/FA_components/_project_budget_list_row.html.twig' with {'project': project} %}
                        {% endfor %}
                    </div>

                    <!-- Live Search Empty State (Hidden by default) -->
                    <div id="project-search-empty-state" class="row justify-content-center align-items-center mt-2 d-none">
                        <div class="col-md-10">
                            <div class="card text-center bg-transparent shadow-none">
                                <div class="card-body p-4">
                                    <div class="mb-3">
                                        <i class="ti ti-search text-muted opacity-50" style="font-size: 4rem;"></i>
                                    </div>
                                    <h5 class="mt-2 mb-1 fw-semibold">{{ 'No matches found'|trans }}</h5>
                                    <p class="text-muted mb-0 fs-13">
                                        {{ 'Try adjusting your search term.'|trans }}
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% include 'financial-analysis/FA_components/_create_project_budget_modal.html.twig' %}
{% endblock %}

{% block script %}
    <!-- Flatpickr js -->
    <script src="/vendor/flatpickr/flatpickr.min.js"></script>

    <!-- Select2 js -->
    <script src="/vendor/select2/js/select2.min.js"></script>

    <!-- Custom FA JS Logic -->
    <script src="/js/FA_custom.js?v={{ random() }}"></script>
    <script src="/js/FA_functions.js?v={{ random() }}"></script>
{% endblock %}


