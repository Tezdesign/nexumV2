{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Financial Analysis'|trans %}

{% block css %}
    <!-- Tabler Icons Webfont (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    
    <!-- Flatpickr css -->
    <link rel="stylesheet" href="/vendor/flatpickr/flatpickr.min.css">

    <link href="/vendor/nouislider/nouislider.min.css" rel="stylesheet" type="text/css" />
    
    <!-- Select2 css -->
    <link href="/vendor/select2/css/select2.min.css" rel="stylesheet" type="text/css" />
    
    <!-- Custom FA css -->
    <link href="/css/FA.css?v={{ random() }}" rel="stylesheet" type="text/css" />

    <style>
        .modal-backdrop.show {
            backdrop-filter: blur(5px);
            background-color: rgba(0,0,0,0.4);
            opacity: 1;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="container-fluid pt-4" data-turbo="false">
        <!-- Flash Messages -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} alert-dismissible d-flex align-items-center mb-4" role="alert">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    {% if label == 'success' %}
                        <i class="ti ti-check fs-20 me-2"></i>
                    {% else %}
                        <i class="ti ti-alert-triangle fs-20 me-2"></i>
                    {% endif %}
                    <div class="lh-1">
                        <strong>{{ label|capitalize|trans }} - </strong> {{ message|trans }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
        
        <!-- Title & Action -->
        <div class="row align-items-center mb-4">
            <div class="col-12 d-flex align-items-center justify-content-between">
                <div class="page-title-box mb-0">
                    <h4 class="page-title m-0">{{ 'Fiscal Budget Profiles'|trans }}</h4>
                </div>
                <div class="d-inline-flex align-items-center">
                    <button type="button" class="btn btn-legacy-purple rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#createProfileModal">
                        <i class="ti ti-plus me-1"></i> {{ 'Create New Profile'|trans }}
                    </button>
                </div>
            </div>
        </div>

        {% if budgetProfiles is empty %}
        <!-- Empty State: No Budget Profile -->
        <div class="row justify-content-center align-items-center" style="min-height: 50vh;">
            <div class="col-md-8 col-lg-6 col-xl-5">
                <div class="card text-center bg-transparent shadow-none mt-4">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <i class="ti ti-folder-off text-muted opacity-50" style="font-size: 5rem;"></i>
                        </div>
                        <h4 class="mt-3 mb-2 fw-semibold">{{ 'No Budget Profile Set'|trans }}</h4>
                        <p class="text-muted mb-4 fs-14">
                            {{ 'There is no budget profile configured. Create a new profile to unlock financial tracking, KPI widgets, and project budgets.'|trans }}
                        </p>
                        <button type="button" class="btn btn-legacy-purple rounded-pill px-4 py-2" data-bs-toggle="modal" data-bs-target="#createProfileModal">
                            <i class="ti ti-plus me-2"></i> {{ 'Create Budget Profile'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <!-- Search and Filter Toolbar -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="d-flex flex-wrap gap-2 align-items-center p-2 rounded" style="background-color: var(--ct-secondary-bg-subtle, rgba(91, 105, 188, 0.1));">
                    <!-- Search Bar (Styled like topbar) -->
                    <div class="app-search d-none d-sm-block me-auto">
                        <form>
                            <div class="position-relative">
                                <input type="search" class="form-control border-0" style="background-color: var(--ct-body-bg, #fff); border-radius: 20px; padding-left: 35px; box-shadow: none; min-width: 200px;" placeholder="{{ 'Search Profiles...'|trans }}" id="profile-search-input">
                                <i class="ri-search-line fs-18 position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%);"></i>
                            </div>
                        </form>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        {% include 'financial-analysis/FA_components/_budget_profile_filter_dropdown.html.twig' %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Grid View Container -->
        <div id="profile-grid-container" class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            {% for profile in budgetProfiles %}
                <div class="col">
                    {% include 'financial-analysis/FA_components/_budget_profile_card.html.twig' with {'profile': profile} %}
                </div>
            {% endfor %}
        </div>

        <!-- Live Search Empty State (Hidden by default) -->
        <div id="profile-search-empty-state" class="row justify-content-center align-items-center mt-2 d-none">
            <div class="col-md-10">
                <div class="card text-center bg-transparent shadow-none">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <i class="ti ti-search text-muted opacity-50" style="font-size: 4rem;"></i>
                        </div>
                        <h5 class="mt-2 mb-1 fw-semibold">{{ 'No matches found'|trans }}</h5>
                        <p class="text-muted mb-0 fs-13">
                            {{ 'Try adjusting your search term.'|trans }}
                        </p>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

    </div> <!-- end container -->

    {% include 'financial-analysis/FA_components/_create_profile_modal.html.twig' %}
{% endblock %}

{% block script %}
    <!-- Flatpickr js -->
    <script src="/vendor/flatpickr/flatpickr.min.js"></script>

    <!-- Select2 js -->
    <script src="/vendor/select2/js/select2.min.js"></script>

    <script src="/vendor/nouislider/nouislider.min.js"></script>
    <script src="/vendor/wnumb/wNumb.min.js"></script>

    <!-- Custom FA JS Logic -->
    <script src="/js/FA_custom.js?v={{ random() }}"></script>
    <script src="/js/FA_functions.js?v={{ random() }}"></script>
    <script src="/js/FA_ProfileFunctions.js?v={{ random() }}"></script>
{% endblock %}

