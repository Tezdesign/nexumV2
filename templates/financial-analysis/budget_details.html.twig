{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Budget Details'|trans %}

{% block css %}
    <!-- Tabler Icons Webfont (CDN) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css">
    
    <!-- NoUiSlider css -->
    <link rel="stylesheet" href="/vendor/nouislider/nouislider.min.css">
    
    <!-- Custom FA css -->
    <link href="/css/FA.css?v={{ random() }}" rel="stylesheet" type="text/css" />

{% endblock %}

{% block content %}
    <div class="container-fluid pt-4">
        <!-- Breadcrumb (Backstep logic) -->
        <div class="row align-items-center mb-3">
            <div class="col-12 d-flex justify-content-between align-items-center">
                <div class="page-title-box mb-0 flex-shrink-1">
                    <h4 class="page-title m-0">
                        <nav aria-label="breadcrumb" class="d-inline-block">
                            <ol class="breadcrumb m-0 p-0 bg-transparent align-items-center">
                                <li class="breadcrumb-item">
                                    <a href="{{ path('apps-financial-analysis-landing') }}" class="text-dark text-decoration-none">
                                        <i class="ti ti-smart-home fs-16 me-1"></i>{{ 'Fiscal Budget Profiles'|trans }}
                                    </a>
                                </li>
                                <li class="breadcrumb-item">
                                    {% if budgetProfile %}
                                        <a href="{{ path('apps-financial-analysis-profile', {id: budgetProfile.id}) }}" class="text-dark text-decoration-none">
                                            {{ 'FY'|trans }} {{ budgetProfile.fiscalYear }} {{ 'Dashboard'|trans }}
                                        </a>
                                    {% else %}
                                        <a href="{{ path('apps-financial-analysis-landing') }}" class="text-dark text-decoration-none">
                                            {{ 'Dashboard'|trans }}
                                        </a>
                                    {% endif %}
                                </li>
                                <li class="breadcrumb-item active text-muted" aria-current="page">{{ projectBudget.name|trans }}</li>
                            </ol>
                        </nav>
                    </h4>
                </div>
                <div class="d-flex gap-2 align-items-center flex-wrap justify-content-end flex-grow-1">
                    <span class="text-muted fs-14 text-nowrap fw-medium me-3 d-flex align-items-center">
                        <a href="javascript:void(0);" id="btn-reset-currency" class="text-muted me-2" title="{{ 'Reset Currency'|trans }}"><i class="ti ti-refresh fs-16"></i></a>
                        <i class="ti ti-cash fs-18 me-1 "></i>{{ 'Base Currency:'|trans }}&nbsp;<strong class="text-dark me-2" id="current-currency-display">{{ budgetProfile.baseCurrency|default('N/A') }}</strong>
                        <i class="ti ti-link fs-16 me-1 text-primary " title="{{ 'Live Exchange Rates'|trans }}"></i>
                        <div style="width: 150px" >
                        <select id="currency-exchange-select" class="form-select form-select-sm w-100" >
                            <!-- Options populated via JS -->
                        </select>
                        </div>
                    </span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                {% include 'financial-analysis/FA_components/_budget_hero_card.html.twig' %}
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <ul class="nav nav-tabs nav-bordered mb-0">
                            <li class="nav-item">
                                <a href="#overview-tab" data-bs-toggle="tab" aria-expanded="true" class="nav-link active py-3">
                                    <i class="ti ti-chart-pie fs-18 me-md-1"></i>
                                    <span class="d-none d-md-inline-block">{{ 'Overview'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#transactions-tab" data-bs-toggle="tab" aria-expanded="false" class="nav-link py-3">
                                    <i class="ti ti-receipt fs-18 me-md-1"></i>
                                    <span class="d-none d-md-inline-block">{{ 'Transactions'|trans }}</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a href="#analysis-tab" data-bs-toggle="tab" aria-expanded="false" class="nav-link py-3">
                                    <i class="ti ti-report-analytics fs-18 me-md-1"></i>
                                    <span class="d-none d-md-inline-block">{{ 'Analysis'|trans }}</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="tab-content pt-3">
                    <div class="tab-pane show active" id="overview-tab">
                        {% include 'financial-analysis/FA_components/_tab_overview.html.twig' %}
                    </div>
                    <div class="tab-pane" id="transactions-tab">
                        {% include 'financial-analysis/FA_components/_tab_transactions.html.twig' %}
                    </div>
                    <div class="tab-pane" id="analysis-tab">
                        {% include 'financial-analysis/FA_components/_tab_analysis.html.twig' %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% include 'financial-analysis/FA_components/_update_project_budget_modal.html.twig' %}
    {% include 'financial-analysis/FA_components/_create_transaction_modal.html.twig' %}
    {% include 'financial-analysis/FA_components/_delete_project_budget_modal.html.twig' %}
    {% include 'financial-analysis/FA_components/_qr_scanner_modal.html.twig' %}
{% endblock %}

{% block script %}
    <!-- html5-qrcode library -->
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

    <!-- ApexCharts js -->
    <script src="/vendor/apexcharts/apexcharts.min.js"></script>

    <!-- Flatpickr js -->
    <script src="/vendor/flatpickr/flatpickr.min.js"></script>

    <!-- Select2 js -->
    <script src="/vendor/select2/js/select2.min.js"></script>

    <!-- NoUiSlider js -->
    <script src="/vendor/nouislider/nouislider.min.js"></script>
    <script src="/vendor/wnumb/wNumb.min.js"></script>

    <!-- Custom FA JS Logic -->
    <script src="/js/FA_custom.js?v={{ random() }}"></script>
    <script src="/js/FA_functions.js?v={{ random() }}"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Restore active tab from URL hash
            var hash = window.location.hash;
            if (hash) {
                var triggerEl = document.querySelector('a[href="' + hash + '"]');
                if (triggerEl) {
                    var tab = new bootstrap.Tab(triggerEl);
                    tab.show();
                }
            }

            // Update URL hash when a tab is clicked
            document.querySelectorAll('a[data-bs-toggle="tab"]').forEach(function (el) {
                el.addEventListener('shown.bs.tab', function (e) {
                    if (history.pushState) {
                        history.pushState(null, null, e.target.hash);
                    } else {
                        window.location.hash = e.target.hash;
                    }
                });
            });

            // If create transaction form has errors, force open transactions tab and the modal
            {% if transactionForm is defined and transactionForm.vars.submitted and not transactionForm.vars.valid %}
                var txTabEl = document.querySelector('a[href="#transactions-tab"]');
                if (txTabEl) {
                    var txTab = new bootstrap.Tab(txTabEl);
                    txTab.show();
                    var createModalEl = document.getElementById('createTransactionModal');
                    if (createModalEl) {
                        var createModal = new bootstrap.Modal(createModalEl);
                        createModal.show();
                    }
                }
            {% endif %}
        });
    </script>
    <script src="/js/FA_Qrcode.js?v={{ random() }}"></script>
    <script src="/js/FA_charts.js?v={{ random() }}"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Restore active tab from URL hash
            var hash = window.location.hash;
            if (hash) {
                var triggerEl = document.querySelector('a[href="' + hash + '"]');
                if (triggerEl) {
                    var tab = new bootstrap.Tab(triggerEl);
                    tab.show();
                }
            }

            // Update URL hash when a tab is clicked
            document.querySelectorAll('a[data-bs-toggle="tab"]').forEach(function (el) {
                el.addEventListener('shown.bs.tab', function (e) {
                    if (history.pushState) {
                        history.pushState(null, null, e.target.hash);
                    } else {
                        window.location.hash = e.target.hash;
                    }
                });
            });

            // If create transaction form has errors, force open transactions tab and the modal
            {% if transactionForm is defined and transactionForm.vars.submitted and not transactionForm.vars.valid %}
                var txTabEl = document.querySelector('a[href="#transactions-tab"]');
                if (txTabEl) {
                    var txTab = new bootstrap.Tab(txTabEl);
                    txTab.show();
                    var createModalEl = document.getElementById('createTransactionModal');
                    if (createModalEl) {
                        var createModal = new bootstrap.Modal(createModalEl);
                        createModal.show();
                    }
                }
            {% endif %}

            // Initialize Currency Exchange
            if (typeof initializeCurrencyExchange === 'function') {
                initializeCurrencyExchange('#currency-exchange-select', {{ budgetProfile.id }}, '{{ budgetProfile.baseCurrency|default('TND') }}');
            }
        });

        // Pass Backend Aggregated Data to JS Charts
        window.projectChartData = {
            months: {{ monthlyData.months|json_encode|raw }},
            transactionCounts: {{ monthlyData.counts|json_encode|raw }},
            transactionVolumes: {{ monthlyData.volumes|json_encode|raw }},
            categories: {{ categoryData.labels|json_encode|raw }},
            categoryCounts: {{ categoryData.counts|json_encode|raw }}
        };
    </script>
{% endblock %}