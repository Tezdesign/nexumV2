{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Formations' %}

{% block css %}
<style>
    :root {
        --primary-color: #696cff;
        --primary-dark: #5b5fe8;
        --secondary-color: #8592a3;
        --success-color: #71dd37;
        --danger-color: #ff3e1d;
        --warning-color: #ffab00;
        --card-border: rgba(105, 108, 255, 0.08);
        --soft-bg: #f8f9ff;
        --text-dark: #233446;
    }

    .page-header-box {
        background: linear-gradient(135deg, #696cff 0%, #8f94fb 100%);
        border-radius: 24px;
        padding: 30px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 18px 40px rgba(105, 108, 255, 0.20);
    }

    .page-header-box::before {
        content: "";
        position: absolute;
        width: 220px;
        height: 220px;
        background: rgba(255,255,255,0.08);
        border-radius: 50%;
        top: -60px;
        right: -60px;
    }

    .page-header-box::after {
        content: "";
        position: absolute;
        width: 140px;
        height: 140px;
        background: rgba(255,255,255,0.06);
        border-radius: 50%;
        bottom: -40px;
        left: -40px;
    }

    .page-header-box h1,
    .page-header-box p,
    .page-header-box a {
        position: relative;
        z-index: 2;
    }

    .btn-create {
        background: #fff;
        color: var(--primary-color);
        border: none;
        border-radius: 999px;
        padding: 12px 22px;
        font-weight: 700;
        box-shadow: 0 10px 25px rgba(0,0,0,0.10);
        transition: all .25s ease;
    }

    .btn-create:hover {
        transform: translateY(-2px);
        background: #f8f9ff;
        color: var(--primary-dark);
    }

    .toolbar-box {
        background: #fff;
        border-radius: 22px;
        padding: 18px;
        box-shadow: 0 10px 35px rgba(31, 45, 61, 0.06);
        border: 1px solid rgba(105, 108, 255, 0.06);
    }

    .search-box {
        position: relative;
    }

    .search-box i {
        position: absolute;
        top: 50%;
        left: 16px;
        transform: translateY(-50%);
        color: #9aa4b2;
        font-size: 1rem;
    }

    .search-box input {
        width: 100%;
        border: 1px solid #e7eaf3;
        border-radius: 14px;
        padding: 14px 16px 14px 46px;
        background: #f9fafc;
        transition: all .25s ease;
        font-size: 15px;
    }

    .search-box input:focus {
        outline: none;
        border-color: rgba(105,108,255,.45);
        background: #fff;
        box-shadow: 0 0 0 4px rgba(105,108,255,.10);
    }

    .toolbar-meta {
        color: #7a8699;
        font-size: 14px;
        font-weight: 500;
    }

    .formation-card {
        position: relative;
        border: 1px solid var(--card-border);
        border-radius: 22px;
        background: #fff;
        overflow: hidden;
        transition: all .30s ease;
        box-shadow: 0 12px 28px rgba(31, 45, 61, 0.06);
    }

    .formation-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(31, 45, 61, 0.12);
        border-color: rgba(105,108,255,.18);
    }

    .formation-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        height: 5px;
        width: 100%;
        background: linear-gradient(90deg, #696cff, #8f94fb);
    }

    .formation-card-body {
        padding: 22px;
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .badge-id {
        background: rgba(105,108,255,.10);
        color: var(--primary-color);
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .icon-circle {
        width: 42px;
        height: 42px;
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(105,108,255,.10);
        color: var(--primary-color);
        font-size: 18px;
    }

    .formation-title {
        font-size: 1.1rem;
        font-weight: 800;
        color: var(--text-dark);
        margin-bottom: 10px;
        line-height: 1.4;
    }

    .formation-desc {
        color: #6b7785;
        font-size: 14px;
        line-height: 1.7;
        min-height: 72px;
        margin-bottom: 18px;
    }

    .video-section-title {
        font-size: 13px;
        font-weight: 700;
        color: #7a8699;
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .video-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f8f9fc;
        border: 1px solid #eceff5;
        color: #4b5563;
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 13px;
        font-weight: 600;
    }

    .video-badge i {
        color: var(--danger-color);
    }

    .no-video-text {
        font-size: 13px;
        color: #98a2b3;
    }

    .btn-action {
        border-radius: 12px;
        font-weight: 700;
        font-size: 14px;
        padding: 11px 14px;
        transition: all .25s ease;
    }

    .btn-view {
        border: 1px solid rgba(105,108,255,.25);
        color: var(--primary-color);
        background: #fff;
    }

    .btn-view:hover {
        background: rgba(105,108,255,.06);
        color: var(--primary-dark);
        border-color: rgba(105,108,255,.35);
    }

    .btn-edit {
        background: linear-gradient(135deg, #696cff 0%, #8f94fb 100%);
        color: #fff;
        border: none;
    }

    .btn-edit:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 12px 24px rgba(105,108,255,.24);
    }

    .empty-state {
        background: #fff;
        border-radius: 24px;
        border: 1px dashed rgba(105,108,255,.18);
        box-shadow: 0 10px 35px rgba(31, 45, 61, 0.05);
    }

    .empty-icon {
        width: 82px;
        height: 82px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(105,108,255,.10);
        color: var(--primary-color);
        font-size: 34px;
    }

    .skeleton-card {
        height: 270px;
        border-radius: 22px;
        background: linear-gradient(90deg, #f1f3f8 25%, #fafbfe 50%, #f1f3f8 75%);
        background-size: 200% 100%;
        animation: shimmer 1.2s infinite linear;
        border: 1px solid #eef1f6;
    }

    @keyframes shimmer {
        0% {
            background-position: 200% 0;
        }
        100% {
            background-position: -200% 0;
        }
    }

    .fade-in-item {
        animation: fadeInUp .35s ease;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .results-info {
        font-size: 14px;
        color: #7b8794;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .page-header-box {
            padding: 22px;
            border-radius: 18px;
        }

        .formation-desc {
            min-height: auto;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="container py-4">

    <!-- HEADER -->
    <div class="page-header-box mb-4">
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h1 class="fw-bold mb-2">Gestion des formations</h1>
                <p class="mb-0 opacity-75">
                    Recherchez, consultez et modifiez vos formations avec une interface moderne.
                </p>
            </div>

            <div>
                <a href="{{ path('app_formation_new') }}" class="btn btn-create">
                    <i class="bi bi-plus-circle me-2"></i>Créer une formation
                </a>
            </div>
        </div>
    </div>

    <!-- TOOLBAR -->
    <div class="toolbar-box mb-4">
        <div class="row align-items-center g-3">
            <div class="col-lg-7">
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input
                        type="text"
                        id="searchInputa"
                        placeholder="Rechercher par titre ou description..."
                        autocomplete="off"
                    >
                </div>
            </div>

            <div class="col-lg-5 text-lg-end">
                <span class="toolbar-meta" id="searchStatus">
                    Chargement des formations...
                </span>
            </div>
        </div>
    </div>

    <!-- AJAX RESULTS -->
    <div class="row g-4" id="formationsContainer"></div>

    <!-- FALLBACK SERVER SIDE -->
    {% if formations is defined and formations|length > 0 %}
        <div class="row g-4 mt-1" id="serverRenderedBlock">
            {% for formation in formations %}
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="formation-card h-100">
                        <div class="formation-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge-id">#{{ formation.id }}</span>
                                <span class="icon-circle">
                                    <i class="bi bi-mortarboard"></i>
                                </span>
                            </div>

                            <h4 class="formation-title">{{ formation.titre }}</h4>

                            <p class="formation-desc">
                                {{ formation.description|length > 140
                                    ? formation.description|slice(0, 140) ~ '...'
                                    : formation.description }}
                            </p>

                            <div class="mb-4">
                                <div class="video-section-title">Vidéos disponibles</div>

                                <div class="d-flex flex-wrap gap-2">
                                    {% if formation.video1 %}
                                        <span class="video-badge">
                                            <i class="bi bi-camera-video-fill"></i> Vidéo 1
                                        </span>
                                    {% endif %}

                                    {% if formation.video2 %}
                                        <span class="video-badge">
                                            <i class="bi bi-camera-video-fill"></i> Vidéo 2
                                        </span>
                                    {% endif %}

                                    {% if formation.video3 %}
                                        <span class="video-badge">
                                            <i class="bi bi-camera-video-fill"></i> Vidéo 3
                                        </span>
                                    {% endif %}

                                    {% if not formation.video1 and not formation.video2 and not formation.video3 %}
                                        <span class="no-video-text">Aucune vidéo disponible</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <a href="{{ path('app_formation_show_admin', {'id': formation.id}) }}"
                                   class="btn btn-action btn-view w-100">
                                    <i class="bi bi-eye me-1"></i> Voir
                                </a>

                                <a href="{{ path('app_formation_edit', {'id': formation.id}) }}"
                                   class="btn btn-action btn-edit w-100">
                                    <i class="bi bi-pencil-square me-1"></i> Modifier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="mt-5 d-flex justify-content-center" id="paginationBlock">
            {{ knp_pagination_render(formations) }}
        </div>
    {% else %}
        <div class="empty-state text-center py-5 px-4" id="serverEmptyState">
            <div class="mb-3">
                <span class="empty-icon">
                    <i class="bi bi-journal-x"></i>
                </span>
            </div>
            <h4 class="fw-bold mb-2">Aucune formation trouvée</h4>
            <p class="text-muted mb-4">Commencez par ajouter votre première formation.</p>
            <a href="{{ path('app_formation_new') }}" class="btn btn-create">
                <i class="bi bi-plus-circle me-2"></i>Créer une formation
            </a>
        </div>
    {% endif %}
</div>

<script>
    const container = document.getElementById('formationsContainer');
    const searchInput = document.getElementById('searchInputa');
    const searchStatus = document.getElementById('searchStatus');
    const serverRenderedBlock = document.getElementById('serverRenderedBlock');
    const paginationBlock = document.getElementById('paginationBlock');
    const serverEmptyState = document.getElementById('serverEmptyState');

    function hideServerContent() {
        if (serverRenderedBlock) serverRenderedBlock.style.display = 'none';
        if (paginationBlock) paginationBlock.style.display = 'none';
        if (serverEmptyState) serverEmptyState.style.display = 'none';
    }

    function showServerContent() {
        if (serverRenderedBlock) serverRenderedBlock.style.display = '';
        if (paginationBlock) paginationBlock.style.display = '';
        if (serverEmptyState) serverEmptyState.style.display = '';
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text ?? '';
        return div.innerHTML;
    }

    function truncateText(text, length = 120) {
        if (!text) return '';
        return text.length > length ? text.substring(0, length) + '...' : text;
    }

    function showLoading() {
        hideServerContent();
        container.innerHTML = '';

        for (let i = 0; i < 6; i++) {
            container.innerHTML += `
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="skeleton-card"></div>
                </div>
            `;
        }

        searchStatus.textContent = 'Chargement...';
    }

    function renderEmpty(query = '') {
        hideServerContent();
        container.innerHTML = `
            <div class="col-12">
                <div class="empty-state text-center py-5 px-4 fade-in-item">
                    <div class="mb-3">
                        <span class="empty-icon">
                            <i class="bi bi-search"></i>
                        </span>
                    </div>
                    <h4 class="fw-bold mb-2">Aucune formation trouvée</h4>
                    <p class="text-muted mb-0">
                        ${query ? `Aucun résultat pour "<strong>${escapeHtml(query)}</strong>".` : 'Aucune donnée disponible.'}
                    </p>
                </div>
            </div>
        `;
        searchStatus.textContent = '0 résultat';
    }

    function renderFormations(data, query = '') {
        hideServerContent();
        container.innerHTML = '';

        if (!Array.isArray(data) || data.length === 0) {
            renderEmpty(query);
            return;
        }

        data.forEach((f, index) => {
            const videos = `
                ${f.video1 ? `<span class="video-badge"><i class="bi bi-camera-video-fill"></i> Vidéo 1</span>` : ''}
                ${f.video2 ? `<span class="video-badge"><i class="bi bi-camera-video-fill"></i> Vidéo 2</span>` : ''}
                ${f.video3 ? `<span class="video-badge"><i class="bi bi-camera-video-fill"></i> Vidéo 3</span>` : ''}
                ${!f.video1 && !f.video2 && !f.video3 ? `<span class="no-video-text">Aucune vidéo disponible</span>` : ''}
            `;

            const card = `
                <div class="col-12 col-md-6 col-xl-4 fade-in-item" style="animation-delay:${index * 0.04}s;">
                    <div class="formation-card h-100">
                        <div class="formation-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge-id">#${escapeHtml(String(f.id))}</span>
                                <span class="icon-circle">
                                    <i class="bi bi-mortarboard"></i>
                                </span>
                            </div>

                            <h4 class="formation-title">${escapeHtml(f.titre)}</h4>

                            <p class="formation-desc">
                                ${escapeHtml(truncateText(f.description, 135))}
                            </p>

                            <div class="mb-4">
                                <div class="video-section-title">Vidéos disponibles</div>
                                <div class="d-flex flex-wrap gap-2">
                                    ${videos}
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <a href="/formation/${encodeURIComponent(f.id)}/admin/form"
                                   class="btn btn-action btn-view w-100">
                                    <i class="bi bi-eye me-1"></i> Voir
                                </a>

                                <a href="/formation/${encodeURIComponent(f.id)}/edit"
                                   class="btn btn-action btn-edit w-100">
                                    <i class="bi bi-pencil-square me-1"></i> Modifier
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            container.insertAdjacentHTML('beforeend', card);
        });

        searchStatus.textContent = `${data.length} résultat${data.length > 1 ? 's' : ''}${query ? ' trouvé(s)' : ''}`;
    }

    async function loadFormations(query = '') {
        try {
            showLoading();

            const response = await fetch(`/formation/api/formations?q=${encodeURIComponent(query)}`, {
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });

            if (!response.ok) {
                throw new Error('Erreur lors du chargement');
            }

            const data = await response.json();
            renderFormations(data, query);

        } catch (error) {
            hideServerContent();
            container.innerHTML = `
                <div class="col-12">
                    <div class="empty-state text-center py-5 px-4 fade-in-item">
                        <div class="mb-3">
                            <span class="empty-icon">
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        </div>
                        <h4 class="fw-bold mb-2">Erreur de chargement</h4>
                        <p class="text-muted mb-3">Impossible de récupérer les formations pour le moment.</p>
                        <button class="btn btn-create" onclick="loadFormations('${query.replace(/'/g, "\\'")}')">
                            <i class="bi bi-arrow-clockwise me-2"></i>Réessayer
                        </button>
                    </div>
                </div>
            `;
            searchStatus.textContent = 'Erreur de chargement';
        }
    }

    // Chargement initial AJAX
    loadFormations();

    // Recherche live
    let debounceTimer;
    searchInput.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        const value = this.value.trim();

        debounceTimer = setTimeout(() => {
            if (value === '') {
                loadFormations('');
            } else {
                loadFormations(value);
            }
        }, 350);
    });
</script>
{% endblock %}