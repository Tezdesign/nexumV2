{% extends 'layouts/vertical.html.twig' %}

{% block title %}Formations{% endblock %}

{% block content %}
{% set participations = participations|default({}) %}

{% if not ajax %}
<section class="py-4">
    <div class="container">

        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-mortarboard-fill text-purple me-2"></i>
                    Catalogue des formations
                </h2>
                <p class="text-muted mb-0">Explorez, progressez et validez vos compétences</p>
            </div>
        </div>

        <!-- SEARCH -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 search-box">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-12 col-md-8">
                        <div class="position-relative">
                            <i class="bi bi-search search-icon"></i>
                            <input
                                type="text"
                                id="searchInput"
                                class="form-control form-control-lg search-input"
                                placeholder="Rechercher une formation..."
                                value="{{ q }}"
                            >
                        </div>
                    </div>

                    <div class="col-12 col-md-4 text-md-end">
                        <span class="badge results-badge" id="resultCountBadge">
                            {{ formations.getTotalItemCount }} résultat(s)
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- AJAX CONTENT -->
        <div id="formationContent">
{% endif %}
 
            {% if formations|length > 0 %}
                <div class="row g-4">

                    {% for formation in formations %}
{% set p = participations[formation.id] ?? null %}                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="formation-card h-100 d-flex flex-column">

                                <!-- TOP -->
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="badge badge-soft">
                                        #{{ formation.id }}
                                    </span>

                                    {% if p %}
                                        {% if p.statut == 'REUSSI' %}
                                            <span class="badge badge-success">
                                                ✔ Validée
                                            </span>
                                        {% elseif p.statut == 'PRET_QUIZ' %}
                                            <span class="badge badge-warning">
                                                ⚡ Quiz
                                            </span>
                                        {% else %}
                                            <span class="badge badge-info">
                                                ⏳ En cours
                                            </span>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge badge-gray">
                                            Non inscrit
                                        </span>
                                    {% endif %}
                                </div>

                                <!-- TITLE -->
                                <h5 class="fw-bold mb-2">
                                    {{ formation.titre }}
                                </h5>

                                <!-- DESCRIPTION -->
                                <p class="text-muted small flex-grow-1">
                                    {{ formation.description|length > 130
                                        ? formation.description|slice(0,130) ~ '...'
                                        : formation.description }}
                                </p>

                                <!-- PROGRESS -->
                                {% if p %}
                                    <div class="mt-3">
                                        <div class="progress-modern">
                                            <div class="progress-bar-purple"
                                                 style="width: {{ p.progression }}%">
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-between mt-2">
                                            <small class="text-muted">{{ p.progression }}%</small>

                                            {% if p.progression >= 90 %}
                                                <small class="text-success fw-semibold">✔ Prêt</small>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endif %}

                                <!-- VIDEOS -->
                                <div class="mt-3 d-flex gap-2 flex-wrap">
                                    {% for i in 1..3 %}
                                        {% set vid = attribute(formation, 'video' ~ i) %}
                                        {% if vid %}
                                            <span class="video-badge">
                                                <i class="bi bi-play-fill"></i> {{ i }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </div>

                                <!-- ACTION -->
                                <div class="mt-4">
                                    <a href="{{ path('app_formation_show', {'id': formation.id}) }}"
                                       class="btn btn-purple w-100">
                                        {{ p ? 'Continuer' : 'Commencer' }}
                                    </a>
                                </div>

                            </div>
                        </div>
                    {% endfor %}

                </div>

                <!-- PAGINATION -->
                <div class="d-flex justify-content-center mt-5 pagination-wrapper">
                    {{ knp_pagination_render(formations) }}
                </div>

            {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-journal-x display-3 text-muted mb-3"></i>
                    <h4 class="fw-bold">Aucune formation disponible</h4>
                    <p class="text-muted">Aucun résultat trouvé pour votre recherche</p>
                </div>
            {% endif %}

{% if not ajax %}
        </div>
    </div>
</section>

<style>
/* CARD */
.formation-card {
    background: white;
    border-radius: 18px;
    padding: 25px;
    border: 1px solid #e2e8f0;
    transition: 0.3s;
    box-shadow: 0 8px 25px rgba(0,0,0,0.03);
}

.formation-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(124,58,237,0.12);
}

/* SEARCH */
.search-box {
    border-radius: 18px;
}

.search-input {
    border-radius: 14px;
    padding-left: 45px;
    border: 1px solid #e2e8f0;
    box-shadow: none;
}

.search-input:focus {
    border-color: #7c3aed;
    box-shadow: 0 0 0 0.2rem rgba(124,58,237,0.12);
}

.search-icon {
    position: absolute;
    top: 50%;
    left: 16px;
    transform: translateY(-50%);
    color: #94a3b8;
    z-index: 2;
}

.results-badge {
    background: linear-gradient(135deg,#7c3aed,#6366f1);
    color: white;
    border-radius: 999px;
    padding: 10px 16px;
    font-size: 0.85rem;
}

/* BADGES */
.badge-soft {
    background: #f1f5f9;
    color: #475569;
    border-radius: 20px;
    padding: 6px 12px;
}

.badge-success {
    background: #dcfce7;
    color: #16a34a;
}

.badge-warning {
    background: #fef9c3;
    color: #ca8a04;
}

.badge-info {
    background: #e0f2fe;
    color: #0284c7;
}

.badge-gray {
    background: #f1f5f9;
    color: #64748b;
}

/* PROGRESS */
.progress-modern {
    height: 8px;
    background: #f1f5f9;
    border-radius: 20px;
    overflow: hidden;
}

.progress-bar-purple {
    height: 100%;
    background: linear-gradient(90deg,#7c3aed,#6366f1);
    border-radius: 20px;
}

/* VIDEO BADGE */
.video-badge {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    color: #475569;
}

/* BUTTON */
.btn-purple {
    background: linear-gradient(135deg,#7c3aed,#6366f1);
    color: white;
    border-radius: 10px;
    font-weight: 500;
    border: none;
}

.btn-purple:hover {
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(124,58,237,0.2);
}

/* TEXT */
.text-purple {
    color: #7c3aed;
}

/* AJAX LOADER */
.ajax-loading {
    opacity: .55;
    pointer-events: none;
    transition: .2s ease;
}

/* PAGINATION */
.pagination {
    gap: 6px;
}

.pagination .page-link {
    border-radius: 10px !important;
    border: 1px solid #e2e8f0;
    color: #475569;
    box-shadow: none;
}

.pagination .page-item.active .page-link {
    background: linear-gradient(135deg,#7c3aed,#6366f1);
    border-color: transparent;
    color: white;
}

.pagination .page-link:hover {
    color: #7c3aed;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const content = document.getElementById('formationContent');
    const resultCountBadge = document.getElementById('resultCountBadge');

    let debounceTimer = null;

    function updateResults(url) {
        content.classList.add('ajax-loading');

        fetch(url, {
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.text())
        .then(html => {
            content.innerHTML = html;
            content.classList.remove('ajax-loading');

            const cards = content.querySelectorAll('.formation-card').length;
            if (resultCountBadge) {
                const totalText = content.querySelector('.pagination') ? null : null;
                resultCountBadge.textContent = cards + ' résultat(s)';
            }

            window.history.replaceState({}, '', url);
        })
        .catch(() => {
            content.classList.remove('ajax-loading');
        });
    }

    function buildUrl(page = 1) {
        const params = new URLSearchParams();
        const q = searchInput.value.trim();

        if (q !== '') {
            params.set('q', q);
        }

        params.set('page', page);

        return `{{ path('app_formation_index') }}?${params.toString()}`;
    }

    searchInput.addEventListener('keyup', function () {
        clearTimeout(debounceTimer);

        debounceTimer = setTimeout(() => {
            updateResults(buildUrl(1));
        }, 350);
    });

    document.addEventListener('click', function (e) {
        const link = e.target.closest('.pagination a');

        if (link) {
            e.preventDefault();

            const url = new URL(link.href);
            const page = url.searchParams.get('page') || 1;

            updateResults(buildUrl(page));
        }
    });
});
</script>
{% endif %}

{% endblock %}