{% extends 'layouts/vertical.html.twig' %}

{% set title = 'Projects' %}

{% block css %}{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold">Créer une nouvelle formation</h1>
        <p class="text-muted">Ajoutez les informations principales ainsi que 3 vidéos maximum.</p>
    </div>

{{ form_start(form, {
    'attr': {
        'novalidate': 'novalidate',
        'enctype': 'multipart/form-data'
    }
}) }}
{{form_errors(form)}}
<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">

        <div class="mb-4">
            <h4 class="fw-bold mb-1">Informations de la formation</h4>
            <p class="text-muted mb-0">Ajoutez les détails de la formation et jusqu’à 3 vidéos.</p>
        </div>

        {% if not form.vars.valid %}
            <div class="alert alert-danger rounded-3">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Veuillez corriger les erreurs du formulaire.
            </div>
        {% endif %}

        <div class="mb-3">
            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <span class="text-danger">*</span>

            {{ form_widget(form.titre) }}
            <div class="text-danger small mt-1">{{ form_errors(form.titre) }}</div>
        </div>

        <div class="mb-4">
            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <span class="text-danger">*</span>

            {{ form_widget(form.description) }}
            <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
        </div>

        <div class="border rounded-4 p-3 bg-light-subtle mb-4">
            <h5 class="fw-bold mb-3">
                <i class="bi bi-camera-video me-2 text-primary"></i>
                Upload des vidéos
            </h5>

            <div class="mb-3">
                {{ form_label(form.video1File, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <span class="text-danger">*</span>

                {{ form_widget(form.video1File) }}
                <div class="form-text">Formats autorisés : mp4, webm, ogg, mov, avi, wmv</div>
                <div class="text-danger small mt-1">{{ form_errors(form.video1File) }}</div>
             </div>

            <div class="mb-3">
                {{ form_label(form.video2File, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <span class="text-danger">*</span>

                {{ form_widget(form.video2File) }}

                <div class="form-text">Formats autorisés : mp4, webm, ogg, mov, avi, wmv</div>
                <div class="text-danger small mt-1">{{ form_errors(form.video2File) }}</div>
             </div>

            <div class="mb-0">
                {{ form_label(form.video3File, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                <span class="text-danger">*</span>
                {{ form_widget(form.video3File) }}
                <div class="form-text">Formats autorisés : mp4, webm, ogg, mov, avi, wmv</div>
                <div class="text-danger small mt-1">{{ form_errors(form.video3File) }}</div>
             </div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
            <a href="{{ path('app_formation_index') }}" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">
                <i class="bi bi-check-circle me-1"></i>
                {{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
</div>
{% endblock %}