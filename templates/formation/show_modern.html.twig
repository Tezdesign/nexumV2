{% extends 'base_modern.html.twig' %}

{% block title %}{{ formation.titre }} - NEXUM Academy{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
/* Custom styles for formation page */
.hero-section {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.1) 100%);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin-bottom: 2rem;
    border: 1px solid var(--border-color);
    backdrop-filter: blur(20px);
}

.language-selector {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 0.5rem 1rem;
    color: var(--text-primary);
    font-weight: 500;
    transition: var(--transition);
}

.language-selector:focus {
    outline: none;
    border-color: var(--neon-cyan);
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.1);
}

.quiz-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}

.quiz-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    backdrop-filter: blur(20px);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.quiz-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--primary-gradient);
    opacity: 0;
    transition: var(--transition);
}

.quiz-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: rgba(59, 130, 246, 0.3);
}

.quiz-card:hover::before {
    opacity: 1;
}

.quiz-status {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 600;
}

.status-completed {
    background: rgba(16, 185, 129, 0.2);
    color: var(--success);
    border: 1px solid rgba(16, 185, 129, 0.3);
}

.status-pending {
    background: rgba(245, 158, 11, 0.2);
    color: var(--warning);
    border: 1px solid rgba(245, 158, 11, 0.3);
}

.status-locked {
    background: rgba(148, 163, 184, 0.2);
    color: var(--text-muted);
    border: 1px solid rgba(148, 163, 184, 0.3);
}

.progress-bar {
    width: 100%;
    height: 8px;
    background: var(--bg-secondary);
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin: 1rem 0;
}

.progress-fill {
    height: 100%;
    background: var(--primary-gradient);
    border-radius: var(--radius-sm);
    transition: width 0.6s ease;
}

.ai-section {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(16, 185, 129, 0.1) 100%);
    border: 1px solid rgba(6, 182, 212, 0.2);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin: 2rem 0;
    backdrop-filter: blur(20px);
}

.ai-glow {
    box-shadow: 0 0 30px rgba(6, 182, 212, 0.2);
}

.map-container {
    height: 400px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-color);
    margin: 2rem 0;
}

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(10px);
    background: rgba(15, 23, 42, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-lg);
    z-index: 1000;
}

.loading-spinner {
    width: 50px;
    height: 50px;
    border: 3px solid var(--border-color);
    border-top: 3px solid var(--neon-cyan);
    border-radius: 50%;
    animation: spin 1s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

.star-rating {
    display: flex;
    gap: 0.25rem;
    margin: 1rem 0;
}

.star {
    color: var(--text-muted);
    font-size: 1.25rem;
    transition: var(--transition);
    cursor: pointer;
}

.star.filled {
    color: #fbbf24;
}

.star:hover {
    transform: scale(1.1);
}

.quiz-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
}

.quiz-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: 1rem;
}

.quiz-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
}

.quiz-meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
}

.quiz-meta-item i {
    color: var(--neon-cyan);
}
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <h1 class="page-title">{{ formation.titre }}</h1>
    <p class="page-subtitle">Apprenez étape par étape et validez vos connaissances</p>
</div>

<!-- LANGUAGE SELECTOR -->
<div class="mb-4">
    <select id="langSelect" class="language-selector">
        <option value="fr">Français</option>
        <option value="en">English</option>
        <option value="ar">Arabe</option>
        <option value="es">Español</option>
        <option value="de">Deutsch</option>
    </select>
</div>

<!-- DESCRIPTION CARD -->
<div class="card fade-in">
    <div class="card-header">
        <h3 class="card-title">
            <i class="mdi mdi-information-outline" style="color: var(--neon-cyan); margin-right: 0.5rem;"></i>
            Description
        </h3>
    </div>
    <div class="card-body">
        <p id="desc-content" style="line-height: 1.7;">
            {{ formation.description|raw }}
        </p>
    </div>
</div>

<!-- PROGRESS OVERVIEW -->
<div class="card fade-in" style="animation-delay: 0.1s;">
    <div class="card-header">
        <h3 class="card-title">
            <i class="mdi mdi-chart-line" style="color: var(--neon-cyan); margin-right: 0.5rem;"></i>
            Votre Progression
        </h3>
    </div>
    <div class="card-body">
        <div class="d-flex justify-between align-center mb-3">
            <span>Quiz complétés</span>
            <span class="badge badge-primary">{{ completedQuizzes|default(0) }} / {{ totalQuizzes|default(0) }}</span>
        </div>
        <div class="progress-bar">
            <div class="progress-fill" style="width: {{ (completedQuizzes / totalQuizzes * 100)|default(0) }}%;"></div>
        </div>
    </div>
</div>

<!-- QUIZ LIST -->
<div class="page-header">
    <h2 class="page-title">Quiz Disponibles</h2>
    <p class="page-subtitle">Testez vos connaissances et obtenez votre certificat</p>
</div>

<div class="quiz-grid">
    {% for quiz in quizzes %}
    <div class="quiz-card fade-in" style="animation-delay: {{ loop.index * 0.1 }}s;">
        {% if quiz.image %}
            <img src="{{ asset('uploads/quiz/' ~ quiz.image) }}" alt="{{ quiz.titre }}" class="quiz-image" 
                 onerror="this.src='https://picsum.photos/seed/{{ quiz.id }}/400/200.jpg';">
        {% endif %}
        
        <div class="card-header">
            <h4 class="card-title">{{ quiz.titre }}</h4>
            <p class="card-subtitle">{{ quiz.description|slice(0, 100) }}...</p>
        </div>
        
        <div class="card-body">
            <div class="star-rating">
                {% for i in 1..5 %}
                    <i class="mdi mdi-star star {% if i <= 4 %}filled{% endif %}"></i>
                {% endfor %}
            </div>
            
            <div class="quiz-meta">
                <div class="quiz-meta-item">
                    <i class="mdi mdi-help-circle"></i>
                    <span>{{ quiz.questions|length }} questions</span>
                </div>
                <div class="quiz-meta-item">
                    <i class="mdi mdi-timer"></i>
                    <span>{{ quiz.duree|default(15) }} min</span>
                </div>
            </div>
            
            <div class="quiz-actions">
                {% if quiz.isCompleted ?? false %}
                    <span class="quiz-status status-completed">
                        <i class="mdi mdi-check-circle"></i>
                        Complété
                    </span>
                {% else %}
                    <a href="{{ path('app_quiz_show', {'id': quiz.id}) }}" class="btn btn-primary">
                        <i class="mdi mdi-play"></i>
                        Commencer
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
    {% endfor %}
</div>

<!-- AI QUIZ SECTION -->
<div class="ai-section ai-glow fade-in" style="animation-delay: 0.5s;">
    <div class="page-header">
        <h2 class="page-title">
            <i class="mdi mdi-robot" style="color: var(--neon-cyan); margin-right: 0.5rem;"></i>
            Quiz Généré par IA
        </h2>
        <p class="page-subtitle">Créez des quiz personnalisés avec l'intelligence artificielle</p>
    </div>
    
    <div class="card">
        <div class="card-body">
            <p style="margin-bottom: 1.5rem;">
                Notre IA peut générer des quiz personnalisés basés sur vos documents PDF, 
                vos notes de cours ou vos supports de formation.
            </p>
            
            <div class="quiz-actions">
                <button class="btn btn-accent" onclick="openAiQuizModal()">
                    <i class="mdi mdi-robot"></i>
                    Générer un Quiz IA
                </button>
                <button class="btn btn-secondary">
                    <i class="mdi mdi-history"></i>
                    Mes Quiz IA
                </button>
            </div>
        </div>
    </div>
</div>

<!-- MAP SECTION (if needed) -->
{% if formation.lieu is defined and formation.lieu %}
<div class="page-header">
    <h2 class="page-title">Localisation</h2>
    <p class="page-subtitle">Trouvez le lieu de formation</p>
</div>

<div class="map-container" id="map"></div>
{% endif %}

<!-- LOADING OVERLAY -->
<div class="loading-overlay" id="loadingOverlay" style="display: none;">
    <div class="loading-spinner"></div>
</div>

<!-- JavaScript -->
<script>
// Language translation
const translations = {
    fr: {
        description: 'Description',
        progress: 'Votre Progression',
        quiz_completed: 'Quiz complétés',
        available_quiz: 'Quiz Disponibles',
        ai_quiz: 'Quiz Généré par IA',
        start: 'Commencer',
        completed: 'Complété'
    },
    en: {
        description: 'Description',
        progress: 'Your Progress',
        quiz_completed: 'Completed Quizzes',
        available_quiz: 'Available Quizzes',
        ai_quiz: 'AI Generated Quiz',
        start: 'Start',
        completed: 'Completed'
    }
};

document.getElementById('langSelect').addEventListener('change', function(e) {
    const lang = e.target.value;
    // Apply translations
    console.log('Language changed to:', lang);
});

// AI Quiz Modal
function openAiQuizModal() {
    // Show loading
    document.getElementById('loadingOverlay').style.display = 'flex';
    
    // Simulate AI processing
    setTimeout(() => {
        document.getElementById('loadingOverlay').style.display = 'none';
        // Redirect to AI quiz page
        window.location.href = '{{ path("app_ai_quiz_index") }}';
    }, 2000);
}

// Initialize map if needed
{% if formation.lieu is defined and formation.lieu %}
var map = L.map('map').setView([{{ formation.latitude|default(48.8566) }}, {{ formation.longitude|default(2.3522) }}], 13);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
}).addTo(map);

L.marker([{{ formation.latitude|default(48.8566) }}, {{ formation.longitude|default(2.3522) }}])
    .addTo(map)
    .bindPopup('{{ formation.lieu|default("Location") }}')
    .openPopup();
{% endif %}

// Quiz interactions
document.querySelectorAll('.quiz-card').forEach(card => {
    card.addEventListener('mouseenter', function() {
        this.style.transform = 'translateY(-4px)';
    });
    
    card.addEventListener('mouseleave', function() {
        this.style.transform = 'translateY(0)';
    });
});

// Star rating interaction
document.querySelectorAll('.star').forEach(star => {
    star.addEventListener('click', function() {
        const rating = parseInt(this.dataset.rating);
        // Handle rating submission
        console.log('Rating:', rating);
    });
});
</script>
{% endblock %}
