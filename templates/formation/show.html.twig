{% extends 'base.html.twig' %}

{% block title %}{{ formation.titre }}{% endblock %}

{% block body %}

<style>
/* OVERLAY */
.loader-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(6px);
    background: rgba(255,255,255,0.6);
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 20px;
    z-index: 10;
}

/* BOX */
.loader-box {
    background: white;
    padding: 20px 30px;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

/* SPINNER */
.spinner {
    width: 40px;
    height: 40px;
    border: 4px solid #e9ecef;
    border-top: 4px solid #0d6efd;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: auto;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<section class="section light-background">

<div class="container">
 
 

    <!-- HERO HEADER -->
    <div class="mb-5">
        <h2 class="fw-bold mb-2">
            <i class="bi bi-mortarboard-fill text-primary me-2"></i>
            {{ formation.titre }}
        </h2>
        <p class="text-muted mb-0">
            Apprenez étape par étape et validez vos connaissances
        </p>
    </div>
    
 
<!-- 🌍 LANGUAGE SELECT -->
<div class="mb-3">
    <select id="langSelect" class="form-select w-auto rounded-pill">
        <option value="fr">🇫🇷 Français</option>
        <option value="en">🇬🇧 English</option>
        <option value="ar">🇹🇳 عربي</option>
        <option value="es">🇪🇸 Español</option>
        <option value="de">🇩🇪 Deutsch</option>
    </select>
</div>

<!-- DESCRIPTION -->
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4 position-relative">
    <h5 class="fw-bold mb-3" id="desc-title">
        <i class="bi bi-info-circle text-primary me-2"></i>
        Description
    </h5>

    <p id="desc-content"
       class="text-muted mb-0"
       style="line-height:1.7;">
        {{ formation.description }}
    </p>

</div>

<div id="loaderOverlay" class="loader-overlay" style="display:none;">
    <div class="loader-box text-center">
        <div class="spinner"></div>
        <p class="mt-3 mb-0">Traduction en cours...</p>
    </div>
</div>

<script>let originalText = "{{ formation.description|e('js') }}";

document.getElementById('langSelect').addEventListener('change', function(){

    let lang = this.value;
    let content = document.getElementById('desc-content');
    let title = document.getElementById('desc-title');
    let loader = document.getElementById('loaderOverlay');

    if(lang === 'fr'){
        content.innerText = originalText;
        title.innerHTML = '<i class="bi bi-info-circle text-primary me-2"></i>Description';
        return;
    }

    loader.style.display = 'flex';

    fetch(`/formation/translate/{{ formation.id }}?lang=${lang}`)
        .then(res => res.json())
        .then(data => {

            content.innerText = data.translated;

            title.innerHTML =
                '<i class="bi bi-info-circle text-primary me-2"></i>Description (' + lang.toUpperCase() + ')';

            loader.style.display = 'none';
        })
        .catch(() => {
            loader.style.display = 'none';
        });
});
</script>

<!-- PROGRESS -->
    <!-- PROGRESSION -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold">Progression</span>
            <span id="progressText">{{ participation.progression ?? 0 }}%</span>
        </div>

        <div class="progress progress-modern">
            <div id="progressBar"
                 class="progress-bar"
                 style="width: {{ participation.progression ?? 0 }}%">
            </div>
        </div>

        {% if participation and participation.progression < 90 %}
            <small class="text-muted mt-2 d-block">
                <i class="bi bi-lock me-1"></i>
                Terminez toutes les vidéos pour débloquer le quiz
            </small>
        {% endif %}
    </div>

    <!-- VIDEOS -->
    <div class="row g-4 mb-5">

        {% set videos = [
            {'file': formation.video1, 'progress': 33, 'label': 'Vidéo 1'},
            {'file': formation.video2, 'progress': 66, 'label': 'Vidéo 2'},
            {'file': formation.video3, 'progress': 90, 'label': 'Vidéo 3'}
        ] %}

        {% for v in videos %}
            {% if v.file %}
            <div class="col-md-4">

                <div class="video-card">

                    <div class="video-header">
                        <i class="bi bi-play-circle-fill me-2"></i>
                        {{ v.label }}
                    </div>

                    <video controls
                           class="w-100 video-player"
                           data-progress="{{ v.progress }}">
                        <source src="{{ asset('uploads/videos/' ~ v.file) }}">
                    </video>

                </div>

            </div>
            {% endif %}
        {% endfor %}
    </div>

    <!-- QUIZ -->
    <div id="quizSection" class="mt-5" style="display:none;">

        <div class="card border-0 shadow-sm rounded-4 p-4">

            <h4 class="fw-bold mb-4">
                <i class="bi bi-patch-question text-primary me-2"></i>
                Quiz final
            </h4>

            {% for quiz in formation.quizzes %}
                <div class="quiz-card mb-4 p-3">

                    <p class="fw-semibold text-center">{{ quiz.question }}</p>

                    {% if quiz.image %}
                        <div class="text-center">
                            <img src="{{ asset('uploads/quiz/' ~ quiz.image) }}"
                                 class="quiz-img">
                        </div>
                    {% endif %}

                    <div class="quiz-options mt-3">

                        {% for i in 1..3 %}
                            {% set value = attribute(quiz, 'r' ~ i) %}

                            <label class="option">
                                <input type="radio" name="q{{ quiz.id }}" value="{{ i }}">
                                <span>{{ value }}</span>
                            </label>

                        {% endfor %}

                    </div>

                </div>
            {% endfor %}

            <button class="btn btn-primary w-100 rounded-pill btn-modern"
                    onclick="submitQuiz()">
                <i class="bi bi-check-circle me-1"></i>
                Soumettre le quiz
            </button>

            <div id="resultBox" class="mt-4"></div>

        </div>

    </div>

</div>


</section>

<!-- RESULT POPUP -->
<div id="resultModal" class="result-modal">

    <div class="result-content" id="resultContent">

        <div id="resultAnimation"></div>

        <h2 id="resultTitle"></h2>
        <p id="resultScore"></p>

        <button onclick="closeModal()" class="btn btn-light rounded-pill mt-3">
            Fermer
        </button>

    </div>
</div>

<!-- JS -->
<script>
let formationId = {{ formation.id }};
let progression = {{ participation.progression ?? 0 }};

// 🎥 TRACK VIDEO
document.querySelectorAll('.video-player').forEach(video => {

    video.addEventListener('ended', function(){

        let newProgress = parseInt(this.dataset.progress);

        if(newProgress > progression){

            progression = newProgress;

            document.getElementById('progressBar').style.width = progression + '%';
            document.getElementById('progressText').innerText = progression + '%';

            fetch("{{ path('app_progress_update') }}", {
                method: "POST",
                headers: {"Content-Type": "application/x-www-form-urlencoded"},
                body: new URLSearchParams({
                    formationId: formationId,
                    progress: progression
                })
            });

            if(progression >= 90){
                unlockQuiz();
            }
        }
    });
});

// 🔓 unlock
function unlockQuiz(){
    document.getElementById('quizSection').style.display = 'block';
}

// initial
if(progression >= 90){
    unlockQuiz();
}

// ✅ VALIDATION + SUBMIT
function submitQuiz(){

    let answers = {};
    let totalQuestions = document.querySelectorAll('.quiz-card').length;

    document.querySelectorAll('input[type=radio]:checked').forEach(el=>{
        let qid = el.name.replace('q','');
        answers[qid] = el.value;
    });

    // 🔥 CONTROLE SAISIE
    if(Object.keys(answers).length < totalQuestions){
        alert("Veuillez répondre à toutes les questions.");
        return;
    }

    fetch("{{ path('app_quiz_submit') }}",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body: JSON.stringify({
            formationId: formationId,
            answers: answers
        })
    })
    .then(r=>r.json())
    .then(data=>{
        showResult(data.score, data.total);
    });
}

// 🎯 RESULT UI
function showResult(score, total){

    let percent = (score/total)*100;
    let success = percent >= 60;

    let modal = document.getElementById('resultModal');
    let content = document.getElementById('resultContent');

    document.getElementById('resultTitle').innerText = success ? "🎉 Félicitations !" : "❌ Échec";
    document.getElementById('resultScore').innerText = `${score}/${total} (${percent.toFixed(0)}%)`;

    // reset classes
    content.className = "result-content";

    if(success){
        content.classList.add('success');

        // 🎉 CONFETTI
        launchConfetti();

    }else{
        content.classList.add('fail');

        // 💥 SHAKE ANIMATION
        content.classList.add('shake');
    }

    modal.style.display = 'flex';
}
function closeModal(){
    document.getElementById('resultModal').style.display = 'none';
}
function launchConfetti(){
    confetti({
        particleCount: 150,
        spread: 90,
        origin: { y: 0.6 }
    });

    // multi burst
    setTimeout(()=>confetti({particleCount:100, spread:120}), 300);
}
</script>

<!-- STYLE -->
<style>
/* MODAL */
.result-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    backdrop-filter: blur(6px);
}

/* CONTENT */
.result-content {
    background: white;
    padding: 40px;
    border-radius: 20px;
    text-align: center;
    width: 350px;
    animation: fadeInScale 0.4s ease;
    position: relative;
}

/* SUCCESS */
.result-content.success {
    border-top: 6px solid #28a745;
}

/* FAIL */
.result-content.fail {
    border-top: 6px solid #dc3545;
}

/* ANIMATION ENTRY */
@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.7);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* SHAKE FAIL */
.shake {
    animation: shake 0.4s;
}

@keyframes shake {
    0% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    50% { transform: translateX(8px); }
    75% { transform: translateX(-5px); }
    100% { transform: translateX(0); }
}.result-content.fail::after {
    content: "🔥";
    font-size: 40px;
    position: absolute;
    bottom: -20px;
    right: 10px;
    animation: floatFire 1s infinite alternate;
}

@keyframes floatFire {
    from { transform: translateY(0); }
    to { transform: translateY(-10px); }
}
/* VIDEO */
.video-card {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
    transition: 0.3s;
}

.video-card:hover {
    transform: translateY(-5px);
}

.video-header {
    padding: 10px;
    font-weight: 500;
    background: #f8f9fa;
}

/* PROGRESS */
.progress-modern {
    height: 10px;
    border-radius: 20px;
    background: #eef2f7;
}

.progress-modern .progress-bar {
    background: var(--accent-color);
    border-radius: 20px;
}

/* QUIZ */
.quiz-card {
    background: #f8f9fa;
    border-radius: 16px;
}

.quiz-img {
    max-height: 150px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

/* OPTIONS */
.option {
    display: block;
    padding: 12px;
    border-radius: 10px;
    border: 1px solid #eee;
    margin-top: 10px;
    cursor: pointer;
    transition: 0.2s;
}

.option:hover {
    background: #eef4ff;
}

.option input {
    margin-right: 10px;
}

/* RESULT */
.result-box {
    padding: 20px;
    border-radius: 16px;
    text-align: center;
    font-weight: 600;
}

.result-box.success {
    background: #e6f4ea;
    color: #137333;
}

.result-box.fail {
    background: #fdecea;
    color: #b3261e;
}

</style>

{% endblock %}