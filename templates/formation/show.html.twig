<div id="loaderOverlay" class="loader-overlay" style="display:none;">
    <div class="loader-box text-center">
        <div class="spinner"></div>
        <p class="mt-3 mb-0">Traduction en cours...</p>
    </div>
</div>

<script>let originalText = "{{ formation.description|e('js') }}";

document.getElementById('langSelect').addEventListener('change', function(){

    let lang = this.value;
    let content = document.getElementById('desc-content');
    let title = document.getElementById('desc-title');
    let loader = document.getElementById('loaderOverlay');

    if(lang === 'fr'){
        content.innerText = originalText;
        title.innerHTML = '<i class="bi bi-info-circle text-primary me-2"></i>Description';
        return;
    }

    loader.style.display = 'flex';

    fetch(`/formation/translate/{{ formation.id }}?lang=${lang}`)
        .then(res => res.json())
        .then(data => {

            content.innerText = data.translated;

            title.innerHTML =
                '<i class="bi bi-info-circle text-primary me-2"></i>Description (' + lang.toUpperCase() + ')';

            loader.style.display = 'none';
        })
        .catch(() => {
            loader.style.display = 'none';
        });
});
</script>

<!-- PROGRESS -->
    <!-- PROGRESSION -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">

        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-semibold">Progression</span>
            <span id="progressText">{{ participation.progression ?? 0 }}%</span>
        </div>

        <div class="progress progress-modern">
            <div id="progressBar"
                 class="progress-bar"
                 style="width: {{ participation.progression ?? 0 }}%">
            </div>
        </div>

        {% if participation and participation.progression < 90 %}
            <small class="text-muted mt-2 d-block">
                <i class="bi bi-lock me-1"></i>
                Terminez toutes les vidéos pour débloquer le quiz
            </small>
        {% endif %}
    </div>

    {% if participation and participation.statut == 'REUSSI' %}
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 d-flex flex-row justify-content-between align-items-center">
            <span class="fw-semibold"><i class="bi bi-patch-check text-success me-2"></i>Formation réussie</span>
            <a class="btn btn-success rounded-pill px-4" href="{{ path('app_formation_certificate', {'id': formation.id}) }}">
                <i class="bi bi-download me-1"></i>Télécharger mon certificat
            </a>
        </div>
    {% endif %}

    <!-- RATING -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-5">
        <form method="post" action="{{ path('app_formation_rate', {'id': formation.id}) }}" class="d-flex align-items-center gap-3 flex-wrap">
            <span class="fw-semibold">{{ myRating ? 'Votre note' : 'Noter cette formation' }}</span>
            <div class="d-flex align-items-center gap-1">
                {% for i in 1..5 %}
                    <button type="submit" name="rating" value="{{ i }}"
                            class="btn btn-sm {{ myRating and i <= myRating ? 'btn-warning' : 'btn-outline-warning' }}"
                            title="Note {{ i }}/5">{{ i }} ★</button>
                {% endfor %}
            </div>
            {% if myRating %}<small class="text-muted">Cliquez sur une autre note pour la modifier.</small>{% endif %}
        </form>
    </div>

    <!-- VIDEOS -->
    <div class="row g-4 mb-5">

        {% set videos = [
            {'file': formation.video1, 'progress': 33, 'label': 'Vidéo 1'},
            {'file': formation.video2, 'progress': 66, 'label': 'Vidéo 2'},
            {'file': formation.video3, 'progress': 90, 'label': 'Vidéo 3'}
        ] %}

        {% for v in videos %}
            {% if v.file %}
            <div class="col-md-4">

                <div class="video-card">

                    <div class="video-header">
                        <i class="bi bi-play-circle-fill me-2"></i>
                        {{ v.label }}
                    </div>

                    <video controls
                           class="w-100 video-player"
                           data-progress="{{ v.progress }}">
                        <source src="{{ asset('uploads/videos/' ~ v.file) }}">
                    </video>

                </div>

            </div>
            {% endif %}
        {% endfor %}
    </div>

    <!-- QUIZ -->
    <div id="quizSection" class="mt-5" style="display:none;">

        <div class="card border-0 shadow-sm rounded-4 p-4">

            <h4 class="fw-bold mb-4">
                <i class="bi bi-patch-question text-primary me-2"></i>
                Quiz final
            </h4>

            {% for quiz in formation.quizzes %}
                <div class="quiz-card mb-4 p-3">

                    <p class="fw-semibold text-center">{{ quiz.question }}</p>

                    {% if quiz.image %}
                        {% set imagePath = quiz.image starts with('/uploads/')
                            ? quiz.image|slice(1)
                            : (quiz.image starts with('uploads/')
                                ? quiz.image
                                : 'uploads/quiz/' ~ quiz.image) %}

                        <div class="text-center">
                            <img src="{{ asset(imagePath) }}"
                                 class="quiz-img"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                 alt="Quiz image">
