    justify-content: center;
    align-items: center;
    z-index: 9999;
    backdrop-filter: blur(6px);
}

/* CONTENT */
.result-content {
    background: white;
    padding: 40px;
    border-radius: 20px;
    text-align: center;
    width: 350px;
    animation: fadeInScale 0.4s ease;
    position: relative;
}

/* SUCCESS */
.result-content.success {
    border-top: 6px solid #28a745;
}

/* FAIL */
.result-content.fail {
    border-top: 6px solid #dc3545;
}

/* ANIMATION ENTRY */
@keyframes fadeInScale {
    from {
        opacity: 0;
        transform: scale(0.7);
    }
    to {
        opacity: 1;
        transform: scale(1);
    }
}

/* SHAKE FAIL */
.shake {
    animation: shake 0.4s;
}

@keyframes shake {
    0% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    50% { transform: translateX(8px); }
    75% { transform: translateX(-5px); }
    100% { transform: translateX(0); }
}.result-content.fail::after {
    content: "🔥";
    font-size: 40px;
    position: absolute;
    bottom: -20px;
    right: 10px;
    animation: floatFire 1s infinite alternate;
}

@keyframes floatFire {
    from { transform: translateY(0); }
    to { transform: translateY(-10px); }
}
/* VIDEO */
.video-card {
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.05);
