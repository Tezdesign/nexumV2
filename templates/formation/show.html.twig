    <div class="result-content" id="resultContent">

        <div id="resultAnimation"></div>

        <h2 id="resultTitle"></h2>
        <p id="resultScore"></p>

        <button onclick="closeModal()" class="btn btn-light rounded-pill mt-3">
            Fermer
        </button>

    </div>
</div>

<!-- JS -->
<script>
let formationId = {{ formation.id }};
let progression = {{ participation.progression ?? 0 }};

// ===== Localisation picker (OSM + Geocoder) =====
let mapInstance = null;
let mapMarker = null;
let mapInitialized = false;

const localisationField = document.getElementById('localisationField');
const saveLocalisationBtn = document.getElementById('saveLocalisationBtn');
const localisationSaveHint = document.getElementById('localisationSaveHint');
const reverseGeoStatus = document.getElementById('reverseGeoStatus');

async function saveLocalisation(value) {
    localisationSaveHint.style.display = 'block';
    localisationSaveHint.innerText = 'Enregistrement...';

    const res = await fetch("{{ path('app_participation_localisation_update') }}", {
        method: "POST",
        headers: {"Content-Type": "application/x-www-form-urlencoded"},
        body: new URLSearchParams({
            formationId: formationId,
            localisation: value ?? ''
        })
    });

    if (!res.ok) {
        localisationSaveHint.innerText = 'Erreur lors de l’enregistrement.';
        return;
    }

    const data = await res.json();
    localisationField.value = data.localisation ?? '';
    localisationSaveHint.innerText = 'Localisation enregistrée.';
    setTimeout(() => { localisationSaveHint.style.display = 'none'; }, 2000);
}

saveLocalisationBtn?.addEventListener('click', () => {
    saveLocalisation(localisationField.value);
});

document.getElementById('localisationMapModal')?.addEventListener('shown.bs.modal', () => {
    if (!mapInitialized) {
        mapInitialized = true;

        mapInstance = L.map('localisationMap', {
            scrollWheelZoom: true
        }).setView([36.8065, 10.1815], 12); // Tunis par défaut

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; OpenStreetMap'
        }).addTo(mapInstance);

        // Center on user if available
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition((pos) => {
                const { latitude, longitude } = pos.coords;
                mapInstance.setView([latitude, longitude], 15);
            }, () => {});
        }

        mapInstance.on('click', async (e) => {
            const { lat, lng } = e.latlng;
            reverseGeoStatus.innerText = 'Recherche adresse...';

            if (mapMarker) {
                mapMarker.setLatLng([lat, lng]);
            } else {
                mapMarker = L.marker([lat, lng]).addTo(mapInstance);
            }

            try {
                const url = new URL('https://nominatim.openstreetmap.org/reverse');
                url.searchParams.set('format', 'jsonv2');
                url.searchParams.set('lat', String(lat));
                url.searchParams.set('lon', String(lng));

                const r = await fetch(url.toString(), {
                    headers: {
                        'Accept': 'application/json'
                    }
                });

                if (!r.ok) {
                    reverseGeoStatus.innerText = 'Adresse introuvable.';
                    return;
                }

                const json = await r.json();
                const label = json.display_name || `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                localisationField.value = label;
                reverseGeoStatus.innerText = 'Adresse trouvée.';

                // auto-save after selection
                await saveLocalisation(label);
            } catch (err) {
                reverseGeoStatus.innerText = 'Erreur géocodage.';
            } finally {
                setTimeout(() => { reverseGeoStatus.innerText = ''; }, 2000);
            }
        });
    }

    // Leaflet needs invalidateSize after modal opens
    setTimeout(() => {
        mapInstance?.invalidateSize();
    }, 150);
});

// 🎥 TRACK VIDEO
document.querySelectorAll('.video-player').forEach(video => {

    video.addEventListener('ended', function(){

        let newProgress = parseInt(this.dataset.progress);

        if(newProgress > progression){

            progression = newProgress;

            document.getElementById('progressBar').style.width = progression + '%';
            document.getElementById('progressText').innerText = progression + '%';

            fetch("{{ path('app_progress_update') }}", {
                method: "POST",
                headers: {"Content-Type": "application/x-www-form-urlencoded"},
                body: new URLSearchParams({
                    formationId: formationId,
                    progress: progression
                })
            });

            if(progression >= 90){
                unlockQuiz();
            }
        }
    });
});

// 🔓 unlock
function unlockQuiz(){
    document.getElementById('quizSection').style.display = 'block';
}

// initial
if(progression >= 90){
    unlockQuiz();
}

// ✅ VALIDATION + SUBMIT
function submitQuiz(){

    let answers = {};
    let totalQuestions = document.querySelectorAll('.quiz-card').length;

    document.querySelectorAll('input[type=radio]:checked').forEach(el=>{
        let qid = el.name.replace('q','');
        answers[qid] = el.value;
    });

    // 🔥 CONTROLE SAISIE
    if(Object.keys(answers).length < totalQuestions){
        alert("Veuillez répondre à toutes les questions.");
        return;
    }

    fetch("{{ path('app_quiz_submit') }}",{
        method:"POST",
        headers:{"Content-Type":"application/json"},
        body: JSON.stringify({
            formationId: formationId,
            answers: answers
        })
    })
    .then(res => {
        // Check if response is ok (status 200-299)
        if (!res.ok) {
            return res.text().then(text => {
                let message = `HTTP ${res.status}`;
                try { message = JSON.parse(text).error || message; } catch (e) { /* not JSON, keep the status */ }
                throw new Error(message);
            });
        }
        return res.text();
    })
    .then(text => {
        try {
            const data = JSON.parse(text);
            
            if (data.success === false) {
                // Handle backend error
                alert('Erreur: ' + (data.error || 'Une erreur est survenue'));
                return;
            }
            
            // Success case
            showResult(data.score, data.total);
            
        } catch (parseError) {
            console.error('Invalid JSON response:', text);
            alert('Erreur de communication avec le serveur. Réponse invalide.');
        }
    })
    .catch(error => {
        console.error('Quiz submission error:', error);
        alert('Erreur lors de la soumission du quiz: ' + error.message);
    });
}

// 🎯 RESULT UI
function showResult(score, total){

    let percent = (score/total)*100;
    let success = percent >= 60;

    let modal = document.getElementById('resultModal');
    let content = document.getElementById('resultContent');

    document.getElementById('resultTitle').innerText = success ? "🎉 Félicitations !" : "❌ Échec";
    document.getElementById('resultScore').innerText = `${score}/${total} (${percent.toFixed(0)}%)`;

    // reset classes
    content.className = "result-content";

    if(success){
        content.classList.add('success');

        // 🎉 CONFETTI
        launchConfetti();

    }else{
        content.classList.add('fail');

        // 💥 SHAKE ANIMATION
        content.classList.add('shake');
    }

    modal.style.display = 'flex';
}
function closeModal(){
    document.getElementById('resultModal').style.display = 'none';
}
function launchConfetti(){
    confetti({
        particleCount: 150,
        spread: 90,
        origin: { y: 0.6 }
    });

    // multi burst
    setTimeout(()=>confetti({particleCount:100, spread:120}), 300);
}
</script>

<!-- STYLE -->
<style>
/* MODAL */
.result-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.7);
