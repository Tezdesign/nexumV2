{% for notif in notifications %}
    {% set iconColorClass = 'text-primary' %}
    {% set bgClass = 'bg-primary-subtle' %}
    {% set iconClass = 'ri-information-fill' %}

    {% if notif.type == 'error' or notif.type == 'danger' %}
        {% set iconColorClass = 'text-danger' %}
        {% set bgClass = 'bg-danger-subtle' %}
        {% set iconClass = 'ri-error-warning-fill' %}
    {% elseif notif.type == 'success' %}
        {% set iconColorClass = 'text-success' %}
        {% set bgClass = 'bg-success-subtle' %}
        {% set iconClass = 'ri-checkbox-circle-fill' %}
    {% endif %}

    {% set activeClass = notif.read ? '' : 'active' %}

    <div class="dropdown-item notification-item py-2 text-wrap {{ activeClass }}" style="cursor: default;">
        <span class="d-flex align-items-center">
            <div class="avatar-lg flex-shrink-0 me-3">
                <span class="avatar-title {{ bgClass }} {{ iconColorClass }} rounded-circle fs-22">
                    <i class="{{ iconClass }}"></i>
                </span>
            </div>
            <span class="flex-grow-1 text-muted">
                <span class="fw-medium text-body">{{ notif.title }}</span><br />
                <span class="fs-13">{{ notif.message }}</span><br />
                
                {# Calculate "time ago" natively in Twig #}
                {% set diff = date().timestamp - notif.timestamp %}
                <span class="fs-12">
                    {% if diff < 60 %}
                        {{ diff }}s ago
                    {% elseif diff < 3600 %}
                        {{ (diff / 60)|round(0, 'floor') }}m ago
                    {% elseif diff < 86400 %}
                        {{ (diff / 3600)|round(0, 'floor') }}h ago
                    {% else %}
                        {{ (diff / 86400)|round(0, 'floor') }}d ago
                    {% endif %}
                </span>
            </span>
        </span>
    </div>
{% else %}
    <div class="p-3 text-center text-muted">No new notifications</div>
{% endfor %}